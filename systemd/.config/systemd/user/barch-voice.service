# Always-on voice control of the desktop (quickshell/voice/voice.py): the microphone stays open,
# a sentence starting with "barch" is transcribed by whisper.cpp and run through the intents in
# commands.json, or handed to `claude -p`. `barch voice on|off|status` drives it.
[Unit]
Description=BArch voice control (barch-voice)
PartOf=graphical-session.target
After=graphical-session.target pipewire.service wireplumber.service

[Service]
ExecStart=/usr/bin/python3 -I %h/.config/quickshell/voice/voice.py
Restart=on-failure
RestartSec=3
Nice=5

[Install]
WantedBy=graphical-session.target
