[general]
status_path = "~/.local/share/vdirsyncer/status/"

[pair icloud]
a = "icloud_remote"
b = "icloud_local"
collections = ["from a"]
metadata = ["displayname", "color"]
conflict_resolution = "a wins"

[storage icloud_remote]
type = "caldav"
url = "https://caldav.icloud.com/"
username = "bcfrutuozo@hotmail.com"
password.fetch = ["command", "cat", "~/.config/vdirsyncer/icloud-password"]
read_only = true

[storage icloud_local]
type = "filesystem"
path = "~/.local/share/calendars/icloud/"
fileext = ".ics"
