#!/usr/bin/env bash
# /usr/local/bin/barch-killswitch on_<ip>_<port> | off — the Anonymous Mode kill switch.
#
# Run as root by barch-killswitch@.service, which wheel users may start without a password
# (polkit: 50-barch-killswitch.rules); the caller is quickshell/anon/anon.sh (and vpn/pia.sh
# when the region changes). It adds the table "inet barch-killswitch" with output and forward
# chains that only let through: the tunnel itself (UDP to <ip>:<port>, the PIA server), anything
# inside the tunnel (interface pia), the networks directly connected to this machine (LAN, libvirt,
# Docker bridges), loopback, and the broadcast / multicast / link-local traffic those networks
# need (DHCP, mDNS, IPv6 neighbour discovery). Everything else is rejected, so when the tunnel
# drops the applications fail at once instead of silently falling back to the real address;
# the forward chain does the same for VMs and containers using the host's NAT.
# `off` removes the table. State for the desktop (readable by everyone):
# /run/barch-killswitch/state.json {armed, endpoint, networks, since}. /run is empty after a
# boot, so the kill switch never outlives the session that armed it.
set -euo pipefail

table=barch-killswitch
state=${BARCH_KILLSWITCH_STATE:-/run/barch-killswitch}
iface=pia                                  # the WireGuard interface pia.sh creates
arg=${1:-}

usage() { echo "usage: $0 on_<ip>_<port> | off" >&2; exit 2; }

write_state() {   # write_state <json>
  install -d -m 755 "$state"
  printf '%s\n' "$1" > "$state/state.json.tmp"
  chmod 644 "$state/state.json.tmp"
  mv "$state/state.json.tmp" "$state/state.json"
}

case $arg in
  on_*)
    IFS=_ read -r _ ip port <<<"$arg"
    [[ $ip =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ && $port =~ ^[0-9]{1,5}$ ]] || usage
    (( port >= 1 && port <= 65535 )) || usage
    for o in ${ip//./ }; do (( o <= 255 )) || usage; done
    # the IPv4 networks directly connected to this machine, except through the tunnel
    nets=$(ip -4 -o route show scope link | awk -v t="$iface" '$1 != "default" && $3 != t { print $1 }' | sort -u | paste -sd, -)
    out_nets=""; fwd_nets=""
    if [[ -n $nets ]]; then
      out_nets="ip daddr { $nets } accept comment \"directly connected networks\""
      fwd_nets="ip daddr { $nets } accept comment \"to the directly connected networks\""
    fi
    nft -f - <<RULES
destroy table inet $table
table inet $table {
  chain output {
    type filter hook output priority filter + 10; policy drop;
    oifname "lo" accept
    oifname "$iface" accept comment "inside the tunnel"
    ip daddr $ip udp dport $port accept comment "the tunnel itself (PIA server)"
    $out_nets
    ip daddr { 224.0.0.0/4, 255.255.255.255 } accept comment "multicast and broadcast (mDNS, DHCP)"
    ip6 daddr { fe80::/10, ff02::/16 } accept comment "IPv6 link-local and multicast (neighbour discovery, DHCPv6)"
    counter reject with icmpx type admin-prohibited comment "no tunnel, no traffic"
  }
  chain forward {
    type filter hook forward priority filter + 10; policy drop;
    oifname "$iface" accept comment "guests and containers through the tunnel"
    $fwd_nets
    ip daddr 224.0.0.0/4 accept
    counter reject with icmpx type admin-prohibited comment "no tunnel, no traffic for guests and containers either"
  }
}
RULES
    write_state "$(printf '{"armed": true, "endpoint": "%s:%s", "networks": "%s", "since": %s}' "$ip" "$port" "$nets" "$(date +%s)")"
    echo "kill switch armed: only $ip:$port and the local networks (${nets:-none}) leave outside the tunnel"
    ;;
  off)
    nft destroy table inet "$table"
    write_state '{"armed": false}'
    echo "kill switch off"
    ;;
  *) usage ;;
esac
