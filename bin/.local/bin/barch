#!/usr/bin/env bash
# shellcheck source-path=SCRIPTDIR
# barch — stable command line for the BArch desktop, for scripts and agents.
#
# Desktop commands are thin IPC calls into the Quickshell bar (qs ipc call <target> <fn>), which
# does the actual work with the same functions as the Control Center. Nothing is reimplemented
# here. The IPC functions answer JSON: {"ok":true,...} or {"ok":false,"error":"..."}.
#
# Agent commands:
#   snapshot   safety snapshots of / around Claude sessions in ~/BArch (Claude hooks →
#              barch-agent-snapshot@.service, allowed by polkit; see system/files)
#   failure    OnFailure handler of every service: saves the log, notifies with "Investigate"
#   agent      read-only scheduled tasks (agent/tasks/<task>.md, timers barch-agent@<task>.timer)
#   aur        review of the PKGBUILD changes of pending AUR updates (Update All runs it)
#
# finance import: C6 Bank statements → Firefly III (finance/import.py; data in ~/.config/firefly).
# backup: restic, encrypted, to the NAS; what to save is backup/include.txt (the repo cannot hold
#   secrets and app state); barch-backup.timer runs it daily; the health widget watches the result.
# State: ~/.local/state/barch (failures/, reports/, agent/, backup/).
#
# Exit codes: 0 ok, 1 the bar or the task refused or failed, 2 usage error, 3 the bar is not
# reachable, 4 (aur review) something needs a look before updating.
# Needs: qs (quickshell), jq; claude and foot for the agent commands.

set -uo pipefail

PROG=${0##*/}
JSON=0
SELF=$(readlink -f "${BASH_SOURCE[0]}")
REPO=$(cd "$(dirname "$SELF")/../../.." && pwd)        # bin/.local/bin/barch inside the repo
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/barch
BARCH="$HOME/.local/bin/barch"                         # how actions in notifications call back
export PATH="$HOME/.local/bin:$PATH"                   # systemd units and hooks have a short PATH
UUID_RE='^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'   # a Claude Code session id

# the commands live in bin/.local/lib/barch/<area>.sh, next to this file in the repo
LIB=$REPO/bin/.local/lib/barch
# shellcheck source=../lib/barch/usage.sh
source "$LIB/usage.sh"
# shellcheck source=../lib/barch/core.sh
source "$LIB/core.sh"
# shellcheck source=../lib/barch/desktop.sh
source "$LIB/desktop.sh"
# shellcheck source=../lib/barch/music.sh
source "$LIB/music.sh"
# shellcheck source=../lib/barch/books.sh
source "$LIB/books.sh"
# shellcheck source=../lib/barch/video.sh
source "$LIB/video.sh"
# shellcheck source=../lib/barch/torrents.sh
source "$LIB/torrents.sh"
# shellcheck source=../lib/barch/player.sh
source "$LIB/player.sh"
# shellcheck source=../lib/barch/hypr.sh
source "$LIB/hypr.sh"
# shellcheck source=../lib/barch/apps.sh
source "$LIB/apps.sh"
# shellcheck source=../lib/barch/snapshot.sh
source "$LIB/snapshot.sh"
# shellcheck source=../lib/barch/failure.sh
source "$LIB/failure.sh"
# shellcheck source=../lib/barch/voice.sh
source "$LIB/voice.sh"
# shellcheck source=../lib/barch/automation.sh
source "$LIB/automation.sh"
# shellcheck source=../lib/barch/agent.sh
source "$LIB/agent.sh"
# shellcheck source=../lib/barch/record.sh
source "$LIB/record.sh"
# shellcheck source=../lib/barch/backup.sh
source "$LIB/backup.sh"
# shellcheck source=../lib/barch/finance.sh
source "$LIB/finance.sh"

# ---------------------------------------------------------------- main

# --json may come anywhere
args=()
for a in "$@"; do
  case $a in
    --json) JSON=1 ;;
    *) args+=("$a") ;;
  esac
done
set -- "${args[@]}"

cmd=${1:-help}
(($#)) && shift
case $cmd in
  notify) cmd_notify "$@" ;;
  theme) cmd_theme "$@" ;;
  wallpaper) cmd_wallpaper "$@" ;;
  hypr) cmd_hypr "$@" ;;
  center) cmd_center "$@" ;;
  packages) cmd_packages "$@" ;;
  mixer) cmd_mixer "$@" ;;
  clip) cmd_clip "$@" ;;
  hdr) cmd_hdr "$@" ;;
  sdr) cmd_sdr "$@" ;;
  monitor) cmd_monitor "$@" ;;
  caffeine) cmd_caffeine "$@" ;;
  nightlight | night-light) cmd_nightlight "$@" ;;
  dnd) cmd_dnd "$@" ;;
  anon) cmd_anon "$@" ;;
  vpn) cmd_vpn "$@" ;;
  music) cmd_music "$@" ;;
  player) cmd_player "$@" ;;
  books) cmd_books "$@" ;;
  video) cmd_video "$@" ;;
  torrents) cmd_torrents "$@" ;;
  health) cmd_health "$@" ;;
  inbox) cmd_inbox "$@" ;;
  claude) cmd_claude "$@" ;;
  rules) cmd_rules "$@" ;;
  events) cmd_events "$@" ;;
  metrics) cmd_metrics "$@" ;;
  nas) cmd_nas "$@" ;;
  disk) cmd_disk "$@" ;;
  fw | pfsense) cmd_fw "$@" ;;
  rgb) cmd_rgb "$@" ;;
  drop) cmd_drop "$@" ;;
  voice) cmd_voice "$@" ;;
  snapshot) cmd_snapshot "$@" ;;
  failure) cmd_failure "$@" ;;
  agent) cmd_agent "$@" ;;
  aur) cmd_aur "$@" ;;
  replay) cmd_replay "$@" ;;
  mic) cmd_mic "$@" ;;
  applio) cmd_applio "$@" ;;
  backup) cmd_backup "$@" ;;
  finance) cmd_finance "$@" ;;
  help | -h | --help) usage ;;
  *) usage_error "unknown command '$cmd'" ;;
esac
