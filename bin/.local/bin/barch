      else python3 -I "$REPO/agent/drop.py" status; fi ;;
    setup | open) python3 -I "$REPO/agent/drop.py" "$sub" ;;
    *) usage_error "drop status|setup|open" ;;
  esac
}

# ---------------------------------------------------------------- agent

# frontmatter field of a task file: task_field <file> <key>
task_field() { awk -v k="$2" 'NR == 1 && $0 == "---" {f = 1; next} f && $0 == "---" {exit}
                              f && index($0, k ":") == 1 {sub(/^[^:]*:[ \t]*/, ""); print; exit}' "$1"; }
task_body() { awk 'NR == 1 && $0 == "---" {f = 1; next} f == 1 && $0 == "---" {f = 2; next} f != 1' "$1"; }

# split "Read Bash(git log *) WebFetch(domain:x)" into words, keeping the parentheses whole
split_tools() {
  local s=$1 re='^[[:space:]]*([^[:space:](]+(\([^)]*\))?)'
  TOOLS=()
  while [[ $s =~ $re ]]; do
    TOOLS+=("${BASH_REMATCH[1]}")
    s=${s:${#BASH_REMATCH[0]}}
  done
}

default_schema='{"type":"object","properties":{
  "status":{"type":"string","enum":["ok","warn","alert"]},
  "title":{"type":"string"},"summary":{"type":"string"},"report":{"type":"string"}},
  "required":["status","title","summary","report"]}'

agent_footer() {
  cat <<EOF

---

## How this run works

You are running unattended and read-only, started by a timer: there is nobody to answer
questions. Tools outside the allowed list are denied; do not try to work around a denial, mention
it in the report instead. The facts for this run are in $1 (start with context.md); those files
and the files of this repository are the sources to use.

Write in Brazilian Portuguese (code, paths and commands stay as they are). Fill:
- \`status\`: \`ok\` (nothing needs attention), \`warn\` (worth a look soon), \`alert\` (needs action now);
- \`title\`: one line for the notification title, under 70 characters;
- \`summary\`: one or two sentences for the notification body;
- \`report\`: the full report in Markdown, starting with the conclusion.

Today is $(date '+%A, %Y-%m-%d %H:%M %Z').
EOF
}

# agent_fail <task> <message> <log>: notify and exit 1
agent_fail() {
  post "Agent task $1 failed" "$2" normal "Agent" "[$(action "Show log" foot -T "$1" -e less "$3")]"
  die 1 "$1: $2 (log: $3)"
}

agent_run() {
  local task="" quiet=0
  while (($#)); do
    case $1 in
      --quiet) quiet=1 ;;
      -*) usage_error "agent run: unknown option '$1'" ;;
      *) task=$1 ;;
    esac
    shift
  done
  local file=$REPO/agent/tasks/$task.md helper=$REPO/agent/tasks/$task.sh
  [[ -n $task && -r $file ]] || usage_error "agent run <task> (tasks: $(agent_names | paste -sd' '))"
  need claude

  local tstate=$STATE/agent/$task stamp rundir rc=0
  mkdir -p "$tstate/runs" "$STATE/reports/$task"
  exec 9>"$tstate/lock"
  flock -n 9 || die 1 "$task is already running"
  stamp=$(date +%Y%m%d-%H%M%S)
  rundir=$tstate/runs/$stamp
  mkdir -p "$rundir"
  export BARCH_REPO=$REPO BARCH_STATE=$tstate BARCH_STATE_ROOT=$STATE

  # prepare: the task's script collects the facts (exit 75 = nothing to do this time)
  if [[ -f $helper ]]; then
    bash "$helper" prepare "$rundir" >"$rundir/prepare.log" 2>&1 || rc=$?
    if ((rc == 75)); then
      rm -rf "$rundir"
      if [[ $JSON == 1 ]]; then jq -n --arg t "$task" '{ok: true, task: $t, skipped: true}'
      else echo "$task: nothing to do"; fi
      return 0
    fi
    ((rc == 0)) || agent_fail "$task" "preparing the facts failed" "$rundir/prepare.log"
  fi

  local schema=$default_schema model
  [[ -r $REPO/agent/tasks/$task.schema.json ]] && schema=$(jq -c . "$REPO/agent/tasks/$task.schema.json")
  model=$(task_field "$file" model)
  split_tools "$(task_field "$file" tools)"
  { task_body "$file"; agent_footer "$rundir"; } >"$rundir/prompt.md"

  local -a args=(-p --output-format json --permission-mode dontAsk --strict-mcp-config
    --add-dir "$rundir" --json-schema "$schema")
  [[ -n $model ]] && args+=(--model "$model")
  args+=(--disallowedTools Edit Write NotebookEdit --allowedTools "${TOOLS[@]}")
  (cd "$REPO" && BARCH_AGENT_TASK=$task timeout 35m claude "${args[@]}" \
    <"$rundir/prompt.md" >"$rundir/result.json" 2>"$rundir/claude.log") || rc=$?
  if ! jq -e '.subtype == "success" and (.is_error | not) and (.structured_output | type == "object")' \
      "$rundir/result.json" >/dev/null 2>&1; then
    { echo "exit code: $rc"; cat "$rundir/claude.log"; jq -r '.result // empty' "$rundir/result.json" 2>/dev/null; } >>"$rundir/error.log"
    agent_fail "$task" "Claude did not finish the task (exit $rc)" "$rundir/error.log"
  fi

  local out=$STATE/reports/$task report meta
  report=$out/$stamp.md
  meta=$out/$stamp.json
  jq -r --arg task "$task" --arg when "$(date '+%Y-%m-%d %H:%M')" '
    .structured_output as $o
    | "# \($o.title)\n\n_\($task) · \($when) · \($o.status)_\n\n\($o.report)\n\n---\n\nSession `\(.session_id)`: `barch agent continue \(.session_id)`\n"' \
    "$rundir/result.json" >"$report"
  jq --arg task "$task" --arg time "$(date -Is)" --arg report "$report" '
    {ok: true, task: $task, time: $time, status: .structured_output.status, title: .structured_output.title,
     summary: .structured_output.summary, session: .session_id, cost: .total_cost_usd, report: $report}' \
    "$rundir/result.json" >"$meta"
  ln -sfn "$stamp.md" "$out/latest.md"
  ln -sfn "$stamp.json" "$out/latest.json"
  cost_log "$task" "$(jq -r '.total_cost_usd // empty' "$rundir/result.json")" "$(jq -r '.structured_output.title // empty' "$rundir/result.json")"

  [[ -f $helper ]] && { bash "$helper" finish "$rundir" "$rundir/result.json" "$report" >>"$rundir/prepare.log" 2>&1 ||
    echo "$PROG: $task: finish step failed (see $rundir/prepare.log)" >&2; }

  # keep the last 10 runs (facts) and 60 reports
  find "$tstate/runs" -mindepth 1 -maxdepth 1 -type d | sort -r | tail -n +11 | xargs -r rm -rf
  find "$out" -maxdepth 1 -name '2*' | sort -r | tail -n +121 | xargs -r rm -f

  local status notify urgency
  status=$(jq -r .status "$meta")
  notify=$(task_field "$file" notify)
  if ((quiet == 0)) && [[ $notify != never && ($notify != issues || $status != ok) ]]; then
    case $status in alert) urgency=critical ;; warn) urgency=normal ;; *) urgency=low ;; esac
    post "$(jq -r .title "$meta")" "$(jq -r .summary "$meta")" "$urgency" "Agent" \
      "$(jq -sc . <(action "Open report" foot -T "$task" -e nvim -R "$report") \
                  <(action "Continue" "$BARCH" agent continue "$(jq -r .session "$meta")"))"
  fi
  show "$(cat "$meta")" '"[\(.status)] \(.title)\n\(.summary)\nreport: \(.report)"'
}

agent_names() { find "$REPO/agent/tasks" -maxdepth 1 -name '*.md' -printf '%f\n' | sed 's/\.md$//' | sort; }

agent_list() {
  local t file last next enabled rows=()
  while read -r t; do
    file=$REPO/agent/tasks/$t.md
    last=$(cat "$STATE/reports/$t/latest.json" 2>/dev/null || echo null)
    enabled=$(systemctl --user is-enabled "barch-agent@$t.timer" 2>/dev/null)
    next=$(systemctl --user show "barch-agent@$t.timer" -p NextElapseUSecRealtime --value 2>/dev/null)
    rows+=("$(jq -nc --arg t "$t" --arg d "$(task_field "$file" description)" --argjson last "$last" \
      --arg en "${enabled:-not installed}" --arg next "$next" \
      '{task: $t, description: $d, timer: $en, next: $next, last: $last}')")
  done < <(agent_names)
  show "$(printf '%s\n' "${rows[@]}" | jq -s .)" '.[] |
    "\(.task) — \(.description)\n  timer: \(.timer)\(if .next != "" then ", next \(.next)" else "" end)\n  last: "
    + (if .last == null then "never" else "\(.last.time[0:16] | sub("T"; " ")) [\(.last.status)\(if .last.dismissed then ", dismissed" else "" end)] \(.last.title)" end)'
}

# agent dismiss [<task>|all]: the latest report of a task that asked for attention (warn, alert)
# stops counting in the Center's badge and in the Inbox: "dismissed" (the time) goes into its
# meta JSON, so every reader sees it; the report stays, and the next run starts clean.
agent_dismiss() {
  local what=${1:-all} f t n=0
  (($# <= 1)) || usage_error "agent dismiss [<task>|all]"
  [[ $what == all || -e $STATE/reports/$what/latest.json ]] || die 1 "no report for '$what'"
  for f in "$STATE"/reports/*/latest.json; do
    [[ -r $f ]] || continue
    t=${f%/latest.json}; t=${t##*/}
    [[ $what == all || $what == "$t" ]] || continue
    jq -e '.status != "ok" and (.dismissed | not)' "$f" >/dev/null 2>&1 || continue
    f=$(readlink -f "$f")
    jq --arg at "$(date -Is)" '.dismissed = $at' "$f" >"$f.tmp" && mv "$f.tmp" "$f" && n=$((n + 1))
  done
  show "$(jq -nc --arg what "$what" --argjson n "$n" '{ok: true, what: $what, count: $n}')" '"\(.count) report(s) dismissed"'
}

agent_continue() {
  [[ ${1:-} =~ $uuid_re ]] || usage_error "agent continue <session id>"
  need foot
  setsid -f foot -D "$REPO" -T "Claude" claude --resume "$1" >/dev/null 2>&1
}

agent_ask() {
  local args=() text=()
  while (($#)); do
    case $1 in
      --continue) args+=(--continue) ;;
      *) text+=("$1") ;;
    esac
    shift
  done
  need foot
  need claude
  ((${#text[@]})) && args+=("${text[*]}")
  setsid -f foot -D "$REPO" -T "Claude" claude "${args[@]}" >/dev/null 2>&1
}

agent_investigate() {
  local log=${1:-} unit
  [[ -r $log ]] || usage_error "agent investigate <failure log>"
  need foot
  need claude
  unit=$(sed -n 's/^Unit: //p' "$log" | head -1)
  setsid -f foot -D "$REPO" -T "Investigate: $unit" claude \
    "The service $unit failed. Its status and the journal of the failed run are in $log. Read it, find the cause (check more of the journal, the unit and its config as needed) and explain it to me. Propose the fix and wait for my go-ahead before changing anything." \
    >/dev/null 2>&1
}

cmd_agent() {
  local sub=${1:-}
  (($#)) && shift
  case $sub in
    list) agent_list ;;
    run) agent_run "$@" ;;
    report)
      [[ -n ${1:-} && -r $STATE/reports/$1/latest.md ]] || die 1 "no report for '${1:-}'"
      cat "$STATE/reports/$1/latest.md" ;;
    dismiss) agent_dismiss "$@" ;;
    continue) agent_continue "$@" ;;
    ask) agent_ask "$@" ;;
    investigate) agent_investigate "$@" ;;
    *) usage_error "agent list|run|report|dismiss|continue|ask|investigate" ;;
  esac
}

# ---------------------------------------------------------------- aur

# aur review: runs the aur-review task for changes not reviewed yet, then prints the verdict of
# every pending AUR update. Exit 0 all ok (or nothing pending), 4 something to look at or not
# reviewed, 1 the review could not run. run-update.sh asks before paru -Syu when it is not 0.
cmd_aur() {
  [[ ${1:-} == review ]] || usage_error "aur review"
  local rc=0 data
  export BARCH_REPO=$REPO BARCH_STATE=$STATE/agent/aur-review BARCH_STATE_ROOT=$STATE
  mkdir -p "$BARCH_STATE"
  [[ $JSON == 1 ]] || echo "Checking the pending AUR updates (new changes are reviewed by Claude, ~1–2 min)…" >&2
  (JSON=0 agent_run aur-review --quiet >&2) || rc=$?
  data=$(bash "$REPO/agent/tasks/aur-review.sh" status) || die 1 "could not list the pending AUR updates"
  show "$data" '
    def tag: {"ok": "ok   ", "warn": "WARN ", "alert": "ALERT"}[.] // "?    ";
    if length == 0 then "No pending AUR updates." else
      (.[] | "\(.verdict.status // "none" | tag)  \(.name) \(.old) → \(.new)"
             + (if .verdict then "\n         \(.verdict.summary)" else "\n         not reviewed" end)
             + (if (.verdict.flags // []) | length > 0 then "\n         flags: \(.verdict.flags | join("; "))" else "" end)),
      (if any(.[]; .verdict.report) then "\nReport: \([.[] | .verdict.report // empty] | unique | join(" "))" else empty end)
    end'
  ((rc == 0)) || return 1
  jq -e 'all(.[]; .verdict.status == "ok")' >/dev/null <<<"$data" || return 4
}

# ---------------------------------------------------------------- replay

REPLAYS=$HOME/Videos/Replays
SHARE_MAX=60                                           # WhatsApp status limit per video (s)

# secs <S|M:SS|H:MM:SS> → seconds (decimals kept), or fails
secs() {
  [[ $1 =~ ^([0-9]+:){0,2}[0-9]+(\.[0-9]+)?$ ]] || return 1
  awk -F: '{s = 0; for (i = 1; i <= NF; i++) s = s * 60 + $i; print s}' <<<"$1"
}

# replay share [file] [--from T] [--to T]: the replay (default: the newest one) as an MP4 that
# WhatsApp and the like accept: H.264 + AAC, 1080p at most, 30 fps, HDR (PQ/HLG) tone mapped to
# SDR, at most SHARE_MAX seconds. Written next to the original as <name>-share.mp4.
replay_share() {
  local file="" from="" to="" t
  while (($#)); do
    case $1 in
      --from | --to)
        if [[ $# -lt 2 ]] || ! t=$(secs "$2"); then
          usage_error "$1 needs a time (seconds, M:SS or H:MM:SS)"
        fi
        [[ $1 == --from ]] && from=$t || to=$t
        shift ;;
      -*) usage_error "replay share: unknown option '$1'" ;;
      *) [[ -z $file ]] || usage_error "replay share [file] [--from T] [--to T]"; file=$1 ;;
    esac
    shift
  done
  need ffmpeg
  need ffprobe
  if [[ -z $file ]]; then
    file=$(find "$REPLAYS" -maxdepth 1 -name '*.mkv' -printf '%T@ %p\n' 2>/dev/null | sort -n | tail -1 | cut -d' ' -f2-)
    [[ -n $file ]] || die 1 "no replays in $REPLAYS"
  fi
  [[ -r $file ]] || die 1 "cannot read '$file'"

  local info length transfer start len capped=false
  info=$(ffprobe -v error -select_streams v:0 -show_entries stream=color_transfer:format=duration \
    -of json "$file") || die 1 "not a video: $file"
  length=$(jq -r '.format.duration // 0' <<<"$info")
  transfer=$(jq -r '.streams[0].color_transfer // ""' <<<"$info")
  start=${from:-0}
  len=$(awk -v s="$start" -v e="${to:-$length}" -v l="$length" 'BEGIN {
    if (e > l) e = l; d = e - s; if (d < 0) d = 0; printf "%.3f", d }')
  awk -v d="$len" 'BEGIN { exit !(d > 0) }' || usage_error "replay share: empty range (the video has ${length%.*} s)"
  if awk -v d="$len" -v m="$SHARE_MAX" 'BEGIN { exit !(d > m) }'; then
    len=$SHARE_MAX capped=true
    [[ $JSON == 1 ]] || echo "$PROG: longer than ${SHARE_MAX} s, keeping ${start}s–$(awk -v s="$start" -v m="$SHARE_MAX" 'BEGIN { print s + m }')s" >&2
  fi

  # Downscale first: tone mapping in float at 4K runs at ~0.4x real time, at 1080p several times faster
  local vf="fps=30,scale=-2:'min(1080,ih)':flags=lanczos" hdr=false
  if [[ $transfer == smpte2084 || $transfer == arib-std-b67 ]]; then
    hdr=true
    vf+=",zscale=t=linear:npl=203,format=gbrpf32le,zscale=p=bt709,tonemap=hable:desat=0,zscale=t=bt709:m=bt709:r=tv"
  fi
  vf+=",format=yuv420p"

  local out=${file%.*}-share.mp4 tmp stats=()
  tmp=${out%.mp4}.part.mp4
  [[ $JSON == 1 ]] || stats=(-stats)
  [[ $JSON == 1 ]] || echo "Converting $(basename "$file") → $(basename "$out")…" >&2
  if ! ffmpeg -nostdin -hide_banner -loglevel error "${stats[@]}" -y \
    -ss "$start" -i "$file" -t "$len" -map 0:v:0 -map '0:a:0?' -vf "$vf" \
    -c:v libx264 -preset slow -crf 23 -profile:v high -c:a aac -b:a 128k -ac 2 \
    -movflags +faststart "$tmp"; then
    rm -f "$tmp"
    die 1 "ffmpeg failed on $file"
  fi
  mv -f "$tmp" "$out"

  show "$(jq -n --arg f "$out" --arg src "$file" --argjson from "$start" --argjson len "$len" \
    --argjson hdr "$hdr" --argjson capped "$capped" --argjson size "$(stat -c %s "$out")" \
    '{ok: true, file: $f, source: $src, from: $from, duration: $len, hdr: $hdr, capped: $capped, size: $size}')" \
    '"\(.file)\n\(.duration) s, \(.size / 1048576 * 10 | round / 10) MB" + (if .hdr then ", HDR tone mapped to SDR" else "" end)'
}

cmd_replay() {
  local sub=${1:-}
  (($#)) && shift
  case $sub in
    share) replay_share "$@" ;;
    *) usage_error "replay share [file] [--from T] [--to T]" ;;
  esac
}

# ---------------------------------------------------------------- finance

# ---------------------------------------------------------------- backup (restic → NAS)
BACKUP_REPO_DEFAULT=/mnt/nasfrutuozo/organization/desktops/bcfrutuozo/restic
BACKUP_CONF=${XDG_CONFIG_HOME:-$HOME/.config}/barch/backup.conf      # optional: BACKUP_REPO=<path or restic URL>
BACKUP_PASS=${XDG_CONFIG_HOME:-$HOME/.config}/barch/backup/password  # never in the repo
BACKUP_STATE=$STATE/backup                                           # last.json, last.err, vm/*.xml

backup_env() {
  # shellcheck source=/dev/null
  [[ -r $BACKUP_CONF ]] && source "$BACKUP_CONF"
  export RESTIC_REPOSITORY=${BACKUP_REPO:-$BACKUP_REPO_DEFAULT}
  export RESTIC_PASSWORD_FILE=$BACKUP_PASS
  export RESTIC_CACHE_DIR=${XDG_CACHE_HOME:-$HOME/.cache}/restic
  mkdir -p "$BACKUP_STATE"
}
# the repository is a path on the NAS: it has to be a mounted network share, not an empty mount point
backup_mounted() {
  [[ $RESTIC_REPOSITORY == /* ]] || return 0
  findmnt -T "$(dirname "$RESTIC_REPOSITORY")" -t cifs,nfs,nfs4 >/dev/null 2>&1
}
backup_state() {   # backup_state <ok: true|false> <error> [summary json]
  jq -n --argjson ok "$1" --arg error "$2" --argjson at "$(date +%s)" --argjson summary "${3:-null}"     --arg repo "$RESTIC_REPOSITORY" '{at: $at, ok: $ok, error: $error, repo: $repo, summary: $summary}'     > "$BACKUP_STATE/last.json.tmp" && mv "$BACKUP_STATE/last.json.tmp" "$BACKUP_STATE/last.json"
}
backup_fail() { backup_state false "$1"; logger -t barch-backup -- "failed: $1"; die 1 "$1"; }
# backup_check <read-data subset>: restic check, structure plus that part of the data read back and
# hashed (a backup never read is not known to be good). Result in check.json for status and the
# health widget; a failure fails the run (so the service's OnFailure reaches `barch failure`).
backup_check() {
  local subset=$1 start err rc=0
  start=$(date +%s)
  err=$(restic check --with-cache --read-data-subset="$subset" 2>&1 >/dev/null) || rc=$?
  if ((rc)); then
    err=$(grep -vE '^(load indexes|check all packs|check snapshots|\[.*\]|$)' <<<"$err" | head -3 | paste -sd ' ' | cut -c1-300)
  else
    err=""
  fi
  jq -n --argjson ok "$([[ $rc == 0 ]] && echo true || echo false)" --arg error "$err" --arg subset "$subset" \
     --argjson at "$(date +%s)" --argjson took "$(( $(date +%s) - start ))" \
     '{at: $at, ok: $ok, error: $error, subset: $subset, took: $took}' > "$BACKUP_STATE/check.json.tmp" \
    && mv "$BACKUP_STATE/check.json.tmp" "$BACKUP_STATE/check.json"
  if ((rc)); then
    logger -t barch-backup -- "check failed ($subset): $err"
    return 1
  fi
  logger -t barch-backup -- "check ok ($subset of the data read, $(( $(date +%s) - start )) s)"
}

cmd_backup() {
  local sub=${1:-status}
  (($#)) && shift
  case $sub in
    init)
      need restic; backup_env
      [[ -s $BACKUP_PASS ]] && die 1 "already initialised: $BACKUP_PASS exists (repository: $RESTIC_REPOSITORY)"
      backup_mounted || die 1 "the NAS share for $RESTIC_REPOSITORY is not mounted"
      install -d -m 700 "$(dirname "$BACKUP_PASS")"
      (umask 077; head -c 32 /dev/urandom | base64 | tr -d '\n' > "$BACKUP_PASS")
      restic init --quiet || { rm -f "$BACKUP_PASS"; die 1 "restic init failed"; }
      echo "Repository: $RESTIC_REPOSITORY"
      echo "Password file: $BACKUP_PASS"
      echo
      echo "Save this password in Bitwarden now. Without it the backup cannot be read:"
      echo
      echo "  $(cat "$BACKUP_PASS")"
      echo
      echo "Next: barch backup run; the timer: systemctl --user enable --now barch-backup.timer"
      ;;
    run)
      need restic; backup_env
      [[ -s $BACKUP_PASS ]] || backup_fail "not initialised: run 'barch backup init'"
      backup_mounted || backup_fail "the NAS share for $RESTIC_REPOSITORY is not mounted"
      # the VM definitions (the disk images are rebuilt; the XML is what took work)
      mkdir -p "$BACKUP_STATE/vm"
      while IFS= read -r vm; do
        [[ -n $vm ]] && virsh --connect qemu:///system dumpxml --inactive "$vm" > "$BACKUP_STATE/vm/${vm// /_}.xml" 2>/dev/null
      done < <(virsh --connect qemu:///system list --all --name 2>/dev/null)
      # include list → absolute paths that exist
      local files start summary rc
      files=$(mktemp)
      while IFS= read -r p; do
        [[ $p == /* ]] || p="$HOME/$p"
        [[ -e $p ]] && echo "$p"
      done < <(grep -vE '^\s*(#|$)' "$REPO/backup/include.txt") > "$files"
      [[ -s $files ]] || backup_fail "nothing to back up: backup/include.txt matched no existing path"
      start=$(date +%s)
      summary=$(restic backup --files-from "$files" --exclude-file "$REPO/backup/exclude.txt" --exclude-caches \
                  --tag auto --json 2>"$BACKUP_STATE/last.err" | jq -c 'select(.message_type == "summary")' | tail -1)
      rc=${PIPESTATUS[0]}; rm -f "$files"
      # 3 = some files could not be read (a socket, a file that vanished): the snapshot was still made
      [[ $rc == 0 || $rc == 3 ]] || backup_fail "restic backup failed (exit $rc): $(grep -v '^$' "$BACKUP_STATE/last.err" | tail -1)"
      if [[ ${1:-} == --prune || $(date +%u) == 7 ]]; then
        # prune needs an exclusive lock, and a lock left by an interrupted read (the Backup Browser's ls/stats,
        # a killed restic) blocks it forever; unlock only removes stale ones (dead PID here or older than 30 min)
        restic unlock --quiet 2>>"$BACKUP_STATE/last.err"
        local mark; mark=$(wc -l < "$BACKUP_STATE/last.err")
        restic forget --keep-daily 14 --keep-weekly 8 --keep-monthly 12 --prune --quiet 2>>"$BACKUP_STATE/last.err" \
          || backup_fail "restic forget/prune failed: $(tail -n +"$((mark + 1))" "$BACKUP_STATE/last.err" | grep -v '^$' | head -2 | paste -sd ' ')"
      fi
      backup_state true "" "${summary:-null}"
      if [[ ${1:-} == --prune || $(date +%u) == 7 ]]; then
        # the snapshot is in (last.json says ok); now a tenth of the data is read back, a different
        # tenth each week (ISO week mod 10), so every pack is verified within ten weeks
        backup_check "$(( $(date +%-V) % 10 + 1 ))/10" || die 1 "backup ok, but restic check failed: $(jq -r .error "$BACKUP_STATE/check.json")"
      fi
      logger -t barch-backup -- "ok: $(jq -r '"\(.files_new + .files_changed) files changed, \(.data_added) bytes added, snapshot \(.snapshot_id[0:8])"' <<<"${summary:-{}}" 2>/dev/null)"
      show "$(jq -c --argjson took "$(( $(date +%s) - start ))" '. + {took: $took}' "$BACKUP_STATE/last.json")" \
        '"backup ok: \(.summary.files_new + .summary.files_changed) files changed, \(.summary.data_added / 1048576 | floor) MB added, \(.summary.total_files_processed) files in \(.took) s, snapshot \(.summary.snapshot_id[0:8])"'
      ;;
    status)
      backup_env
      local last next check
      last=$(cat "$BACKUP_STATE/last.json" 2>/dev/null || echo '{"at":0,"ok":false,"error":"","summary":null}')
      check=$(cat "$BACKUP_STATE/check.json" 2>/dev/null || echo null)
      next=$(systemctl --user show barch-backup.timer -p NextElapseUSecRealtime --value 2>/dev/null)
      show "$(jq -c --arg next "${next:-}" --argjson configured "$([[ -s $BACKUP_PASS ]] && echo true || echo false)" \
              --arg repo "$RESTIC_REPOSITORY" --argjson check "$check" '. + {next: $next, configured: $configured, repo: $repo, check: $check}' <<<"$last")" '
        if .configured | not then "backup: not initialised (barch backup init); repository would be \(.repo)"
        elif .at == 0 then "backup: never ran (barch backup run); repository \(.repo)"
        else "backup: " + (if .ok then "ok" else "FAILED: \(.error)" end)
          + " · last \(.at | strflocaltime("%Y-%m-%d %H:%M"))"
          + (if .summary then " · \(.summary.total_files_processed) files, \(.summary.data_added / 1048576 | floor) MB added, snapshot \(.summary.snapshot_id[0:8])" else "" end)
          + "\n  repository \(.repo)"
          + (if .check then "\n  check: " + (if .check.ok then "ok" else "FAILED: \(.check.error)" end)
               + " · \(.check.at | strflocaltime("%Y-%m-%d %H:%M")) · \(.check.subset) of the data read in \(.check.took) s"
             else "\n  check: never ran (barch backup check; the Sunday run does it)" end)
          + (if .next != "" then "\n  next run \(.next)" else "\n  timer not enabled (systemctl --user enable --now barch-backup.timer)" end)
        end'
      ;;
    check)
      need restic; backup_env
      [[ -s $BACKUP_PASS ]] || die 1 "not initialised: run 'barch backup init'"
      backup_mounted || die 1 "the NAS share for $RESTIC_REPOSITORY is not mounted"
      local subset=10%
      case ${1:-} in
        --full) subset=100% ;;
        --read-data) [[ -n ${2:-} ]] || usage_error "backup check --read-data <n/t|x%|size>"; subset=$2 ;;
        "") ;;
        *) usage_error "backup check [--full|--read-data <subset>]" ;;
      esac
      echo "checking $RESTIC_REPOSITORY ($subset of the data read back)…" >&2
      backup_check "$subset" || die 1 "restic check failed: $(jq -r .error "$BACKUP_STATE/check.json")"
      show "$(cat "$BACKUP_STATE/check.json")" '"check ok: \(.subset) of the data read and verified in \(.took) s"'
      ;;
    list)
      need restic; backup_env
      [[ -s $BACKUP_PASS ]] || die 1 "not initialised: run 'barch backup init'"
      restic snapshots --compact
      ;;
    restore)
      need restic; backup_env
      [[ -s $BACKUP_PASS ]] || die 1 "not initialised: run 'barch backup init'"
      local snap=latest target="" paths=() a
      [[ ${1:-} =~ ^([0-9a-f]{8,}|latest)$ ]] && { snap=$1; shift; }
      while (($#)); do
        a=$1; shift
        case $a in
          --target) target=${1:-}; shift ;;
          *) paths+=("$a") ;;
        esac
      done
      ((${#paths[@]})) || usage_error "backup restore [SNAPSHOT] <path>... [--target DIR]"
      [[ -n $target ]] || target="$HOME/Restore/$snap-$(date +%Y%m%d-%H%M)"
      local inc=()
      for a in "${paths[@]}"; do [[ $a == /* ]] || a="$HOME/$a"; inc+=(--include "$a"); done
      restic restore "$snap" --target "$target" "${inc[@]}" && echo "restored into $target (paths keep their full names below it)"
      ;;
    browse) app_open backup BARCH_BACKUP_PAGE "${1:-}" ;;
    *) usage_error "backup init|run [--prune]|check [--full|--read-data <subset>]|status|list|restore [SNAPSHOT] <path>... [--target DIR]|browse [<page>]" ;;
  esac
}

cmd_finance() {
  [[ ${1:-} == import ]] || usage_error "finance import [--dry-run] [--keep] [--yes] [--dir DIR] [--seed]"
  shift
  need python3
  exec python3 "$REPO/finance/import.py" "$@"
}

