#!/usr/bin/env bash
# barch — stable command line for the BArch desktop, for scripts and agents.
#
# Desktop commands are thin IPC calls into the Quickshell bar (qs ipc call <target> <fn>), which
# does the actual work with the same functions as the Control Center. Nothing is reimplemented
# here. The IPC functions answer JSON: {"ok":true,...} or {"ok":false,"error":"..."}.
#
# Agent commands:
#   snapshot   safety snapshots of / around Claude sessions in ~/BArch (Claude hooks →
#              barch-agent-snapshot@.service, allowed by polkit; see system/files)
#   failure    OnFailure handler of every service: saves the log, notifies with "Investigate"
#   agent      read-only scheduled tasks (agent/tasks/<task>.md, timers barch-agent@<task>.timer)
#   aur        review of the PKGBUILD changes of pending AUR updates (Update All runs it)
#
# finance import: C6 Bank statements → Firefly III (finance/import.py; data in ~/.config/firefly).
# backup: restic, encrypted, to the NAS; what to save is backup/include.txt (the repo cannot hold
#   secrets and app state); barch-backup.timer runs it daily; the health widget watches the result.
# State: ~/.local/state/barch (failures/, reports/, agent/, backup/).
#
# Exit codes: 0 ok, 1 the bar or the task refused or failed, 2 usage error, 3 the bar is not
# reachable, 4 (aur review) something needs a look before updating.
# Needs: qs (quickshell), jq; claude and foot for the agent commands.

set -uo pipefail

PROG=${0##*/}
JSON=0
SELF=$(readlink -f "${BASH_SOURCE[0]}")
REPO=$(cd "$(dirname "$SELF")/../../.." && pwd)        # bin/.local/bin/barch inside the repo
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/barch
BARCH="$HOME/.local/bin/barch"                         # how actions in notifications call back
export PATH="$HOME/.local/bin:$PATH"                   # systemd units and hooks have a short PATH

usage() {
  cat <<EOF
Usage: $PROG [--json] <command> [args]

Desktop (through the bar):
  notify <title> [body] [--critical|--low] [--app NAME] [--action LABEL=COMMAND]...
                              notification through the bar's own server; each --action is a
                              button that runs COMMAND (sh -c)
  theme light|dark|auto|status
                              appearance (Auto follows the theme-auto schedule)
  theme dark <palette>, theme light <palette>, theme palettes
                              the palette pinned to each mode (everything generated follows it)
  theme edit [<palette>]      the palette editor (quickshell/palette): ten tones with live
                              preview on the whole desktop; Save pins it and renders its wallpapers
  theme from-image <image> [--id ID] [--label NAME] [--dark|--light]
                              a palette from the image's colors, opened in the editor
  theme delete <palette>      remove it from theme/palettes.json (not while pinned)
  theme export <palette>      its JSON (theme/palettes.json entry)
  wallpaper list|status       the scenes in ~/Pictures/Wallpapers, which is on the desktop and the lock
  wallpaper <scene> [--lock|--desktop]
                              use a scene (both by default; a lock-only choice stays until changed)
  wallpaper render [<palette>|all]
                              draw the scenes in a palette's colors (the bar does it on its own the
                              first time a palette is pinned); default: the palette in use
  hypr [edit] [<page>]        Hyprland Settings (quickshell/hypr): every option of the installed
                              version, monitors, binds, animations, rules, devices, startup; page:
                              a section (general, decoration, input…) or monitors|binds|animations|
                              rules|devices|startup|files
  hypr get <option>           an option: current value, default, what the app saved
  hypr set <option> <value>   save it in hypr/settings.json and apply it live (value as JSON:
                              10, true, "dwindle", {"colors":["rgba(ff0000ff)"],"angle":45})
  hypr reset <option>|all     forget it (the files' value is back after the reload this does)
  hypr list|status            what the app saved · version, option count, config errors
  backup browse [<page>]      BArch Backup (quickshell/backup): status, snapshots, browse a snapshot
                              and restore into ~/Restore; page: status|snapshots|browse
  packages [<page>]           BArch Packages (quickshell/packages): installed (explicit, AUR, orphans),
                              updates, .pacnew, the repo lists, pacman history; page: installed|updates|history
  mixer [<page>]              BArch Mixer (quickshell/mixer): PipeWire devices, per-app volume and
                              routing, sample rate, Bluetooth codec; page: devices|apps|settings
  clip [<file>]               BArch Clip (quickshell/clip): a video editor like the iPhone's: cut the
                              borders away (crop), turn, mirror, trim, Preview, Save (a new file
                              next to the original, or over it with the original in the trash)
  clip info <file>            what clip.py sees: size as displayed, fps, codec, HDR, rotation, audio
  clip export <file> [--crop W:H:X:Y] [--rotate 90|180|270] [--flip h|v|hv] [--from T] [--to T]
                     [-o OUT] [--replace]   the same edit without the window (crop measured on the
                              frame as displayed, after the rotation and the flips); NVENC, HDR10 kept
  center [<page>]             BArch Center (quickshell/center): the NAS (page nas), the firewalls (firewalls), services and timers (user and
                              system), the failures saved by `barch failure`, the agent tasks
                              and reports, the safety snapshots, health, journal; page: overview|
                              services|timers|failures|agent|snapshots|journal
  hdr on|off|status           HDR on the main monitor
  sdr <nits>|status           SDR brightness inside HDR
  monitor side on|off|status  side monitor (DPMS)
  caffeine on|off|status      keep the screen from idling, locking and suspending
  nightlight on|off|status    night light (hyprsunset)
  dnd on|off|status           Do Not Disturb
  anon on [region]|off|toggle|status
                              Anonymous Mode (the Control Center tile): the VPN with a kill
                              switch, Mullvad Browser as the default browser and the hostname
                              out of DHCP; status also lists what the mode cannot cover
  vpn on [region]|off|toggle|status
                              the VPN alone: PIA over WireGuard (what Anonymous Mode uses)
  vpn regions                 regions, fastest first; vpn region <id>|auto picks the one to use
  health [--refresh]          system health summary (.pacnew, failed services, TPM, cleanup)
  inbox [--refresh]           what waits for a decision: music and video review, library albums to tie,
                              book requests, failures of the day, health issues, agent reports (the bar's
                              tray icon with the total; quickshell/inbox)
  claude [--refresh]          the Claude plan's usage as /usage shows it: 5-hour session, week, the top model's
                              share (Fable), resets, plan (Max 5x), and what this machine's agents spent today
  voice on|off|toggle|status  always-on voice control (quickshell/voice, barch-voice.service):
                              say "barch" and the command, in Portuguese
  voice pause|resume          keep the service but ignore the microphone / listen again
  voice lang [<code>|list]    the language it listens and answers in (pt, en, es, auto… every
                              language whisper knows; only Portuguese has the command table,
                              the rest goes to Claude; the Piper voice is downloaded when picked)
  voice say <text>            speak TEXT (piper)
  voice match <text>          which command TEXT would run, running nothing (to test commands.json)
  voice wake <text>           would TEXT (as whisper might write it) wake the daemon, and with what left
  voice misses [n]            first words that came close to "barch" without waking it (to tune the
                              spellings in config.json)
  voice test <text>           run TEXT as if it had been heard (no wake word; it does act)
  voice reload                reload commands.json and the app/project lists
  voice log                   the daemon's journal
  voice setup [--install]     what is missing (whisper.cpp, model, piper, voice); --install asks paru
  music status|list [state]   the music pipeline on the NAS (server/music): downloads -> /music
  music browse [<page>]       BArch Music (quickshell/music): the review queue with the resolve inputs
                              as a form, every album handled (undo), Lidarr [review|albums|covers|lidarr]
  music show <id>             one album: problems, MusicBrainz candidates, the proposed tags
  music accept-year [--dry-run] [--older-than DAYS]
                              the review albums whose only problem is a year-only date (nothing on earth has
                              the day): resolve them all with --date-year-only; --dry-run lists them
  music resolve <id> [--release MBID|URL] [--cover URL|file] [--date YYYY-MM-DD] [--genre G]
        [--album A] [--artist A] [--title D.TT=Title]... [--replace-tracks 1.15,2.03] [--replace]
        [--date-year-only]    (only when no source on earth has the day: the date becomes YYYY-01-01)
        [--keep-order]        (an edition MusicBrainz lacks, e.g. an LP: same songs, the download's order)
                              decide and run it again (an album already in /music is completed
                              and fixed by the library's rules; --replace-tracks swaps the audio of
                              those tracks, --replace the whole album)
  music retry|reject|undo <id>   run again / give up / put back what it changed in /music
  music reject <id> --delete  give up and delete the download once every album of it is done or rejected
  music cover <id> <file|URL> [label]   the cover you found for an album waiting on it: checked, kept
                              with the job and the album runs again with it (= --cover + resolve)
  music cover-ask <id> ["hint"]   Claude searches the web for the album's front cover and runs the
                              album with it (what the music-cover rule does by itself)
  music fix <id> ["hint"]     Fix with Agent: Claude takes the album over (release, date, genre, cover,
                              the merge), resolves it, waits for the run and goes on until it is in
  music scan                  look for finished torrents and inbox folders now
  music mb-add <id>|"<A/B>"   an edition MusicBrainz lacks (a job, or a library album the Library tab could not tie): the release editor opens in the browser filled in
                              from the download (tracks, lengths); you check and submit, logged in there
  music library [list]        the library albums the MusicBrainz sweep could not tie (the Library tab)
  music library show|compare|tag|skip|retry "<Artist/Album>" [<release>]   one of them: the entry, the
                              files against a release track by track, tag it with that release, skip, judge again
  music library reorder "<Artist/Album>" <release>   the same songs in another order: files renumbered and renamed
                              to MusicBrainz's order (titles and audio untouched, undo log), then tagged
  music library delete "<Artist/Album>" [<release>]   the files you have out of /music (/music/.library-trash, 30 days);
                              Lidarr monitors and searches the album again
  music library fix "<Artist/Album>" ["hint"]   Claude finds the release (lengths, catalogue, the web) and tags it
  music artists [list|all]    the artist folders of /music against Lidarr's artists, the ones to decide (all: every one)
  music artists show "<folder>"|find "<name>"   MusicBrainz artists for a folder (credited by its albums first) or a name
  music artists link "<folder>" <artist mbid|URL>   the folder becomes that Lidarr artist (a wrong one removed, files kept)
  music artists move "<folder>" "<into>" [--replace]   its album folders into the folder of the artist they are credited
                              to (--replace: a same-name album there goes to /music/.library-trash and this one takes its place)
  music artists add <mbid|URL> · remove <lidarr id> · skip|unskip "<folder>"   track an artist not in /music yet;
                              drop a Lidarr artist that maps no file; leave a folder without one
  music agent-sweep [library|review|all] [--parallel N] [--limit N]   Claude over every album waiting
                              (Library tab: library fix; Review: music fix), detached; status|stop
  music retitle <Artist/Album> <title>   fix the ALBUM tag (as given) and the folder of an album in /music
  music rescan <id>           take that job's download in again from scratch, as the albums are found
                              now (a torrent split per disc folder by an older version); old jobs superseded
  music covers [list]         the library's covers that were checked: a scan with a frame, a cleaner one
  music covers check [<artist>]   look for scans with a frame (and the clean artwork) in /music
  music covers apply|undo|keep <Artist/Album>   replace cover.jpg + embedded art + Plex poster / undo / keep it
  music covers pick <Artist/Album> <n>         candidate n (as listed in the app) becomes the proposal
  music covers propose <Artist/Album> <file|URL> [label]   a new image as the proposal (still needs apply)
  music covers ask <Artist/Album> "what is wrong"   Claude looks at the candidates, adapts one or finds
                              another and proposes it (Bruno still decides with apply)
  music restart               restart the pipeline in the container (new code after install)
  books browse [page]         the Books app: search Hardcover, Want to Read, requests, downloads
  books search <query>        Hardcover books (★ = on Want to Read) · shelf: Want to Read and what
                              Shelfmark did with each · want|unwant <id> · sync (Hardcover Sync now)
  books requests [status]     Shelfmark's requests (pending by default, "all"; rejected: what you said no to,
                              fulfil takes one back) · show <id>
  books releases <id> [--query Q] [--source S]   releases for a request · fulfil <id> --pick N
  books accept <id> [--query Q]   download the best release carrying the title (no author check)
  books reject|reopen|cancel <id> · downloads · install
  books fix <id> ["hint"]     Claude takes a request no source matched and downloads the right release
  video browse [page]         the Video app: search and add, movies and series with the checklist of each
                              file, releases by hand, downloads, the PT-BR dub (search|movies|series|downloads|dub)
  video status|list [state]   the video pipeline on the NAS (server/video): the PT-BR dub muxed into
                              each 4K file Radarr grabs (states: search, waiting, downloading,
                              aligning, review, done, skipped)
  video show <id>             one movie (m<id>) or season (s<series>x<season>): candidates, alignment, history
  video retry|skip|unskip <id>   search again from scratch / leave alone / take back
  video use <id> <guid>       try this candidate next (from video show)
  video search <id> "query"   Prowlarr with your own query; what fits the job joins its candidates
  video add <id> <url> ["title"]   a magnet or torrent URL found elsewhere, tried next
  video fix <id> ["hint"]     Fix with Agent: Claude finds the donor (Brazilian title, packs, another cut) and runs it
  video foreign               files with audio beyond the original and PT-BR, and what the trim does about them
  video scan|digest [days]|restart   run now / the week / restart after install
  video audit [--json|--foreign]   the library against the rule (HEVC, 2160p, HDR, bitrate, audio, subtitles)
  video install               copy Recyclarr's rules and the pipeline to the NAS (server/video/install.sh)
  player [browse] [page]      the Player (quickshell/player): the /music library played here, in the bar's theme
                              (albums|artists|tracks|genres|queue|favorites|recent|lyrics|stats|viz|eq|settings)
  player play|pause|toggle|next|prev|stop   transport · status: what plays (--json for the whole state)
  player volume <0-100|±n>|seek <s|±s>|like|shuffle [on|off]|repeat [off|all|one]
  player album|play-album|queue-album "<Artist/Album>"   open, play, or queue an album · playlist <name>
  player search "<text>"      the window on a search · catalog refresh [--full]: the NAS reads /music again
  player eq [on|off|toggle|<preset>|band <1-10> <dB>|preamp <dB>]   the equalizer (no argument: its state and the presets)
  player plex [status|sessions]   what the pipeline told Plex about the player (Tautulli reads it), Plex's Now Playing
  player show|hide|quit       the window back · closed with the music on (the bar gets a button) · stop everything
  torrents browse [page]      the Torrents app: qBittorrent over time (overview|sources|torrents)
  torrents status             the statistics service on the NAS (server/torrents): samples, last one, errors
  torrents summary [range]    ratio, upload and download: all time, in the range (24h, 7d, 30d, 12w, 1y, all), now
  torrents sources [indexer|category|tracker] [range]   where the traffic comes from, with each one's ratio
  torrents top [range] [n]    the torrents that uploaded the most in the range
  torrents sample|restart     read qBittorrent now / restart the service
  torrents install            copy the service to the NAS (server/torrents/install.sh)
  music lidarr-flac-only      every Lidarr quality profile: FLAC and FLAC 24bit only
  music lidarr-monitor <ids> on|off   monitor or not these Lidarr album ids
  music lidarr-search <ids>   monitor these Lidarr albums and search the indexers now
  music lidarr-artists [q]    the artists Lidarr tracks · lidarr-albums <artist|id>: their albums with type, id and
                              why each counts as official (studio, wikidata, wikipedia) or "unofficial"
  music lidarr-artist-set all|<ids> [--monitored on|off] [--new-albums all|none|new]
                              artist settings: whether an album that shows up later gets monitored (and downloaded)
  music lidarr-enforce        every artist on the BArch profile, every official album without a file monitored (the pipeline does it hourly)
  music adopt "<Artist/Album>" <release>   a hand-made album of /music, now on MusicBrainz: merged into itself with that
                              release (MusicBrainz ids and the library's rules on its files, audio never replaced)
  music lidarr-add <mbid> <folder>   track an artist /music already has, at its own folder, with the library's profiles
                              (one Lidarr's metadata server does not know yet waits: lidarr-pending, tried hourly)
  music lidarr-commands       Lidarr's running and recent commands · lidarr-cancel <id> stops one (a RefreshArtist in flight undoes monitor changes)
  music digest [days]         the week of the pipeline in one message (Telegram gets it on Sundays at 18:00)
  music seeds [days] [--live]  the torrents kept seeding until their goal (ratio 2 after 72 h, or 30 days) and the
                              seed history of the ones removed (per tracker); --live adds every torrent in qBittorrent
  music seeds check           the hourly seed check now (deletes what reached its ratio or its time)
  music lidarr-stalled [h]    downloads with no progress for 48 h (or h): the hourly check blocklists them and searches another
  music lidarr-queue          what Lidarr grabbed and is downloading · lidarr-queue-remove <ids>|all [--keep]: drop them (blocklisted)
  music lidarr-release-profiles   what Lidarr never grabs (box sets, discographies, complete collections: kept by the hourly check)
  music lidarr-profiles       the metadata profiles · lidarr-profile <name> --primary Album,EP --secondary Live
                              --statuses Official [--apply all|<artist ids>]: create/update one (and assign it)
  music lidarr-lists          the import lists · lidarr-list <Type> <name> field=value.. [--monitor none|specificAlbum|entireArtist]
                              e.g. lidarr-list LastFmUser "Last.fm" userId=bruno count=50
  music install               copy server/music to the NAS (server/music/install.sh)

Automation (agent/rules.json + agent/events.py, barch-events.service):
  rules list                  the rules, enabled or not, when each fired last
  rules test <event> [k=v..]  which rules an event would hit (nothing runs); rules test metric <name> <value>
  rules fire <id> [k=v..]     run a rule's actions now (what the "Run" button of an ask rule does)
  rules enable|disable <id>   flip a rule in rules.json (the daemon reloads it)
  events status|log [n] [--filter text] [--since 24h]
                              the daemon, the last events (windows, monitors, VPN, network, lock,
                              failures, boots, Claude cost, rules fired)
  metrics list                every metric with its last value
  metrics series <metric> [--since 24h|7d|30d] [--points N]
                              a time series (raw for a week, hourly averages for a year)
  metrics summary             boot time, failures per week, Claude cost, temperatures now
  nas status [--no-certs]     the NAS now, through Unraid's API (agent/nas.py): array, disks, pools,
                              containers down or with an update, Unraid's unread warnings, days left
                              on the certificates; barch-events samples the same (nas.* rules)
  nas setup                   write ~/.config/barch/nas.json (URL and API key from Homepage's Unraid widget)
  disk status                 the local disks (agent/disk.py): SMART of each (temperature, wear, spare, media
                              errors, self-test), the btrfs error counters and the last scrub, from the hourly
                              dump of barch-disk-health (root, system/); barch-events samples the same
                              (smart.* and btrfs.* metrics, disk.* and btrfs.* rules); exit 1 with problems
  fw status [site]            the pfSense firewalls (omni, chaos) through their REST API (agent/pfsense.py):
                              load, gateways, interfaces, IPsec tunnel, DNSBL alive, blocked connections;
                              barch-events samples the same (fw.* rules: down, reboot, gateway, tunnel, new device)
  fw clients [site]           the DHCP leases by interface, who is online · fw blocked [site] [n]: the last blocks
  fw setup                    how to make the read-only API users and keys, and what ~/.config/barch/pfsense.json holds
  rgb [status]|apply|on|off   the Corsair keyboard and mouse in the theme's color (agent/rgb.py, ckb-next;
                              barch-rgb.service repaints on theme changes and after a resume)
  rgb color <tone|#hex>       a palette tone (accent, green, red...) or a fixed color
  rgb brightness <0-100>      rgb flash [tone|#hex] [times]   blink, then back (for rules)
  drop [status]               BArch Drop (agent/drop.py, barch-drop.service): files and links from the iPhone over
                              the LAN into ~/Downloads/iPhone (text to the clipboard); the last ones received
  drop setup                  the page link (QR code) and the share sheet Shortcut, with the URL and token
  drop open                   the folder they land in

Agent:
  agent list                  scheduled tasks, last result and next run
  agent run <task> [--quiet]  run a task now (read-only; --quiet: no notification)
  agent report <task>         print the last report of a task
  agent dismiss [<task>|all]  the last report (warn, alert) stops asking for attention in the
                              Center and the Inbox; the report stays
  agent continue <session>    open a task's session in Claude to talk about it
  agent ask [text] [--continue]
                              open Claude in a terminal in the repo, starting with TEXT if given
                              (--continue: resume the last session there; the launcher's "a ")
  agent investigate <log>     open Claude on a saved failure log (the "Investigate" button)
  aur review                  review the PKGBUILD changes of pending AUR updates, print the
                              verdicts (exit 4 if something needs a look)
  snapshot list               safety snapshots taken around Claude sessions in ~/BArch
  snapshot hook               Claude Code SessionStart/SessionEnd hook (reads JSON on stdin)
  failure <unit> [--system]   OnFailure handler: save the log and notify (used by systemd);
                              a Hyprland crash groups its casualties into one notification
  failure list [<unit>]       the saved failure logs, newest first
  failure dismiss|delete [<unit>|all]
                              dismiss: the logs stay but stop counting in the Center and the
                              Inbox; delete: the logs are removed

Backup (restic, encrypted, to the NAS; list: backup/include.txt in the repo):
  backup init                 create the repository and the password (printed once: keep it in
                              Bitwarden; without it the backup cannot be read)
  backup run [--prune]        back up now (barch-backup.timer does it daily at 13:00; old
                              snapshots are pruned on Sundays, or with --prune, and a tenth of the
                              data is read back and verified: the whole repository every ten weeks)
  backup check [--full|--read-data <subset>]
                              verify the repository now: structure, and the data (10% by default,
                              --full reads everything; restic's n/t, x% or a size)
  backup status               last run and the timer's next run
  backup list                 snapshots
  backup restore [SNAPSHOT] <path>... [--target DIR]
                              restore paths (absolute, as they were) from SNAPSHOT (default
                              latest) into DIR (default ~/Restore/<snapshot>, never in place)

Media:
  replay share [file] [--from T] [--to T]
                              the replay (default: the newest in ~/Videos/Replays) as an MP4 for
                              WhatsApp status and the like: H.264, ≤1080p30, HDR tone mapped to
                              SDR, at most 60 s; T is seconds, M:SS or H:MM:SS. Writes
                              <name>-share.mp4 next to it

Finance:
  finance import [--dry-run] [--keep] [--yes] [--dir DIR] [--seed]
                              consolidate the C6 Bank files in ~/.config/firefly/learning (CSV,
                              invoice PDFs, screenshots of the open invoice) into Firefly: asks
                              what it does not know, skips what is already there, then moves the
                              files to processed/ (--seed: mark the inbox as done, import nothing)

  help                        this text

  --json   machine-readable output (desktop commands, agent list/run, aur review, snapshot list,
           replay share, rules/events/metrics)

Exit codes: 0 ok, 1 refused or failed, 2 usage error, 3 the bar is not reachable,
4 (aur review) something needs a look before updating.
EOF
}

die() { echo "$PROG: $2" >&2; exit "$1"; }
usage_error() { echo "$PROG: $1" >&2; echo "Try '$PROG help'." >&2; exit 2; }
need() { command -v "$1" >/dev/null || die 3 "$1 not found"; }

need jq

# ---------------------------------------------------------------- bar IPC

# ipc_try <target> <function> [args...] → JSON answer in $OUT, error text in $ERR.
# Returns 0 ok, 1 refused by the bar, 3 bar not reachable. qs ipc call exits 0 even for
# "Target not found.", so the answer itself is checked.
OUT="" ERR=""
ipc_try() {
  local out
  OUT="" ERR=""
  command -v qs >/dev/null || { ERR="qs (quickshell) not found"; return 3; }
  out=$(qs ipc call "$@" 2>&1) || { ERR="the bar is not reachable: ${out:-qs ipc failed}"; return 3; }
  if ! jq -e 'type == "object" and has("ok")' >/dev/null 2>&1 <<<"$out"; then
    ERR="the bar is not reachable (qs ipc call $1 $2): ${out:-no answer}"
    return 3
  fi
  OUT=$out
  if [[ $(jq -r '.ok' <<<"$out") != true ]]; then
    ERR=$(jq -r '.error // "unknown error"' <<<"$out")
    return 1
  fi
}

# ipc: like ipc_try, but exits on failure. (A global $OUT instead of $(ipc ...), so that die
# exits the script and not a subshell.)
ipc() {
  local rc=0
  ipc_try "$@" || rc=$?
  ((rc == 0)) && return
  [[ $rc == 1 && $JSON == 1 ]] && jq . <<<"$OUT"
  die "$rc" "$ERR"
}

# show <json> <jq filter for the text output>
show() {
  if [[ $JSON == 1 ]]; then jq . <<<"$1"; else jq -r "$2" <<<"$1"; fi
}

# toggle <target> <function> on|off|status <text filter>: status, or set and show the new state
toggle() {
  local target=$1 fn=$2 arg=$3 text=$4 status=status
  [[ $target == notifs ]] && status=dndStatus
  case $arg in
    status) ipc "$target" "$status" ;;
    on) ipc "$target" "$fn" true ;;
    off) ipc "$target" "$fn" false ;;
    *) usage_error "expected on, off or status, got '$arg'" ;;
  esac
  show "$OUT" "$text"
}

onoff_text='if . then "on" else "off" end'

# post <title> <body> <urgency> <app> [<actions: JSON array>]: notification for internal use.
# Never exits: without the bar it falls back to notify-send (no buttons there).
post() {
  ipc_try notifs post "$1" "$2" "$3" "$4" "$(actions_arg "${5:-}")" && return 0
  command -v notify-send >/dev/null && notify-send -u "$3" -a "$4" "$1" "$2" 2>/dev/null
  return 0
}

# the bar takes the buttons as {"actions": [...]}: qs ipc call strips the brackets of an
# argument that is a bare "[...]"
actions_arg() { [[ -z $1 || $1 == '[]' ]] || jq -c '{actions: .}' <<<"$1"; }

# action <label> <command words...> → {"text","cmd"} for a notification button
action() {
  local label=$1 cmd
  shift
  printf -v cmd '%q ' "$@"
  jq -nc --arg t "$label" --arg c "${cmd% }" '{text: $t, cmd: $c}'
}

# ---------------------------------------------------------------- desktop commands

cmd_notify() {
  local title="" body="" urgency=normal app=barch actions='[]'
  local -a pos=()
  while (($#)); do
    case $1 in
      --critical) urgency=critical ;;
      --low) urgency=low ;;
      --app) [[ $# -ge 2 ]] || usage_error "--app needs a name"; app=$2; shift ;;
      --action)
        [[ $# -ge 2 && $2 == ?*=?* ]] || usage_error "--action needs LABEL=COMMAND"
        actions=$(jq -c --arg t "${2%%=*}" --arg c "${2#*=}" '. + [{text: $t, cmd: $c}]' <<<"$actions")
        shift ;;
      --) shift; pos+=("$@"); break ;;
      -*) usage_error "notify: unknown option '$1'" ;;
      *) pos+=("$1") ;;
    esac
    shift
  done
  ((${#pos[@]} >= 1 && ${#pos[@]} <= 2)) || usage_error "notify needs <title> [body]"
  title=${pos[0]}
  body=${pos[1]:-}
  [[ -n $title ]] || usage_error "notify: empty title"
  ipc notifs post "$title" "$body" "$urgency" "$app" "$(actions_arg "$actions")"
  show "$OUT" \
    'if .dnd then "sent (Do Not Disturb is on: history only)" else "sent" end'
}

cmd_theme() {
  local text='"appearance: \(.appearance) (now \(.mode), palette \(.flavor); dark \(.dark), light \(.light))"'
  case ${1:-} in
    dark | light)
      if [[ -n ${2:-} ]]; then ipc theme flavor "$1" "$2"; ipc theme status
      else ipc theme mode "$1"; ipc theme status; fi ;;
    auto) ipc theme mode "$1"; ipc theme status ;;
    status) ipc theme status ;;
    palettes)
      ipc theme palettes
      show "$OUT" '(["dark:"] + [.dark[] | "  \(.id)\t\(.label)" + (if .active then "  (pinned)" else "" end)]
                   + ["light:"] + [.light[] | "  \(.id)\t\(.label)" + (if .active then "  (pinned)" else "" end)]) | .[]'
      return ;;
    edit) theme_edit "${2:-}"; return ;;
    from-image) shift; theme_from_image "$@"; return ;;
    delete)
      [[ -n ${2:-} ]] || usage_error "theme delete <palette>"
      ipc theme remove "$2"; show "$OUT" '"removed \(.id)"'; return ;;
    export)
      [[ -n ${2:-} ]] || usage_error "theme export <palette>"
      ipc theme get "$2"; show "$OUT" '.palette'; return ;;
    *) usage_error "theme light|dark|auto|status | theme dark|light <palette> | theme palettes | theme edit [<palette>] | theme from-image <image> | theme delete|export <palette>" ;;
  esac
  show "$OUT" "$text"
}

# theme edit [id]: the palette editor, its own Quickshell config (quickshell/palette). One window:
# a running editor gets the request over its own IPC.
theme_edit() {
  local cfg=$HOME/.config/quickshell/palette
  need qs
  if qs -p "$cfg" ipc show >/dev/null 2>&1; then
    if [[ -n ${1:-} ]]; then qs -p "$cfg" ipc call editor open "$1" >/dev/null; fi
    return 0
  fi
  BARCH_PALETTE_EDIT=${1:-} setsid -f qs -p "$cfg" >/dev/null 2>&1
}

# theme from-image <image> [--id ID] [--label NAME] [--dark|--light]: tools/palette_from_image.py
# writes a draft (~/.local/state/quickshell/palette-draft.json) that the editor opens unsaved.
theme_from_image() {
  local img=${1:-}
  [[ -n $img ]] || usage_error "theme from-image <image> [--id ID] [--label NAME] [--dark|--light]"
  shift
  [[ -r $img ]] || die 2 "cannot read $img"
  need python3
  need qs
  local draft=${XDG_STATE_HOME:-$HOME/.local/state}/quickshell/palette-draft.json cfg=$HOME/.config/quickshell/palette
  mkdir -p "$(dirname "$draft")"
  python3 -I "$REPO/tools/palette_from_image.py" "$img" "$@" >"$draft" || die 1 "the generator failed (python3 + Pillow)"
  if ((JSON)); then cat "$draft"; else jq -r '"\(.id) (\(if .dark then "dark" else "light" end)): base \(.base), text \(.text), accent \(.accent)  → editor"' "$draft"; fi
  if qs -p "$cfg" ipc show >/dev/null 2>&1; then
    qs -p "$cfg" ipc call editor draft "$draft" >/dev/null
  else
    BARCH_PALETTE_DRAFT=$draft setsid -f qs -p "$cfg" >/dev/null 2>&1
  fi
}

cmd_wallpaper() {
  local scene="" target=both
  for a in "$@"; do
    case $a in
      --lock) target=lock ;;
      --desktop) target=desktop ;;
      -*) usage_error "wallpaper list|status|<scene> [--lock|--desktop]" ;;
      *) if [[ $scene == render ]]; then set -- render "$a"; elif [[ -n $scene ]]; then usage_error "one scene at a time"; else scene=$a; fi ;;
    esac
  done
  case $scene in
    list)
      ipc wallpaper list
      show "$OUT" '.scenes[] | "\(.id)\t\(.label)\t\(.description)"' ;;
    status | '')
      ipc wallpaper status
      show "$OUT" '"desktop: \(.desktop), lock screen: \(.lock), palette: \(.used)"
                   + (if .available then "" else " (no \(.palette) set yet)" end)
                   + (if .rendering != "" then ", rendering \(.rendering)" else "" end)' ;;
    render)
      ipc wallpaper render "${2:-}"
      show "$OUT" '"rendering: \(.rendering) (palettes ready: \(.palettes | join(", ")))"' ;;
    *)
      ipc wallpaper set "$scene" "$target"
      show "$OUT" '"desktop: \(.desktop), lock screen: \(.lock)"' ;;
  esac
}

control_text_hdr='"hdr: \(.hdr | '"$onoff_text"')" + (if .hdr then " (SDR white \(.sdrWhite) nits)" else "" end)'

cmd_hdr() { toggle control hdr "${1:-}" "$control_text_hdr"; }

cmd_sdr() {
  local text='"SDR white: \(.sdrWhite) nits (range \(.sdrMin)–\(.sdrMax))" + (if .hdr then "" else ", HDR is off" end)'
  case ${1:-} in
    status) ipc control status ;;
    '' | *[!0-9]*) usage_error "sdr <nits>|status" ;;
    *) ipc control sdr "$1" ;;
  esac
  show "$OUT" "$text"
}

cmd_monitor() {
  [[ ${1:-} == side ]] || usage_error "monitor side on|off|status"
  toggle control side "${2:-}" '"side monitor (\(.sideOutput)): \(.side | '"$onoff_text"')"'
}

cmd_caffeine() { toggle control caffeine "${1:-}" '"caffeine: \(.caffeine | '"$onoff_text"')"'; }

cmd_nightlight() {
  local text='if .hasHyprsunset | not then "night light: hyprsunset not installed"
              else "night light: \(.nightLight | '"$onoff_text"')" + (if .nightLight then " (\(.nightTemp) K)" else "" end) end'
  toggle control nightLight "${1:-}" "$text"
}

cmd_dnd() { toggle notifs dndSet "${1:-}" '"do not disturb: \(.dnd | '"$onoff_text"')"'; }

# music: the pipeline runs in the barch-music container on the NAS (server/music); this only talks
# to its API with the URL and token install.sh left in ~/.config/barch/music.json
music_api() {   # music_api GET|POST <path> [json body]
  local conf="$HOME/.config/barch/music.json" url token
  [[ -r $conf ]] || die 3 "no $conf: run barch music install first"
  url=$(jq -r .url "$conf"); token=$(jq -r .token "$conf")
  OUT=$(curl -sS --max-time "${MUSIC_API_TIMEOUT:-60}" -X "$1" -H "X-Barch-Token: $token" -H "Content-Type: application/json" \
    ${3:+--data "$3"} "$url$2" 2>&1) || die 3 "music pipeline not reachable at $url ($OUT)"
  jq -e . >/dev/null 2>&1 <<<"$OUT" || die 3 "music pipeline answered: ${OUT:0:200}"
  [[ $(jq -r '.ok' <<<"$OUT") == true ]] || { [[ $JSON == 1 ]] && jq . <<<"$OUT"; die 1 "$(jq -r '.error // "failed"' <<<"$OUT")"; }
}

# music_upload <Artist/Album> <image file> <label>: POST the image itself as a new cover proposal
music_upload_job() {   # music_upload_job <id> <file>: the image becomes the job's chosen cover (checked by the pipeline)
  local conf="$HOME/.config/barch/music.json" url token ctype
  url=$(jq -r .url "$conf"); token=$(jq -r .token "$conf")
  case ${2,,} in *.png) ctype=image/png ;; *.webp) ctype=image/webp ;; *) ctype=image/jpeg ;; esac
  OUT=$(curl -sS --max-time 120 -X POST -H "X-Barch-Token: $token" -H "Content-Type: $ctype" \
    --data-binary "@$2" "$url/api/jobs/$1/cover?label=$(jq -rn --arg l "$(basename "$2")" '$l | @uri')" 2>&1) || die 3 "music pipeline not reachable ($OUT)"
  jq -e . >/dev/null 2>&1 <<<"$OUT" || die 3 "music pipeline answered: ${OUT:0:200}"
  [[ $(jq -r .ok <<<"$OUT") == true ]] || die 1 "$(jq -r '.error // "refused"' <<<"$OUT")"
}

music_upload() {
  local conf="$HOME/.config/barch/music.json" url token qs
  url=$(jq -r .url "$conf"); token=$(jq -r .token "$conf")
  qs=$(jq -rn --arg f "$1" --arg l "$3" '"folder=\($f | @uri)&label=\($l | @uri)"')
  OUT=$(curl -sS --max-time 120 -X POST -H "X-Barch-Token: $token" -H "Content-Type: image/jpeg" \
    --data-binary "@$2" "$url/api/covers/propose?$qs" 2>&1) || die 3 "music pipeline not reachable ($OUT)"
  jq -e . >/dev/null 2>&1 <<<"$OUT" || die 3 "music pipeline answered: ${OUT:0:200}"
  [[ $(jq -r .ok <<<"$OUT") == true ]] || die 1 "$(jq -r '.error // "refused"' <<<"$OUT")"
}

# music_covers_ask <Artist/Album> "what is wrong": a Claude run in a folder with the album's
# candidate images, the pipeline's notes and Bruno's complaint; it may adapt one (magick) or
# search the web, and proposes the result with `barch music covers propose` (never applies it)
music_covers_ask() {
  local folder=${1:-} complaint=${2:-}
  [[ -n $folder && -n $complaint ]] || usage_error "music covers ask <Artist/Album> \"what is wrong with the candidates\""
  need claude
  music_api GET /api/covers
  local entry
  entry=$(jq -c --arg f "$folder" '.entries[] | select(.folder == $f)' <<<"$OUT")
  [[ -n $entry ]] || die 1 "$folder was not checked yet: barch music covers check \"${folder%%/*}\""
  local conf="$HOME/.config/barch/music.json" url token run i n
  url=$(jq -r .url "$conf"); token=$(jq -r .token "$conf")
  run=$STATE/music-covers/$(date +%Y%m%d-%H%M%S)
  mkdir -p "$run"
  fetch() { curl -sSf --max-time 60 -G -H "X-Barch-Token: $token" --data-urlencode "folder=$folder" -d "which=$1" -o "$run/$2" "$url/api/covers/image" 2>/dev/null; }
  fetch current current.jpg || true
  n=$(jq '.alts // [] | length' <<<"$entry")
  for ((i = 0; i < n; i++)); do fetch "alt:$i" "alt$i.jpg" || true; done
  {
    echo "# Context"
    echo
    echo "- Album folder: \`$folder\` (use exactly this with barch music covers propose)"
    echo "- Artist: $(jq -r '.artist // ""' <<<"$entry") · album tag: $(jq -r '.album // ""' <<<"$entry")"
    jq -r 'if .mbid and .mbid != "" then "- MusicBrainz release: https://musicbrainz.org/release/\(.mbid)" else "- No MusicBrainz release id in the tags" end' <<<"$entry"
    echo "- Run folder (write here only): $run"
    echo
    echo "## Bruno's complaint"
    echo
    echo "$complaint"
    echo
    echo "## Images"
    echo
    echo "| file | what | size | notes |"
    echo "|---|---|---|---|"
    jq -r '"| current.jpg | the library'"'"'s cover.jpg now | \(.current.w // "?")x\(.current.h // "?") | \(if .current.framed then "scan frame detected" else "" end) |"' <<<"$entry"
    jq -r '.alts // [] | to_entries[] | "| alt\(.key).jpg | \(.value.source) | \(.value.orig) (as converted: \(.value.w)x\(.value.h)) | \([(if .value.framed then "scan frame (trimmed in this file)" else empty end), (if .value.same != null then "similarity to the scans \(.value.same * 100 | floor / 100)" else empty end), (if .value.trusted | not then "rejected: other artwork" else empty end), (if .value.best then "the pipeline'"'"'s pick" else empty end)] | join("; ")) |"' <<<"$entry"
    echo
    echo "## What the pipeline tried"
    echo
    jq -r '.tried // [] | map("- " + .) | join("\n")' <<<"$entry"
  } >"$run/context.md"
  { cat "$REPO/quickshell/.config/quickshell/music/cover-ask.md"; echo; cat "$run/context.md"; } >"$run/prompt.md"
  music_claude_run "$run" "cover $folder" "barch music covers propose"
  OUT=$(jq -c --arg f "$folder" --arg run "$run" '{ok: true, folder: $f, run: $run, summary: .structured_output.summary,
    proposed: .structured_output.proposed, session: .session_id, cost: .total_cost_usd}' "$run/result.json")
  show "$OUT" '.summary + (if .proposed then "\n(new proposal in Covers: barch music covers apply \"" + .folder + "\" to use it)" else "" end)'
}

# agent_claude_run <cost source> <run dir> <cost note> <barch command>...: Claude on $run/prompt.md (dontAsk,
# read-only but for the barch commands listed, e.g. "barch music cover"), the answer in $run/result.json;
# MUSIC_CLAUDE_TIMEOUT (20m) bounds it. Always Sonnet (MUSIC_CLAUDE_MODEL): a fix that chained three
# rounds cost US$ 1.48 on the default model (2026-11-03); these are lookups, not reasoning.
# music_claude_run is the same with the cost logged as music-agent; video_fix_job logs video-agent
music_claude_run() { agent_claude_run music-agent "$@"; }
agent_claude_run() {
  local source=$1 run=$2 note=$3 rc=0 c
  shift 3
  # read-only helpers too: a command chained with an unlisted tool (curl … | head) is refused whole
  local allowed=(Read Glob WebSearch WebFetch "Bash(curl *)" "Bash(magick *)" "Bash(identify *)" "Bash(ffprobe *)" "Bash(sleep *)"
                 "Bash(head *)" "Bash(tail *)" "Bash(ls *)" "Bash(cat *)" "Bash(wc *)" "Bash(grep *)" "Bash(jq *)" "Bash(file *)"
                 "Bash(sort *)" "Bash(cut *)" "Bash(tr *)" "Bash(echo *)" "Bash(mkdir *)")
  for c in "$@"; do allowed+=("Bash($c *)"); done
  local schema='{"type":"object","properties":{"summary":{"type":"string"},"proposed":{"type":"boolean"}},"required":["summary","proposed"]}'
  (cd "$run" && timeout "${MUSIC_CLAUDE_TIMEOUT:-20m}" claude -p --model "${MUSIC_CLAUDE_MODEL:-sonnet}" --output-format json --permission-mode dontAsk --strict-mcp-config \
    --add-dir "$run" --json-schema "$schema" --disallowedTools Edit Write NotebookEdit \
    --allowedTools "${allowed[@]}" \
    <"$run/prompt.md" >"$run/result.json" 2>"$run/claude.log") || rc=$?
  cost_log "$source" "$(jq -r '.total_cost_usd // empty' "$run/result.json" 2>/dev/null)" "$note"
  jq -e '.structured_output | type == "object"' "$run/result.json" >/dev/null 2>&1 ||
    die 1 "Claude did not finish (exit $rc): see $run/claude.log"
}

# music mb-add <id>: an edition MusicBrainz lacks. The job's download (artist, album, year, every track
# with its title and length) becomes a "release editor seed": a form that opens the MusicBrainz
# release editor in the browser already filled in; Bruno, logged in there, checks and submits (nothing
# is written from here). Then `barch music resolve <id> --release <the new mbid>`.
music_mb_add() {
  local id=${1:-}
  [[ -n $id ]] || usage_error "music mb-add <id>|\"<Artist/Album>\""
  local job out
  if [[ $id == */* ]]; then
    # an album of the library the sweep could not tie to MusicBrainz (the Library tab): its files' tracks
    music_api GET /api/library/sweep
    job=$(jq -c --arg f "$id" '.decide[] | select(.folder == $f) | {id: ($f | gsub("[^A-Za-z0-9]+"; "-")), name: $f, tracks,
      hints: {artist: ($f | split("/")[0]), album: ($f | split("/")[1] | sub(" \\((19|20)[0-9]{2}\\)$"; ""))}, proposal: {}}' <<<"$OUT")
    [[ -n $job ]] || die 1 "$id is not among the library albums waiting for a decision"
  else
    music_api GET "/api/jobs/$id"
    job=$(jq -c .job <<<"$OUT")
  fi
  [[ $(jq -r '.tracks | length' <<<"$job") -gt 0 ]] || die 1 "the job has no track list yet (run it once: barch music retry $id)"
  out=$STATE/music-agent/mb-seed-$id.html
  mkdir -p "$(dirname "$out")"
  jq -r '
    def esc: tostring | gsub("&"; "&amp;") | gsub("<"; "&lt;") | gsub("\""; "&quot;");
    def field(k; v): "<input type=\"hidden\" name=\"" + (k | esc) + "\" value=\"" + (v | esc) + "\">";
    (.proposal.album // .hints.album // .name) as $album |
    (.proposal.artist_folder // .hints.artist // "") as $artist |
    (.proposal.date // "") as $date |
    ((.hints.year // "") | tostring) as $year |
    "<!doctype html><meta charset=utf-8><title>MusicBrainz: add " + ($album | esc) + "</title>",
    "<body onload=\"document.forms[0].submit()\" style=\"font-family:sans-serif;padding:2em\">",
    "<p>Opening the MusicBrainz release editor with <b>" + ($artist | esc) + " – " + ($album | esc) + "</b> filled in. Log in if asked, check every field, then submit.</p>",
    "<form method=post action=\"https://musicbrainz.org/release/add\">",
    field("name"; $album),
    field("artist_credit.names.0.name"; $artist),
    field("artist_credit.names.0.artist.name"; $artist),
    field("status"; "official"),
    (if ($date | test("^\\d{4}-\\d{2}-\\d{2}$")) then
        field("events.0.date.year"; $date[0:4]), field("events.0.date.month"; $date[5:7]), field("events.0.date.day"; $date[8:10])
     elif ($year | test("^\\d{4}$")) then field("events.0.date.year"; $year) else empty end),
    ((.tracks | group_by(.disc)) | to_entries[] | .key as $m | .value as $ts |
        field("mediums.\($m).format"; "CD"),
        ($ts | sort_by(.index) | to_entries[] |
            field("mediums.\($m).track.\(.key).number"; (.value.index | tostring)),
            field("mediums.\($m).track.\(.key).name"; .value.title),
            field("mediums.\($m).track.\(.key).length"; ((.value.seconds * 1000) | floor | tostring)))),
    field("edit_note"; "Added from a download with the BArch music pipeline (track lengths from the files); job " + .id + " · " + (.name // "")),
    "<button>Open the release editor</button></form>"
  ' <<<"$job" >"$out"
  xdg-open "$out" >/dev/null 2>&1 &
  echo "release editor seed opened in the browser: $out"
  if [[ $id == */* ]]; then
    echo "after submitting, paste the new release in the Library tab and Tag (or: curl the API's /api/library/tag)"
  else
    echo "after submitting, take the new release id and run: barch music resolve $id --release <mbid>"
  fi
}

# music fix <id> ["hint"]: the Fix with Agent button. Claude gets the whole job (problems, candidates,
# proposal, merge plan, what was tried), researches, decides with `barch music resolve` / `barch music
# cover`, waits for the run and goes on with the next problem until the album is in (job-fix.md).
music_fix_job() {
  local id=${1:-} hint=${2:-}
  [[ -n $id ]] || usage_error "music fix <id> [\"hint\"]"
  need claude
  music_api GET "/api/jobs/$id"
  local job run
  job=$(jq -c .job <<<"$OUT")
  run=$STATE/music-agent/job-$id-$(date +%Y%m%d-%H%M%S)
  mkdir -p "$run"
  {
    echo "# Context"
    echo
    echo "- Job id: \`$id\` (use exactly this with barch music resolve / cover / show)"
    jq -r '"- Download: \(.name)\n- State: \(.state)\n- Source on the NAS: \(.source)\n- Audio: \(.audio.tracks // "?") tracks on \(.audio.discs // "?") disc(s), \((.audio.format // []) | join(", "))"' <<<"$job"
    jq -r '.source | if startswith("/data/") then "- The same folder on this machine (read only; its images can be looked at with Read): /mnt/nasfrutuozo/downloads/torrents/" + .[6:] else empty end' <<<"$job"
    echo "- Run folder (write here only): $run"
    if [[ -n $hint ]]; then echo; echo "## Bruno's hint"; echo; echo "$hint"; fi
    echo
    echo "## The job, as barch music show prints it"
    echo
    echo '```'
    "$0" music show "$id" 2>/dev/null || jq . <<<"$job"
    echo '```'
    echo
    echo "## The job as JSON (hints, track lengths, overrides, merge plan, cover sources tried)"
    echo
    echo '```json'
    jq '{id, state, kind, hints, audio, problems, notes, chosen, cover, cover_label, overrides, keep_order, replace, replace_tracks,
         match, candidates, proposal, merge, cover_tried, result, after, log: (.log | .[-40:])}' <<<"$job"
    echo '```'
  } >"$run/context.md"
  { cat "$REPO/quickshell/.config/quickshell/music/job-fix.md"; echo; cat "$run/context.md"; } >"$run/prompt.md"
  MUSIC_CLAUDE_TIMEOUT=40m music_claude_run "$run" "fix $id" "barch music show" "barch music resolve" "barch music cover"
  OUT=$(jq -c --arg id "$id" --arg run "$run" '{ok: true, id: $id, run: $run, summary: .structured_output.summary,
    fixed: .structured_output.proposed, session: .session_id, cost: .total_cost_usd}' "$run/result.json")
  show "$OUT" '.summary'
}

# music cover-ask <id> ["hint"]: an album stopped for its cover (or about to get a bad one): Claude
# searches the web for the real front, checks it and delivers it with `barch music cover`, which runs
# the album again. The music-cover rule of agent/rules.json calls this for every album that waits
# only for a cover; the Review tab has a button for it too.
music_cover_ask_job() {
  local id=${1:-} hint=${2:-}
  [[ -n $id ]] || usage_error "music cover-ask <id> [\"hint\"]"
  need claude
  music_api GET "/api/jobs/$id"
  local job run
  job=$(jq -c .job <<<"$OUT")
  run=$STATE/music-covers/job-$id-$(date +%Y%m%d-%H%M%S)
  mkdir -p "$run"
  {
    echo "# Context"
    echo
    echo "- Job id: \`$id\` (use exactly this with barch music cover)"
    jq -r '"- Download: \(.name)\n- State: \(.state)\n- Artist folder: \(.proposal.artist_folder // .hints.artist // "?") · album tag: \(.proposal.album // .hints.album // "?") · date: \(.proposal.date // "?")"' <<<"$job"
    jq -r 'if .match.mbid then "- MusicBrainz release: https://musicbrainz.org/release/\(.match.mbid)  (\(.match.title) · \(.match.date) · \(.match.country))" else "- No MusicBrainz release matched yet" end' <<<"$job"
    echo "- Run folder (write here only): $run"
    echo
    echo "## Why it stopped"
    echo
    jq -r '.problems // [] | map("- " + .) | join("\n")' <<<"$job"
    if [[ -n $hint ]]; then echo; echo "## Bruno's hint"; echo; echo "$hint"; fi
    echo
    echo "## What the pipeline tried"
    echo
    jq -r '.cover_tried // [] | map("- " + .) | join("\n")' <<<"$job"
  } >"$run/context.md"
  { cat "$REPO/quickshell/.config/quickshell/music/job-cover-ask.md"; echo; cat "$run/context.md"; } >"$run/prompt.md"
  music_claude_run "$run" "cover job $id" "barch music cover"
  OUT=$(jq -c --arg id "$id" --arg run "$run" '{ok: true, id: $id, run: $run, summary: .structured_output.summary,
    proposed: .structured_output.proposed, session: .session_id, cost: .total_cost_usd}' "$run/result.json")
  show "$OUT" '.summary'
}

# music library ...: the albums of /music the sweep could not tie to MusicBrainz (server/music/library.py,
# the Music app's Library tab), from a shell and for the agent.
music_library() {
  local sub=${1:-list} folder=${2:-} release=${3:-}
  case $sub in
    list)
      music_api GET /api/library/sweep
      show "$OUT" '"sweep: " + (.counts | to_entries | map("\(.key) \(.value)") | join(", ")) + " · \(.albums) albums · \(.decide | length) to decide" +
        (if .paused then " · paused" else "" end) + "\n" + (.decide | map("\(.state | .[0:9] | . + (" " * (9 - length)))  \(.folder)\n      \(.why | .[0:150])" + (if (.candidates | length) > 0 then "  (\(.candidates | length) candidates)" else "" end)) | join("\n"))' ;;
    show)
      [[ -n $folder ]] || usage_error "music library show \"<Artist/Album>\""
      music_api GET /api/library/sweep
      OUT=$(jq -c --arg f "$folder" '.decide[] | select(.folder == $f)' <<<"$OUT")
      [[ -n $OUT ]] || die 1 "$folder is not among the library albums waiting for a decision (barch music library)"
      show "$OUT" '"\(.folder)  [\(.state)]\n\(.why)\n\ncandidates:\n" + ((.candidates // []) | map("  \(.mbid)  \(.artist) – \(.title)  \(.date) \(.country)  \(.tracks) tracks  score \(.score)" + (if .ok then "  fits" else "" end) + "\n      " + (.why | join("; "))) | join("\n")) +
        "\n\nfiles:\n" + ((.tracks // []) | map("  \(.disc).\(.index | tostring | if length < 2 then "0" + . else . end)  \((.seconds / 60 | floor) | tostring):\((.seconds % 60 | floor) | tostring | if length < 2 then "0" + . else . end)  \(.title)") | join("\n"))' ;;
    compare)
      [[ -n $folder && -n $release ]] || usage_error "music library compare \"<Artist/Album>\" <release mbid or URL>"
      music_api GET "/api/library/compare?folder=$(jq -rn --arg v "$folder" '$v | @uri')&release=$(jq -rn --arg v "$release" '$v | @uri')"
      show "$OUT" '"release \(.mbid): \(.artist // "") – \(.title // "") · \(.date // "") \(.country // "") · MusicBrainz discs \(.media | map(.tracks) | join(" + ")) vs files \(.ours | join(" + "))" +
        (if .split then " (the files follow the discs in one list)" else "" end) + " · worst \(.worst)s, mean \(.mean)s off" +
        (if (.reorder // [] | map(select(.moves)) | length) > 0 then "\n  the same songs in another order; barch music library reorder moves " + (.reorder | map(select(.moves)) | map("\(.disc).\(.index | tostring | if length < 2 then "0" + . else . end)→\(.to_disc).\(.to_pos | tostring | if length < 2 then "0" + . else . end) (\(.title))") | join(", ")) else "" end) + "\n" +
        ((.rows // []) | map("  \(.disc).\(.pos | tostring | if length < 2 then "0" + . else . end)  file \(.file)  \(.title)  \(.seconds)s  ↔  \(.mb_title)  \(.mb_seconds)s  Δ\(.diff)s" + (if (.diff // 0) > 10 then "  ✗" else "" end)) | join("\n"))' ;;
    tag|reorder)
      [[ -n $folder && -n $release ]] || usage_error "music library $sub \"<Artist/Album>\" <release mbid or URL>"
      music_api POST "/api/library/$sub" "$(jq -cn --arg f "$folder" --arg r "$release" '{folder: $f, release: $r}')"
      show "$OUT" '.result' ;;
    delete)
      [[ -n $folder ]] || usage_error "music library delete \"<Artist/Album>\" [<release mbid or URL>]"
      music_api POST /api/library/delete "$(jq -cn --arg f "$folder" --arg r "$release" '{folder: $f, release: $r}')"
      show "$OUT" '.result' ;;
    skip|retry)
      [[ -n $folder ]] || usage_error "music library $sub \"<Artist/Album>\""
      music_api POST "/api/library/$sub" "$(jq -cn --arg f "$folder" '{folder: $f}')"
      show "$OUT" '.result' ;;
    fix) music_library_fix "$folder" "${3:-}" ;;
    *) usage_error "music library [list|show|compare|tag|reorder|delete|skip|retry|fix] ..." ;;
  esac
}

# music artists: the artist folders of /music tied to Lidarr's MusicBrainz artists (server/music/barch_music/artists.py)
music_artists() {
  local sub=${1:-list} arg=${2:-} mbid=${3:-}
  case $sub in
    list|all)
      music_api GET /api/artists
      [[ $sub == all ]] || OUT=$(jq -c '.artists |= map(select(.state | IN("linked", "no-folder") | not))' <<<"$OUT")
      show "$OUT" '"artists: " + (.counts | to_entries | map("\(.key) \(.value)") | join(", ")) + "\n" +
        (.artists |
         map("\(.state | . + (" " * (9 - length)))  \(if .folder != "" then .folder else .lidarr.name end)" +
             (if .lidarr then "  [Lidarr \(.lidarr.id): \(.lidarr.name) \(.lidarr.mbid)]" else "" end) + "\n      \(.why)") | join("\n"))' ;;
    show|find)
      [[ -n $arg ]] || usage_error "music artists $sub \"<$([[ $sub == show ]] && echo folder || echo name)>\""
      music_api GET "/api/artists/candidates?$([[ $sub == show ]] && echo folder || echo q)=$(jq -rn --arg v "$arg" '$v | @uri')"
      show "$OUT" '"\(.query)" + (if .tied > 0 then " · \(.tied) tied album(s) looked at" else "" end) + "\n" +
        (.candidates | map("  \(.mbid)  \(.name)" + (if .disambiguation != "" then " (\(.disambiguation))" else "" end) +
          "  \([.type, .country, .years] | map(select(. != "")) | join(" · "))" +
          (if .releases > 0 then "  credited on \(.releases) of your albums" else "" end) +
          (if .lidarr then "  [Lidarr: \(.lidarr.path), \(.lidarr.files) files]" else "" end)) | join("\n"))' ;;
    link)
      [[ -n $arg && -n $mbid ]] || usage_error "music artists link \"<folder>\" <artist mbid or URL>"
      music_api POST /api/artists/link "$(jq -cn --arg f "$arg" --arg m "$mbid" '{folder: $f, mbid: $m}')"
      show "$OUT" '.result' ;;
    add)
      [[ -n $arg ]] || usage_error "music artists add <artist mbid or URL>"
      music_api POST /api/artists/add "$(jq -cn --arg m "$arg" '{mbid: $m}')"
      show "$OUT" '.result' ;;
    remove)
      [[ $arg =~ ^[0-9]+$ ]] || usage_error "music artists remove <lidarr artist id>"
      music_api POST /api/artists/remove "$(jq -cn --argjson i "$arg" '{id: $i}')"
      show "$OUT" '.result' ;;
    skip|unskip)
      [[ -n $arg ]] || usage_error "music artists $sub \"<folder>\""
      music_api POST "/api/artists/$sub" "$(jq -cn --arg f "$arg" '{folder: $f}')"
      show "$OUT" '.result' ;;
    move)
      [[ -n $arg && -n $mbid ]] || usage_error "music artists move \"<folder>\" \"<into folder>\" [--replace]"
      music_api POST /api/artists/move "$(jq -cn --arg f "$arg" --arg i "$mbid" --argjson r "$([[ ${4:-} == --replace ]] && echo true || echo false)" '{folder: $f, into: $i, replace: $r}')"
      show "$OUT" '.result' ;;
    *) usage_error "music artists [list|all|show|find|link|add|remove|move|skip|unskip] ..." ;;
  esac
}

# music library fix "<Artist/Album>" ["hint"]: Claude ties one library album to MusicBrainz (library-fix.md):
# the entry (why, candidates, the files' lengths and titles) as context, compare/tag as tools.
music_library_fix() {
  local folder=${1:-} hint=${2:-}
  [[ -n $folder ]] || usage_error "music library fix \"<Artist/Album>\" [\"hint\"]"
  need claude
  music_api GET /api/library/sweep
  local entry run
  entry=$(jq -c --arg f "$folder" '.decide[] | select(.folder == $f)' <<<"$OUT")
  [[ -n $entry ]] || die 1 "$folder is not among the library albums waiting for a decision (barch music library)"
  run=$STATE/music-agent/library-$(tr -c 'A-Za-z0-9' '-' <<<"$folder" | cut -c1-60)-$(date +%Y%m%d-%H%M%S)
  mkdir -p "$run"
  {
    echo "# Context"
    echo
    echo "- Album folder: \`$folder\` (use exactly this, quoted, with barch music library show / compare / tag)"
    jq -r '"- Artist folder: \(.folder | split("/")[0]) · album folder: \(.folder | split("/")[1])\n- Files: \(.tracks | length) on \(.tracks | map(.disc) | unique | length) disc(s), \((.tracks | map(.seconds) | add) / 60 | floor) min in all"' <<<"$entry"
    echo "- The files on this machine (read only; ffprobe reads their tags, Read looks at a cover): /mnt/nasfrutuozo/media/music/$folder/"
    echo "- Run folder (write here only): $run"
    if [[ -n $hint ]]; then echo; echo "## Bruno's hint"; echo; echo "$hint"; fi
    echo
    echo "## The entry, as barch music library show prints it"
    echo
    echo '```'
    "$0" music library show "$folder" 2>/dev/null || jq . <<<"$entry"
    echo '```'
    echo
    echo "## The entry as JSON"
    echo
    echo '```json'
    jq . <<<"$entry"
    echo '```'
  } >"$run/context.md"
  { cat "$REPO/quickshell/.config/quickshell/music/library-fix.md"; echo; cat "$run/context.md"; } >"$run/prompt.md"
  # show, compare, tag and reorder only: delete and skip are Bruno's decisions (library-fix.md says so too)
  MUSIC_CLAUDE_TIMEOUT=${MUSIC_CLAUDE_TIMEOUT:-25m} music_claude_run "$run" "library fix $folder" \
    "barch music library show" "barch music library compare" "barch music library tag" "barch music library reorder"
  OUT=$(jq -c --arg f "$folder" --arg run "$run" '{ok: true, folder: $f, run: $run, summary: .structured_output.summary,
    tagged: .structured_output.proposed, session: .session_id, cost: .total_cost_usd}' "$run/result.json")
  show "$OUT" '.summary'
}

# music agent-sweep [library|review|all] [--parallel N] [--limit N]: Claude over everything waiting for a
# decision, as a detached user unit (survives the terminal): `music library fix` on every Library tab
# album, `music fix` on every review job. One log of JSON lines per sweep in
# ~/.local/state/barch/music-agent/sweep-<stamp>/; stops by itself when the Claude plan's week passes 90 %
# (barch claude) or when `agent-sweep stop` touches its stop file. `status` reads the latest sweep.
music_agent_sweep() {
  local kind=all parallel=2 limit=0 sweeps=$STATE/music-agent dir
  case ${1:-} in
    status|stop)
      dir=$(ls -d "$sweeps"/sweep-* 2>/dev/null | sort | tail -1)
      [[ -n $dir ]] || die 1 "no sweep yet"
      if [[ $1 == stop ]]; then
        touch "$dir/stop"
        systemctl --user stop "barch-music-sweep-$(basename "$dir" | cut -d- -f2-)" 2>/dev/null || true
        echo "sweep stopped: $dir"; return
      fi
      local unit state
      unit="barch-music-sweep-$(basename "$dir" | cut -d- -f2-)"
      state=$(systemctl --user is-active "$unit" 2>/dev/null || true)
      OUT=$(jq -sc --arg dir "$dir" --arg state "$state" --arg total "$(wc -l <"$dir/items" 2>/dev/null || echo 0)" '{dir: $dir, unit_state: $state, planned: ($total | tonumber), done: length,
        ok: map(select(.ok)) | length, tagged_or_fixed: map(select(.proposed)) | length, failed: map(select(.ok | not)) | length,
        cost: (map(.cost // 0) | add // 0), seconds: (map(.seconds // 0) | add // 0), last: (.[-3:] | map({item, proposed, summary: (.summary | .[0:160])}))}' "$dir/log.jsonl" 2>/dev/null || echo '{}')
      show "$OUT" '"\(.dir)\nunit \(.unit_state) · \(.done)/\(.planned) done · \(.tagged_or_fixed) tagged or delivered · \(.failed) failed · US$ \(.cost * 100 | round / 100) · \(.seconds / 60 | floor) min\n" + (.last | map("  \(if .proposed then "✓" else "·" end) \(.item): \(.summary)") | join("\n"))'
      return ;;
  esac
  while (($#)); do
    case $1 in
      library|review|all) kind=$1 ;;
      --parallel) parallel=${2:-2}; shift ;;
      --limit) limit=${2:-0}; shift ;;
      *) usage_error "music agent-sweep [library|review|all] [--parallel N] [--limit N] · status · stop" ;;
    esac
    shift
  done
  need claude; need systemd-run
  dir=$sweeps/sweep-$(date +%Y%m%d-%H%M%S)
  mkdir -p "$dir"
  {
    if [[ $kind != review ]]; then
      music_api GET /api/library/sweep
      jq -r '.decide[] | "library\t" + .folder' <<<"$OUT"
    fi
    if [[ $kind != library ]]; then
      music_api GET "/api/jobs?state=review"
      jq -r '.jobs[] | select(.state == "review") | "review\t" + .id' <<<"$OUT"
    fi
  } | { if ((limit > 0)); then head -n "$limit"; else cat; fi; } >"$dir/items"
  local n; n=$(wc -l <"$dir/items")
  ((n > 0)) || die 1 "nothing waiting for a decision"
  systemd-run --user --quiet --collect --unit="barch-music-sweep-$(basename "$dir" | cut -d- -f2-)" \
    --property=WorkingDirectory="$HOME/BArch" -E HOME="$HOME" -E PATH="$PATH" -E MUSIC_CLAUDE_MODEL="${MUSIC_CLAUDE_MODEL:-sonnet}" \
    "$0" music agent-sweep-run "$dir" "$parallel"
  echo "sweep started: $n item(s) with $parallel at a time, log in $dir/log.jsonl (barch music agent-sweep status|stop)"
}

# the sweep's worker: items, N at a time, one JSON line each; stops at 90 % of the Claude week or on the stop file
music_agent_sweep_run() {
  local dir=$1 parallel=${2:-2}
  export SWEEP_DIR=$dir
  xargs -P "$parallel" -d '\n' -I{} "$0" music agent-sweep-item "$dir" "{}" <"$dir/items"
  local seen ok prop cost
  seen=$(wc -l <"$dir/log.jsonl" 2>/dev/null || echo 0)
  prop=$(jq -s 'map(select(.proposed)) | length' "$dir/log.jsonl" 2>/dev/null || echo 0)
  cost=$(jq -s 'map(.cost // 0) | add // 0 | . * 100 | round / 100' "$dir/log.jsonl" 2>/dev/null || echo 0)
  ok=$( [[ -e $dir/stop ]] && echo " (stopped early)" || true)
  "$0" notify "Music agent sweep" "$seen album(s) looked at$ok, $prop tagged or delivered, US\$ $cost · barch music agent-sweep status" --app "BArch music" \
    --action "Library=barch music browse library" --action "Review=barch music browse review" >/dev/null 2>&1 || true
}
music_agent_sweep_item() {
  local dir=$1 line=$2 kind item t0 rc=0 res pct
  kind=${line%%$'\t'*}; item=${line#*$'\t'}
  [[ -e $dir/stop ]] && return 0
  pct=$("$0" --json claude 2>/dev/null | jq -r '[.limits[] | select(.kind == "weekly_all" or .kind == "weekly_scoped") | .percent] | max // 0')
  if [[ -n $pct && $pct -ge 90 ]]; then
    touch "$dir/stop"
    jq -cn --arg item "$item" --arg kind "$kind" --argjson pct "$pct" '{kind: $kind, item: $item, ok: false, proposed: false, summary: "stopped: the Claude week is at \($pct) %", cost: 0, seconds: 0}' >>"$dir/log.jsonl"
    return 0
  fi
  t0=$(date +%s)
  if [[ $kind == library ]]; then
    res=$("$0" --json music library fix "$item" 2>"$dir/err-$(tr -c 'A-Za-z0-9' '-' <<<"$item" | cut -c1-60).log") || rc=$?
  else
    res=$("$0" --json music fix "$item" 2>"$dir/err-$item.log") || rc=$?
  fi
  if ((rc == 0)) && jq -e . >/dev/null 2>&1 <<<"$res"; then
    jq -c --arg kind "$kind" --arg item "$item" --argjson s "$(( $(date +%s) - t0 ))" '{kind: $kind, item: $item, ok: true, proposed: (.tagged // .fixed // false), summary, cost: (.cost // 0), seconds: $s, run}' <<<"$res" >>"$dir/log.jsonl"
  else
    jq -cn --arg kind "$kind" --arg item "$item" --argjson s "$(( $(date +%s) - t0 ))" --arg e "$(tail -c 300 "$dir/err-"*"$(tr -c 'A-Za-z0-9' '-' <<<"$item" | cut -c1-60)"*.log 2>/dev/null | tail -2 | tr '\n' ' ')" \
      '{kind: $kind, item: $item, ok: false, proposed: false, summary: ("failed: " + $e), cost: 0, seconds: $s}' >>"$dir/log.jsonl"
  fi
  return 0
}

cmd_music() {
  local sub=${1:-status}
  (($#)) && shift
  need curl; need jq
  case $sub in
    browse) app_open music BARCH_MUSIC_PAGE "${1:-}" ;;
    status)
      music_api GET /api/status
      show "$OUT" '"music pipeline: " + ((.counts | to_entries | map(select(.value > 0) | "\(.value) \(.key)") | join(", ")) | if . == "" then "idle, nothing queued" else . end) + (if .running != "" then " · working on \(.running)" else "" end) + (if ((.missing // []) | length) > 0 then "\nMISSING in the container: " + (.missing | join(", ")) + " (custom-cont-init.d not run?)" else "" end)' ;;
    list)
      music_api GET "/api/jobs?state=${1:-review}"
      show "$OUT" '.jobs[] | "\(.id)  \(.state)\t\(.name)\(if .folder then "  →  " + .folder else "" end)\(if (.problems|length) > 0 then "\n      " + (.problems | join("\n      ")) else "" end)"' ;;
    show)
      [[ -n ${1:-} ]] || usage_error "music show <id>"
      music_api GET "/api/jobs/$1"
      show "$OUT" '.job | "\(.id)  \(.state)  \(.name)\nsource: \(.source)"
        + (if (.problems|length) > 0 then "\nproblems:\n  " + (.problems | join("\n  ")) else "" end)
        + (if (.notes|length) > 0 then "\nnotes:\n  " + (.notes | join("\n  ")) else "" end)
        + (if (.candidates|length) > 0 then "\ncandidates:\n" + (.candidates | map("  \(if .ok then "✓" else " " end) \(.score)  \(.artist) - \(.title)  \(.date) \(.country)  \(.tracks) tracks  \(.url)\n      \(.why | join("; "))") | join("\n")) else "" end)
        + (if .merge then "\nmerge into the library:\n" + ((.merge.add | map("  + " + .)) + (.merge.fix | map("  ~ " + .file + (if .rename != "" then " → " + .rename else "" end) + (if (.set|length) > 0 then "  " + (.set | to_entries | map("\(.key)=\(.value)") | join(", ")) else "" end) + (if (.drop|length) > 0 then "  −" + (.drop | join(" −")) else "" end) + (if .cover then "  +cover" else "" end))) + (.merge.review | map("  ! " + .)) | join("\n")) else "" end)
        + (if .result.merged then "\nmerged:\n  " + (.result.merged | join("\n  ")) else "" end)
        + (if .proposal then "\nproposal: \(.proposal.folder)  (\(.proposal.date), \(.proposal.genre))\n" + (.proposal.tracks | map("  " + .file) | join("\n")) else "" end)' ;;
    retry | reject | undo)
      [[ -n ${1:-} ]] || usage_error "music $sub <id> [--delete]"
      local del=false
      [[ $sub == reject && ${2:-} == --delete ]] && del=true    # the torrent / inbox folder goes once every album of it is settled
      music_api POST "/api/jobs/$1" "$(jq -cn --arg a "$sub" --argjson d "$del" '{action: $a} + (if $d then {delete: true} else {} end)')"
      show "$OUT" '"\(.job.id): \(.job.state)"' ;;
    cover)                                           # the cover found by hand, then the album runs with it
      [[ -n ${1:-} && -n ${2:-} ]] || usage_error "music cover <id> <file|URL> [label]"
      if [[ -f $2 ]]; then music_upload_job "$1" "$2"
      else music_api POST "/api/jobs/$1/cover" "$(jq -cn --arg u "$2" --arg l "${3:-}" '{url: $u, label: $l}')"; fi
      echo "$(jq -r .result <<<"$OUT")"
      music_api POST "/api/jobs/$1" '{"action": "resolve"}'
      show "$OUT" '"\(.job.id): \(.job.state) (queued again)"' ;;
    cover-ask) music_cover_ask_job "$@" ;;
    retitle)                                         # the ALBUM tag and the folder of an album already in /music
      [[ -n ${1:-} && -n ${2:-} ]] || usage_error "music retitle <Artist/Album> <new title>"
      music_api POST /api/library/retitle "$(jq -cn --arg f "$1" --arg a "$2" '{folder: $f, album: $a}')"
      show "$OUT" '.result' ;;
    mb-add) music_mb_add "$@" ;;
    rescan)                                          # the download taken in again from scratch (its old jobs superseded)
      [[ -n ${1:-} ]] || usage_error "music rescan <id>"
      music_api POST "/api/jobs/$1/rescan" '{}'
      show "$OUT" '.result + ": " + (.jobs | map(.id + "  " + .name) | join(", "))' ;;
    fix) music_fix_job "$@" ;;
    library) music_library "$@" ;;
    artists) music_artists "$@" ;;
    agent-sweep) music_agent_sweep "$@" ;;
    agent-sweep-run) music_agent_sweep_run "$@" ;;
    agent-sweep-item) music_agent_sweep_item "$@" ;;
    accept-year)                                     # the 29 "only the year exists" albums in one go (2026-11-08)
      local dry=0 days=0 ids
      while (($#)); do
        case $1 in
          --dry-run) dry=1 ;;
          --older-than) [[ ${2:-} =~ ^[0-9]+$ ]] || usage_error "music accept-year --older-than DAYS"; days=$2; shift ;;
          *) usage_error "music accept-year [--dry-run] [--older-than DAYS]" ;;
        esac
        shift
      done
      music_api GET "/api/jobs?state=review"
      ids=$(jq -r --argjson before "$(( $(date +%s) - days * 86400 ))" '.jobs[]
        | select(.state == "review" and (.problems | length) == 1 and (.problems[0] | test("^no full original release date")))
        | select((.updated // .created // 0) <= $before) | "\(.id)\t\(.name)"' <<<"$OUT")
      if [[ -z $ids ]]; then show '{"ok": true, "count": 0, "albums": []}' '"no album waits only on a year-only date"'; return 0; fi
      if ((dry)); then
        show "$(jq -Rn '[inputs | split("\t") | {id: .[0], name: .[1]}] | {ok: true, dry_run: true, count: length, albums: .}' <<<"$ids")" \
          '"\(.count) album(s) would get the year as YYYY-01-01:\n" + (.albums | map("  \(.id)  \(.name)") | join("\n"))'
        return 0
      fi
      local done=() id name
      while IFS=$'\t' read -r id name; do
        music_api POST "/api/jobs/$id" '{"action": "resolve", "overrides": {"date_year_only": true}}'
        done+=("$id")
        [[ $JSON == 1 ]] || echo "$id  $name: $(jq -r .job.state <<<"$OUT") (queued again)"
      done <<<"$ids"
      show "$(jq -n --argjson n "${#done[@]}" --argjson ids "$(printf '%s\n' "${done[@]}" | jq -R . | jq -s .)" '{ok: true, count: $n, resolved: $ids}')" \
        '"\(.count) album(s) queued again with the year as YYYY-01-01"' ;;
    resolve)
      [[ -n ${1:-} ]] || usage_error "music resolve <id> [--release ..] [--cover URL|file] [--date ..] [--genre ..] [--album ..] [--artist ..] [--title D.TT=..] [--replace]"
      local id=$1 body='{"action": "resolve"}'
      shift
      while (($#)); do
        case $1 in
          --release) body=$(jq --arg v "$2" '.release = $v' <<<"$body"); shift ;;
          --cover)                                   # a URL goes with the decision; a file is uploaded first
            if [[ -f $2 ]]; then music_upload_job "$id" "$2"; echo "$(jq -r .result <<<"$OUT")"
            else body=$(jq --arg v "$2" '.cover = $v' <<<"$body"); fi
            shift ;;
          --date|--genre|--album) body=$(jq --arg k "${1#--}" --arg v "$2" '.overrides[$k] = $v' <<<"$body"); shift ;;
          --artist) body=$(jq --arg v "$2" '.overrides.artist_folder = $v' <<<"$body"); shift ;;
          --title) [[ $2 == *=* ]] || usage_error "--title D.TT=Title (e.g. 1.03=Song)"
            body=$(jq --arg k "${2%%=*}" --arg v "${2#*=}" '.overrides.tracks[$k].TITLE = $v' <<<"$body"); shift ;;
          --replace) body=$(jq '.replace = true' <<<"$body") ;;
          --date-year-only) body=$(jq '.overrides.date_year_only = true' <<<"$body") ;;
          --keep-order) body=$(jq '.keep_order = true' <<<"$body") ;;
          --replace-tracks) body=$(jq --arg v "$2" '.replace_tracks = ($v | split(","))' <<<"$body"); shift ;;
          *) usage_error "music resolve: unknown option $1" ;;
        esac
        shift
      done
      music_api POST "/api/jobs/$id" "$body"
      show "$OUT" '"\(.job.id): \(.job.state) (queued again)"' ;;
    covers)
      local act=${1:-list}
      (($#)) && shift
      case $act in
        list)
          music_api GET /api/covers
          show "$OUT" '(if .running != "" then "checking \(.running) (\(.queued) more)\n" else "" end) + (.entries | map("\(.verdict)\t\(.folder)" + (if .proposal then "  ←  \(.proposal.source) \(.proposal.w)x\(.proposal.h)" else "" end) + (if .applied then "  (applied)" else "" end) + (if .error then "  " + .error else "" end)) | join("\n"))' ;;
        check)
          music_api POST /api/covers/check "$(jq -cn --arg a "${1:-}" '{artist: $a}')"
          show "$OUT" '.result' ;;
        pick)
          [[ -n ${1:-} && ${2:-} =~ ^[0-9]+$ ]] || usage_error "music covers pick <Artist/Album> <n>"
          music_api POST /api/covers/pick "$(jq -cn --arg f "$1" --argjson n "$2" '{folder: $f, alt: $n}')"
          show "$OUT" '.result' ;;
        propose)
          [[ -n ${1:-} && -n ${2:-} ]] || usage_error "music covers propose <Artist/Album> <file|URL> [label]"
          if [[ -f $2 ]]; then music_upload "$1" "$2" "${3:-$(basename "$2")}"
          else music_api POST /api/covers/propose "$(jq -cn --arg f "$1" --arg u "$2" --arg l "${3:-}" '{folder: $f, url: $u, label: $l}')"; fi
          show "$OUT" '.result' ;;
        ask) music_covers_ask "$@" ;;
        apply | undo | keep)
          [[ -n ${1:-} ]] || usage_error "music covers $act <Artist/Album>"
          music_api POST "/api/covers/$act" "$(jq -cn --arg f "$1" '{folder: $f}')"
          show "$OUT" '.result' ;;
        *) usage_error "music covers list|check [artist]|apply|undo|keep|pick|propose|ask <Artist/Album> ..." ;;
      esac ;;
    restart)
      music_api POST /api/restart '{}'
      show "$OUT" '"music pipeline: restarting"' ;;
    scan)
      music_api POST /api/scan '{}'
      show "$OUT" '"music pipeline: \(.new) new album(s) queued"' ;;
    lidarr-flac-only)
      music_api POST /api/lidarr/flac-only '{}'
      show "$OUT" '.result' ;;
    lidarr-monitor | lidarr-search)
      [[ -n ${1:-} ]] || usage_error "music $sub <album ids, comma separated> [on|off]"
      local ids body
      ids=$(jq -cn --arg v "$1" '$v | split(",") | map(tonumber)')
      if [[ $sub == lidarr-monitor ]]; then
        body=$(jq -cn --argjson ids "$ids" --arg m "${2:-on}" '{ids: $ids, monitored: ($m == "on")}')
        music_api POST /api/lidarr/monitor "$body"
      else
        music_api POST /api/lidarr/search "{\"ids\": $ids}"
      fi
      show "$OUT" '.result' ;;
    lidarr-artists)
      music_api GET "/api/lidarr/artists?q=$(jq -rn --arg v "${1:-}" '$v | @uri')"
      show "$OUT" '.artists[] | "\(.id)\t\(.name)  \(.albums) albums, \(.files)/\(.tracks) tracks\(if .monitored then "" else "  (unmonitored)" end)"' ;;
    lidarr-artist-set)
      [[ -n ${1:-} ]] || usage_error "music lidarr-artist-set all|<artist ids> [--monitored on|off] [--new-albums all|none|new]"
      local body ids
      if [[ $1 == all ]]; then ids='"all"'; else ids=$(jq -cn --arg v "$1" '$v | split(",") | map(tonumber)'); fi
      shift
      body=$(jq -cn --argjson ids "$ids" '{ids: $ids}')
      while [[ $# -gt 0 ]]; do
        case $1 in
          --monitored) body=$(jq -c --arg m "${2:-on}" '.monitored = ($m == "on")' <<<"$body"); shift 2 ;;
          --new-albums) body=$(jq -c --arg m "${2:-}" '.monitor_new_items = $m' <<<"$body"); shift 2 ;;
          *) usage_error "music lidarr-artist-set: unknown option $1" ;;
        esac
      done
      music_api POST /api/lidarr/artists "$body"
      show "$OUT" '.result' ;;
    lidarr-commands)
      music_api GET /api/lidarr/commands
      show "$OUT" '.commands[] | "\(.id)\t\(.name) \(.status)  \(.started[0:19])  artist \(.artist_id // "-")  albums \(.albums)  (\(.trigger))"' ;;
    lidarr-enforce)
      MUSIC_API_TIMEOUT=900 music_api POST /api/lidarr/enforce '{}'
      show "$OUT" '.result' ;;
    adopt)
      [[ -n ${1:-} && -n ${2:-} ]] || usage_error "music adopt \"<Artist/Album>\" <MusicBrainz release id or URL>"
      music_api POST /api/library/adopt "$(jq -cn --arg f "$1" --arg r "$2" '{folder: $f, release: $r}')"
      show "$OUT" '.result' ;;
    lidarr-add)
      [[ -n ${1:-} && -n ${2:-} ]] || usage_error "music lidarr-add <MusicBrainz artist id> <artist folder in /music>"
      music_api POST /api/lidarr/add-artists "$(jq -cn --arg m "$1" --arg f "$2" '{artists: [{mbid: $m, folder: $f}]}')"
      show "$OUT" '.result' ;;
    lidarr-cancel)
      [[ -n ${1:-} ]] || usage_error "music lidarr-cancel <command id>"
      music_api POST /api/lidarr/command-cancel "{\"id\": $1}"
      show "$OUT" '.result' ;;
    lidarr-queue)
      music_api GET /api/lidarr/queue
      show "$OUT" '.queue[] | "\(.id)\t\(.artist) - \(.album)  \(.status)/\(.state)  \(.left_gb)/\(.size_gb) GB  \(.title)"' ;;
    lidarr-queue-remove)
      [[ -n ${1:-} ]] || usage_error "music lidarr-queue-remove <queue ids, comma separated>|all [--keep]   (--keep leaves the download in the client)"
      local ids body keep=false
      [[ ${2:-} == --keep ]] && keep=true
      if [[ $1 == all ]]; then
        music_api GET /api/lidarr/queue
        ids=$(jq -c '[.queue[].id]' <<<"$OUT")
      else
        ids=$(jq -cn --arg v "$1" '$v | split(",") | map(tonumber)')
      fi
      body=$(jq -cn --argjson ids "$ids" --argjson k "$keep" '{ids: $ids, blocklist: true, from_client: ($k | not)}')
      music_api POST /api/lidarr/queue-remove "$body"
      show "$OUT" '.result' ;;
    lidarr-albums)
      [[ -n ${1:-} ]] || usage_error "music lidarr-albums <artist name or id>"
      music_api GET "/api/lidarr/albums?artist=$(jq -rn --arg v "$1" '$v | @uri')"
      show "$OUT" '.albums[] | "\(.id)\t\(.date)  \(.title)  [\(.type)\(if (.secondary|length) > 0 then ", " + (.secondary|join(", ")) else "" end)]  \(.files)/\(.tracks)\(if .monitored then "  monitored" else "" end)\(if .canon == null then "" elif .canon == "" then "  · unofficial" else "  · " + .canon end)"' ;;
    seeds)
      if [[ ${1:-} == check ]]; then
        music_api POST /api/seeds/check '{}'
        show "$OUT" '.result'
        return
      fi
      local days="" live=""
      for a in "$@"; do
        case $a in --live) live=1 ;; *) days=$a ;; esac
      done
      music_api GET "/api/seeds?days=${days:-0}${live:+&live=1}"
      show "$OUT" 'def gb: (. / 1e9 * 100 | round / 100 | tostring) + " GB";
        def hrs: (. / 3600 | floor | tostring) + " h";
        def line: "\(.torrents) torrents  up \(.uploaded|gb)  down \(.downloaded|gb)  ratio \(.ratio)  seed avg \(.avg_seeding_time|hrs)  below 1: \(.below_1)";
        "policy: delete at ratio \(.policy.ratio) after \(.policy.min_hours) h, or \(.policy.max_days) days after finishing; keep \(.policy.min_free_gb) GB free",
        "seeding for the pipeline: \(.seeding // [] | length)",
        (.seeding // [] | .[:20][] | "  ratio \(.ratio)/\(.goal)  up \(.uploaded|gb)  \(.seeding_time|hrs)  \(if .days_left != null then "\(.days_left) d left" else "" end)  \(.trackers|join(","))  \(.name)"),
        "removed from qBittorrent\(if .days > 0 then " (last \(.days) days)" else "" end): " + (.total|line),
        (.trackers[] | "  \(.tracker): " + line),
        (if (.recent|length) > 0 then "latest:" else empty end),
        (.recent[:15][] | "  \(.removed|strftime("%Y-%m-%d"))  \(.reason)\t\(.uploaded|gb) / \(.downloaded|gb)  ratio \(.ratio)  \(.seeding_time|hrs)  \(.trackers|join(","))  \(.name)"),
        (if .live then "still in qBittorrent: " + (.live.total|line), (.live.torrents[:15][] | "  \(.uploaded|gb) / \(.downloaded|gb)  ratio \(.ratio)  \(.seeding_time|hrs)  \(.trackers|join(","))  \(.name)") else empty end)' ;;
    digest)
      music_api GET "/api/digest${1:+?days=$1}"
      show "$OUT" '.text' ;;
    lidarr-pending)
      music_api GET /api/lidarr/pending
      show "$OUT" '.pending[] | "\(.folder)\t\(.mbid)  waiting since \(.since | strftime("%Y-%m-%d"))"' ;;
    lidarr-stalled)
      music_api GET "/api/lidarr/stalled${1:+?hours=$1}"
      show "$OUT" '"stalled for more than \(.hours) h (the hourly check replaces them):", (.stalled[] | "\(.id)\t\(.title)  \(.state) \(.progress)%  quiet \(.quiet_h) h")' ;;
    lidarr-release-profiles)
      music_api GET /api/lidarr/release-profiles
      show "$OUT" '.profiles[] | "\(.id)\t\(if .enabled then "on " else "off" end)  ignored: \(.ignored | join("  ·  "))\(if (.required|length) > 0 then "  required: " + (.required | join(", ")) else "" end)"' ;;
    lidarr-profiles)
      music_api GET /api/lidarr/metadata-profiles
      show "$OUT" '.profiles[] | "\(.id)\t\(.name): \(.primary|join(", ")) | \(.secondary|join(", ")) | \(.statuses|join(", "))"' ;;
    lidarr-profile)
      [[ -n ${1:-} ]] || usage_error "music lidarr-profile <name> [--primary A,B] [--secondary A,B] [--statuses A,B] [--apply all|ids]"
      local body
      body=$(jq -cn --arg n "$1" '{name: $n, primary: [], secondary: [], statuses: ["Official"]}')
      shift
      while (($#)); do
        case $1 in
          --primary|--secondary|--statuses) body=$(jq -c --arg k "${1#--}" --arg v "$2" '.[$k] = ($v | split(","))' <<<"$body"); shift ;;
          --apply) if [[ $2 == all ]]; then body=$(jq -c '.apply_to = "all"' <<<"$body")
                   else body=$(jq -c --arg v "$2" '.apply_to = ($v | split(",") | map(tonumber))' <<<"$body"); fi; shift ;;
          *) usage_error "music lidarr-profile: unknown option $1" ;;
        esac
        shift
      done
      music_api POST /api/lidarr/metadata-profile "$body"
      show "$OUT" '.result' ;;
    lidarr-lists)
      music_api GET /api/lidarr/import-lists
      show "$OUT" '.lists[] | "\(.id)\t\(.name) (\(.type))\(if .enabled then "" else "  disabled" end)  monitor: \(.monitor)  \(.fields | to_entries | map("\(.key)=\(.value)") | join(" "))"' ;;
    lidarr-list)
      [[ -n ${2:-} ]] || usage_error "music lidarr-list <Type> <name> [field=value ...] [--monitor none|specificAlbum|entireArtist] [--search]"
      local body
      body=$(jq -cn --arg t "$1" --arg n "$2" '{type: $t, name: $n, fields: {}, monitor: "specificAlbum"}')
      shift 2
      while (($#)); do
        case $1 in
          --monitor) body=$(jq -c --arg v "$2" '.monitor = $v' <<<"$body"); shift ;;
          --search) body=$(jq -c '.search = true' <<<"$body") ;;
          --metadata-profile|--quality-profile) body=$(jq -c --arg k "$(tr - _ <<<"${1#--}")" --arg v "$2" '.[$k] = $v' <<<"$body"); shift ;;
          *=*) body=$(jq -c --arg k "${1%%=*}" --arg v "${1#*=}" '.fields[$k] = (if ($v | test("^[0-9]+$")) then ($v | tonumber) else $v end)' <<<"$body") ;;
          *) usage_error "music lidarr-list: unknown option $1" ;;
        esac
        shift
      done
      music_api POST /api/lidarr/import-list "$body"
      show "$OUT" '.result' ;;
    install) exec "$REPO/server/music/install.sh" ;;
    *) usage_error "music status|browse [page]|covers ...|restart|list [state]|show <id>|resolve <id> ...|retry|reject|undo <id>|scan|lidarr-...|install" ;;
  esac
}

# books: the book stack on the NAS (server/books) through Shelfmark's API; quickshell/books/books.py
# does the calls (it is what the Books app runs too) and answers JSON.
BOOKS_PY=$HOME/.config/quickshell/books/books.py
books_py() {
  OUT=$(python3 -I "$BOOKS_PY" "$@") || die 1 "$(jq -r '.error // "books.py failed"' <<<"$OUT" 2>/dev/null || echo "books.py failed")"
}

# books fix <request id> ["hint"]: a request no source matched by itself (a misspelt author, a subtitle
# no release carries, a book only under another title): Claude finds out what the book really is,
# searches the releases with better queries and downloads the right one, or says what is missing.
books_fix() {
  local id=${1:-} hint=${2:-} run rc=0 c
  [[ -n $id ]] || usage_error "books fix <request id> [\"hint\"]"
  need claude
  books_py request "$id"
  run=$STATE/books-agent/request-$id-$(date +%Y%m%d-%H%M%S)
  mkdir -p "$run"
  {
    echo "# Context"
    echo
    echo "- Request id: \`$id\` (use exactly this with barch books releases / fulfil / reject)"
    echo "- Run folder (write here only): $run"
    if [[ -n $hint ]]; then echo; echo "## Bruno's hint"; echo; echo "$hint"; fi
    echo
    echo "## The request"
    echo
    echo '```json'
    jq '.request | del(.book_data.description)' <<<"$OUT"
    echo '```'
  } >"$run/context.md"
  { cat "$REPO/quickshell/.config/quickshell/books/request-fix.md"; echo; cat "$run/context.md"; } >"$run/prompt.md"
  local allowed=(Read WebSearch WebFetch "Bash(barch books request *)" "Bash(barch books releases *)"
                 "Bash(barch books fulfil *)" "Bash(barch books search *)" "Bash(jq *)" "Bash(head *)" "Bash(cat *)")
  local schema='{"type":"object","properties":{"summary":{"type":"string"},"downloaded":{"type":"boolean"}},"required":["summary","downloaded"]}'
  (cd "$run" && timeout "${BOOKS_CLAUDE_TIMEOUT:-20m}" claude -p --model "${BOOKS_CLAUDE_MODEL:-sonnet}" --output-format json \
    --permission-mode dontAsk --strict-mcp-config --add-dir "$run" --json-schema "$schema" \
    --disallowedTools Edit Write NotebookEdit --allowedTools "${allowed[@]}" \
    <"$run/prompt.md" >"$run/result.json" 2>"$run/claude.log") || rc=$?
  cost_log books-agent "$(jq -r '.total_cost_usd // empty' "$run/result.json" 2>/dev/null)" "fix $id"
  jq -e '.structured_output | type == "object"' "$run/result.json" >/dev/null 2>&1 ||
    die 1 "Claude did not finish (exit $rc): see $run/claude.log"
  OUT=$(jq -c --arg id "$id" --arg run "$run" '{ok: true, id: $id, run: $run, summary: .structured_output.summary,
    downloaded: .structured_output.downloaded, session: .session_id, cost: .total_cost_usd}' "$run/result.json")
  show "$OUT" '.summary'
}

books_req_line='"#\(.id)  \(.status)\(if .delivery and .delivery != "none" then "/" + .delivery else "" end)  \(.type)\t\(.title) — \(.authors | join(", "))\(if .year then " (\(.year))" else "" end)\(if .reason != "" then "\n      " + .reason else "" end)\(if .admin_note != "" then "\n      note: " + .admin_note else "" end)"'

cmd_books() {
  local sub=${1:-status}
  (($#)) && shift
  case $sub in
    browse) app_open books BARCH_BOOKS_PAGE "${1:-}" ;;
    status)
      books_py status
      show "$OUT" '"shelfmark: " + (if .requests.error then .requests.error else "\(.requests.pending) pending of \(.requests.total) requests" end) + " · \(.active) in the queue"' ;;
    search)
      [[ -n ${1:-} ]] || usage_error "books search <query>"
      books_py search "$@"
      show "$OUT" '.books[] | "\(if .want then "★" else " " end) \(.id)\t\(.title)\(if .subtitle != "" then ": " + .subtitle else "" end) — \(.authors | join(", "))\(if .year then " (\(.year))" else "" end)\(if .owned then "  [in library]" else "" end)"' ;;
    shelf)
      books_py shelf
      show "$OUT" '.books[] | "\(.id)\t\(.title) — \(.authors | join(", "))\(if (.requests | length) > 0 then "  [" + (.requests | map("\(.type) \(.status)" + (if .delivery and .delivery != "none" then "/" + .delivery else "" end)) | join(", ")) + "]" else "  [not synced yet]" end)"' ;;
    want|unwant)
      [[ -n ${1:-} ]] || usage_error "books $sub <hardcover book id>"
      if [[ $sub == want ]]; then books_py want "$1"; else books_py want "$1" --off; fi
      show "$OUT" '"\(.id): " + (if .want then "on Want to Read" else "off Want to Read" end)' ;;
    sync)
      books_py sync
      show "$OUT" '.message' ;;
    requests|list|rejected)
      [[ $sub == rejected ]] && set -- rejected
      books_py requests "${1:-pending}"
      show "$OUT" ".requests[] | $books_req_line" ;;
    show|request)
      [[ -n ${1:-} ]] || usage_error "books show <request id>"
      books_py request "$1"
      show "$OUT" ".request | $books_req_line + (if .url != \"\" then \"\n      \" + .url else \"\" end) + (if .release then \"\n      release: \(.release.source) \(.release.title)\" else \"\" end)" ;;
    releases)
      [[ -n ${1:-} ]] || usage_error "books releases <request id> [--query Q] [--source S] [--type ebook|audiobook]"
      books_py releases "$@"
      show "$OUT" '"\(.releases | length) releases for #\(.request.id) \(.request.title) (searched: \(.searched | join(", ")))" + (if (.errors | length) > 0 then "\nerrors: \(.errors)" else "" end) + "\n" + (.releases | map("  [\(.n)] \(.source)\(if .indexer != "" then "/" + .indexer else "" end)  \(.format) \(.language) \(.size)\(if .seeders != null then " \(.seeders)s" else "" end)\t\(.title)") | join("\n"))' ;;
    fulfil|download)
      [[ -n ${1:-} ]] || usage_error "books fulfil <request id> --pick N"
      books_py fulfil "$@"
      show "$OUT" '"#\(.request.id // "?"): downloading \(.release.source) \(.release.title)"' ;;
    accept)
      [[ -n ${1:-} ]] || usage_error "books accept <request id> [--query Q] [--source S]"
      books_py accept "$@"
      show "$OUT" '"#\(.request.id // "?"): downloading \(.release.source) \(.release.format) \(.release.title) (best of \(.candidates))"' ;;
    reject|reopen|cancel)
      [[ -n ${1:-} ]] || usage_error "books $sub <request id>"
      books_py "$sub" "$@"
      show "$OUT" '"#\(.request.id): \(.request.status)"' ;;
    downloads)
      books_py downloads
      show "$OUT" '.items[] | "\(.bucket)\t\(if .progress then "\(.progress | floor) %  " else "" end)\(.title) — \(.author)  [\(.source) \(.format)]\(if .message != "" then "\n      " + .message else "" end)"' ;;
    fix) books_fix "$@" ;;
    install) exec "$REPO/server/books/install.sh" "$@" ;;
    *) usage_error "books status|browse|search|shelf|want|unwant|sync|requests|rejected|show|releases|fulfil|accept|reject|reopen|cancel|downloads|fix|install" ;;
  esac
}

# video: the pipeline runs in its own container on the NAS (server/video); this only talks to its
# API with the URL and token install.sh left in ~/.config/barch/video.json (.pipeline)
video_api() {   # video_api GET|POST <path> [json body]
  local conf="$HOME/.config/barch/video.json" url token
  if [[ ! -r $conf ]] || ! jq -e .pipeline.token "$conf" >/dev/null 2>&1; then
    die 3 "no pipeline in $conf: run barch video install first"
  fi
  url=$(jq -r .pipeline.url "$conf"); token=$(jq -r .pipeline.token "$conf")
  OUT=$(curl -sS --max-time "${VIDEO_API_TIMEOUT:-60}" -X "$1" -H "X-Barch-Token: $token" -H "Content-Type: application/json" \
    ${3:+--data "$3"} "$url$2" 2>&1) || die 3 "video pipeline not reachable at $url ($OUT)"
  jq -e . >/dev/null 2>&1 <<<"$OUT" || die 3 "video pipeline answered: ${OUT:0:200}"
  [[ $(jq -r '.ok' <<<"$OUT") == true ]] || { [[ $JSON == 1 ]] && jq . <<<"$OUT"; die 1 "$(jq -r '.error // "failed"' <<<"$OUT")"; }
}

# video fix <id> ["hint"]: Fix with Agent for a dub job (quickshell/video/job-fix.md). Claude gets the job as
# barch video show prints it, researches the Brazilian title and the releases out there, searches Prowlarr
# through the pipeline with its own queries (barch video search), adds a release it found elsewhere (barch
# video add), picks a candidate (use) or retries, and reports; the download and the mux run in the pipeline
# afterwards, so the answer says what was queued and what is left for Bruno
video_fix_job() {
  local id=${1:-} hint=${2:-}
  [[ -n $id ]] || usage_error "video fix <id> [\"hint\"]"
  need claude
  video_api GET "/api/jobs/$id"
  local job run
  job=$(jq -c .job <<<"$OUT")
  run=$STATE/video-agent/job-$id-$(date +%Y%m%d-%H%M%S)
  mkdir -p "$run"
  {
    echo "# Context"
    echo
    echo "- Job id: \`$id\` (use exactly this with barch video show / search / add / use / retry)"
    jq -r '"- Title: \(.title) (\(.year)) · original language \(.original) · IMDb \(.imdb // "?")\n- State: \(.state)\(if .reason != "" then " · " + .reason else "" end)\n- Kind: \(if .kind == "season" then "a season of a series (donor: a dubbed season pack, a range or single episodes)" else "a movie" end)\n- Audio now: \(.audio // [] | join(", "))\n- Titles the pipeline searched: \(.titles // [] | join(" · "))"' <<<"$job"
    echo "- Run folder (write here only): $run"
    if [[ -n $hint ]]; then echo; echo "## Bruno's hint"; echo; echo "$hint"; fi
    echo
    echo "## The job, as barch video show prints it"
    echo
    echo '```'
    "$0" video show "$id" 2>/dev/null || jq . <<<"$job"
    echo '```'
    echo
    echo "## The job as JSON (candidates with their guid and url, episodes, alignment, history)"
    echo
    echo '```json'
    jq '{id, kind, state, reason, title, show, year, original, imdb, file, audio, runtime, titles, failures, donor, candidates, episodes, alignment, last_search, history: (.history | .[-30:])}' <<<"$job"
    echo '```'
  } >"$run/context.md"
  { cat "$REPO/quickshell/.config/quickshell/video/job-fix.md"; echo; cat "$run/context.md"; } >"$run/prompt.md"
  MUSIC_CLAUDE_TIMEOUT=${VIDEO_CLAUDE_TIMEOUT:-30m} agent_claude_run video-agent "$run" "fix $id" "barch video show" "barch video search" "barch video add" "barch video use" "barch video retry" "barch video list"
  OUT=$(jq -c --arg id "$id" --arg run "$run" '{ok: true, id: $id, run: $run, summary: .structured_output.summary,
    fixed: .structured_output.proposed, session: .session_id, cost: .total_cost_usd}' "$run/result.json")
  show "$OUT" '.summary'
}

cmd_video() {
  local sub=${1:-status}
  (($#)) && shift
  need curl; need jq
  case $sub in
    browse) app_open video BARCH_VIDEO_PAGE "${1:-}"; return ;;
    status)
      video_api GET /api/status
      show "$OUT" '"video pipeline: " + ((.counts | to_entries | map(select(.value > 0) | "\(.value) \(.key)") | join(", ")) | if . == "" then "no movies yet" else . end) + (if .doing != "" then " · \(.doing)" else "" end) + (if ((.missing // []) | length) > 0 then "\nMISSING in the container: " + (.missing | join(", ")) + " (custom-cont-init.d not run?)" else "" end)' ;;
    list)
      video_api GET "/api/jobs${1:+?state=$1}"
      show "$OUT" '.jobs[] | "\(.id)\t\(.state)\t\(.title) (\(.year))  [\(.audio // [] | join(","))]\(if .donor != "" then "  ← \(.donor)\(if .progress then " \(.progress * 100 | floor) %" else "" end)" else "" end)\(if .reason != "" and .reason != null then "\n      " + .reason else "" end)"' ;;
    show)
      [[ -n ${1:-} ]] || usage_error "video show <id>"
      video_api GET "/api/jobs/$1"
      show "$OUT" '.job | "\(.id)  \(.state)  \(.title) (\(.year)), original \(.original)\n\(if .kind == "season" then "series" else "file" end): \(.file)\naudio: \(.audio // [] | join(", "))"
        + (if .episodes then "\nepisodes:\n" + (.episodes | to_entries | sort_by(.key | tonumber) | map("  E\(.key | tonumber | if . < 10 then "0\(.)" else "\(.)" end)  \(.value.state)\(if .value.offset_ms != null then "  \(.value.offset_ms) ms" else "" end)\(if (.value.reason // "") != "" then "  " + .value.reason else "" end)") | join("\n")) else "" end)
        + (if .reason then "\nreason: \(.reason)" else "" end)
        + (if .alignment then "\nalignment: \(if .alignment.ok then "offset \(.alignment.offset_ms) ms, speed \(.alignment.speed), \(.alignment.agreeing)/\(.alignment.windows) windows (\(.alignment.compared) vs original)" else .alignment.reason end)" else "" end)
        + (if (.candidates|length) > 0 then "\ncandidates:\n" + (.candidates | sort_by(-.score) | map("  [\(.status)] \(.score)  \(.title)  \(.size / 1073741824 * 10 | floor / 10) GB  \(.seeders) seeders  \(.indexer)\(if .reason != "" then "\n        " + .reason else "" end)\n        guid: \(.guid)") | join("\n")) else "" end)
        + (if .last_search then "\nlast search by hand (\(.last_search.query)): \(.last_search.found | length) candidate(s), \(.last_search.rejected | length) rejected:\n" + (.last_search.rejected[:15] | map("  - \(.title)  [\(.why)]  \(.size / 1073741824 * 10 | floor / 10) GB  \(.seeders) seeders\(if .url != "" then "\n      url: " + .url else "" end)") | join("\n")) else "" end)
        + "\nhistory:\n" + (.history[-12:] | map("  \(.t | strftime("%d/%m %H:%M"))  \(.msg)") | join("\n"))' ;;
    retry|skip|unskip)
      [[ -n ${1:-} ]] || usage_error "video $sub <id>"
      video_api POST "/api/jobs/$1" "$(jq -cn --arg a "$sub" '{action: $a}')"
      show "$OUT" '"\(.job.title): \(.job.state)"' ;;
    use)
      [[ -n ${1:-} && -n ${2:-} ]] || usage_error "video use <id> <guid>"
      video_api POST "/api/jobs/$1" "$(jq -cn --arg g "$2" '{action: "use", guid: $g}')"
      show "$OUT" '"\(.job.title): this candidate next"' ;;
    search)
      [[ -n ${1:-} && -n ${2:-} ]] || usage_error "video search <id> \"query\""
      video_api POST "/api/jobs/$1" "$(jq -cn --arg q "$2" '{action: "search", query: $q}')"
      show "$OUT" '.job.last_search | "\(.found | length) candidate(s) joined the job" + (if (.found | length) > 0 then ":\n" + (.found | map("  + " + .) | join("\n")) else "" end)
        + (if (.rejected | length) > 0 then "\n\(.rejected | length) rejected (barch video add <id> <url> takes one anyway):\n" + (.rejected[:20] | map("  - \(.title)  [\(.why)]  \(.size / 1073741824 * 10 | floor / 10) GB  \(.seeders) seeders\(if .url != "" then "\n      " + .url else "" end)") | join("\n")) else "" end)' ;;
    add)
      [[ -n ${1:-} && -n ${2:-} ]] || usage_error "video add <id> <magnet|torrent url> [\"title\"]"
      video_api POST "/api/jobs/$1" "$(jq -cn --arg u "$2" --arg t "${3:-}" '{action: "add", url: $u, title: $t}')"
      show "$OUT" '"\(.job.title): the release joined the job and is tried next (\(.job.state))"' ;;
    fix) video_fix_job "$@" ;;
    foreign)
      video_api GET /api/foreign
      show "$OUT" 'if (.files | length) == 0 then "no file has audio beyond the original and PT-BR" else
        "\(.files | length) file(s) with audio in another language:\n" + (.files | map("  \(.id)\t\(.title)  audio \(.audio | join(",")) (original \(.original))  extra: \(.extra | join(","))  trim: \(.trim)\(if .trim_error != "" then " (" + .trim_error + ")" else "" end)") | join("\n")) end' ;;
    scan)
      video_api POST /api/scan '{}'
      show "$OUT" '"video pipeline: running now"' ;;
    digest)
      video_api GET "/api/digest?days=${1:-7}"
      show "$OUT" '.text' ;;
    restart)
      video_api POST /api/restart '{}'
      show "$OUT" '"video pipeline: restarting"' ;;
    audit) exec python3 -I "$REPO/server/video/audit.py" "$@" ;;
    install) exec "$REPO/server/video/install.sh" ;;
    *) usage_error "video status|list [state]|show|retry|skip|unskip|use|search|add|fix|foreign|scan|digest|restart|audit|install" ;;
  esac
}

# torrents: the statistics service runs in its own container on the NAS (server/torrents); this only
# talks to its API with the URL and token install.sh left in ~/.config/barch/torrents.json
torrents_api() {   # torrents_api GET|POST <path>
  local conf="$HOME/.config/barch/torrents.json" url token
  [[ -r $conf && $(jq -r '.url // ""' "$conf") != "" ]] || die 3 "no service in $conf: run barch torrents install first"
  url=$(jq -r .url "$conf"); token=$(jq -r .token "$conf")
  OUT=$(curl -sS --max-time 30 -X "$1" -H "X-Barch-Token: $token" "$url$2" 2>&1) \
    || die 3 "torrent statistics not reachable at $url ($OUT)"
  jq -e . >/dev/null 2>&1 <<<"$OUT" || die 3 "torrent statistics answered: ${OUT:0:200}"
  [[ $(jq -r '.ok' <<<"$OUT") == true ]] || { [[ $JSON == 1 ]] && jq . <<<"$OUT"; die 1 "$(jq -r '.error // "failed"' <<<"$OUT")"; }
}

# player: the Player app (quickshell/player) over its IPC; `browse` starts it, the rest needs it running
player_ipc() {   # player_ipc <fn> [arg]: a JSON answer from the app (die 3 when the window is not open)
  local cfg=$HOME/.config/quickshell/player
  qs -p "$cfg" ipc show >/dev/null 2>&1 || die 3 "the Player is not open (barch player browse)"
  OUT=$(qs -p "$cfg" ipc call app "$@" 2>&1) || die 1 "player: ${OUT:0:200}"
  [[ -z $OUT ]] && OUT='{"ok": true}'
}
cmd_player() {
  local sub=${1:-browse}
  (($#)) && shift
  case $sub in
    browse | open) app_open player BARCH_PLAYER_PAGE "${1:-}" ;;
    albums | artists | tracks | genres | queue | favorites | recent | lyrics | stats | viz | settings) app_open player BARCH_PLAYER_PAGE "$sub" ;;
    play | pause | toggle | next | prev | stop | like | hide | quit)
      player_ipc "$sub"; show "$OUT" '"player: '"$sub"'"' ;;
    show) player_ipc window; show "$OUT" '"player: window shown"' ;;
    volume | seek)
      [[ -n ${1:-} ]] || usage_error "player $sub <value>"
      player_ipc "$sub" "$1"; show "$OUT" '"player: '"$sub $1"'"' ;;
    shuffle | repeat)
      player_ipc "$sub" "${1:-}"; show "$OUT" '"player: '"$sub ${1:-toggled}"'"' ;;
    status)
      player_ipc status
      show "$OUT" '(if .track then "\(if .playing then "playing" else (if .idle then "stopped" else "paused" end) end): \(.track.title) · \(.track.artist) · \(.track.album)  \(.position / 60 | floor):\(.position % 60 | tostring | if length < 2 then "0" + . else . end) / \(.duration / 60 | floor):\(.duration % 60 | tostring | if length < 2 then "0" + . else . end)" else "nothing playing" end) + "\nqueue \(.queue) (at \(.index + 1)) · volume \(.volume) · shuffle \(if .shuffle then "on" else "off" end) · repeat \(.repeat) · library \(.albums) albums, \(.tracks) tracks"' ;;
    album | play-album | queue-album)
      [[ -n ${1:-} ]] || usage_error "player $sub \"Artist/Album\""
      local fn=album; [[ $sub == play-album ]] && fn=playAlbum; [[ $sub == queue-album ]] && fn=queueAlbum
      player_ipc "$fn" "$1"
      jq -e .ok >/dev/null <<<"$OUT" || die 1 "player: $(jq -r .error <<<"$OUT")"
      show "$OUT" '"player: '"$sub $1"'" + (if .tracks then " (\(.tracks) tracks)" else "" end)' ;;
    playlist)
      [[ -n ${1:-} ]] || usage_error "player playlist <name>"
      player_ipc playlist "$1"
      jq -e .ok >/dev/null <<<"$OUT" || die 1 "player: $(jq -r .error <<<"$OUT")"
      show "$OUT" '"player: playing the playlist (\(.tracks) tracks)"' ;;
    eq)
      player_ipc eq "$*"
      jq -e .ok >/dev/null <<<"$OUT" || die 1 "player: $(jq -r .error <<<"$OUT")"
      show "$OUT" '(if .preset then "player: equalizer preset \(.preset)" elif .on != null then "player: equalizer \(if .on then "on" else "off" end)" elif .presets then "equalizer \(if .eq.on then "on" else "off" end) · preamp \(.eq.preamp) dB · bands \(.eq.gains | map(tostring) | join(" ")) dB\npresets: \(.presets | join(", "))" else "player: equalizer set" end)' ;;
    search)
      [[ -n ${1:-} ]] || usage_error "player search <text>"
      if qs -p "$HOME/.config/quickshell/player" ipc show >/dev/null 2>&1; then qs -p "$HOME/.config/quickshell/player" ipc call app search "$1" >/dev/null
      else BARCH_PLAYER_PAGE=search setsid -f qs -p "$HOME/.config/quickshell/player" >/dev/null 2>&1; fi ;;
    plex)
      case ${1:-status} in
        status)
          music_api GET /api/player/status
          show "$OUT" '(if .enabled then "Plex \(.url): \(.albums_cached) albums mapped" else "Plex: no token in the pipeline\x27s secrets.json" end)
            + (if .last.t then "\nlast: \(.last.state) \(.last.folder)/\(.last.file)" + (if .last.error then " — \(.last.error)" else " → Plex #\(.last.key) at \(.last.time / 1000 | floor) s of \(.last.duration / 1000 | floor)" end) else "\nnothing reported yet" end)
            + (if (.sessions | length) > 0 then "\nsessions: " + ([.sessions[] | "\(.device): \(.file) (\(.state))"] | join(", ")) else "" end)' ;;
        sessions)
          music_api GET /api/player/sessions
          show "$OUT" 'if (.sessions | length) == 0 then "Plex: nothing playing" else .sessions[] | "\(.grandparentTitle // .parentTitle // "") · \(.title) — \(.Player.product // "?") on \(.Player.title // .Player.device // "?") (\(.Player.state // "?")), user \(.User.title // "?")" end' ;;
        *) usage_error "player plex [status|sessions]" ;;
      esac ;;
    catalog)
      case ${1:-} in
        refresh) music_api POST "/api/catalog/refresh$([[ ${2:-} == --full ]] && echo '?full=1')"; show "$OUT" '"player: the NAS is reading the library again"' ;;
        status | "") music_api GET /api/catalog/status; show "$OUT" '"catalog: version \(.version), \(.albums) albums, \(.tracks) tracks, read \(.scanned | strflocaltime("%d/%m %H:%M"))"
          + (if .scanning then " · reading now" + (if .progress.total then ": \(.progress.done) of \(.progress.total) albums looked at, \(.progress.read) read, \(((now - .progress.started) / 60) | floor) min" else "" end) else "" end)
          + (if .last.read != null then " · last pass: \(.last.read) read, \(.last.removed) removed in \(.last.seconds) s" else "" end)' ;;
        *) usage_error "player catalog [status|refresh [--full]]" ;;
      esac ;;
    *) usage_error "player [browse] [page]|play|pause|toggle|next|prev|stop|status|volume|seek|like|shuffle|repeat|album|play-album|queue-album|playlist|search|eq|plex|catalog|show|hide|quit" ;;
  esac
}

cmd_torrents() {
  local sub=${1:-status}
  (($#)) && shift
  need curl
  # bytes and ratios as the app writes them
  local fn='def b: if . == null then "—" elif . >= 1e12 then "\(. / 1e10 | round / 100) TB" elif . >= 1e9 then "\(. / 1e7 | round / 100) GB"
                   elif . >= 1e6 then "\(. / 1e5 | round / 10) MB" else "\(. / 1e3 | round) KB" end;
            def r: if . == null then "—" else (. * 1000 | round / 1000 | tostring) end;'
  case $sub in
    browse) app_open torrents BARCH_TORRENTS_PAGE "${1:-}" ;;
    status)
      torrents_api GET /api/status
      show "$OUT" '"torrents: " + (if .samples == 0 then "no sample yet" else "\(.samples) samples since \(.start | strflocaltime("%d/%m/%Y")), every \(.poll_s / 60 | floor) min, last \(.now - .last) s ago" end)
        + " · \(.live) torrents in the client, \(.torrents - .live) removed · qBittorrent \(.qbittorrent)"
        + (if (.indexers_missing | length) > 0 then "\nno API key for " + (.indexers_missing | join(", ")) + ": their torrents have no indexer" else "" end)
        + (if .error != "" then "\nERROR: qBittorrent: \(.error)" else "" end)' ;;
    summary)
      torrents_api GET "/api/overview?range=${1:-30d}"
      show "$OUT" "$fn"'"all time   ratio \(.now.ratio | r)   ↑ \(.now.alltime_ul | b)   ↓ \(.now.alltime_dl | b)"
        + "\nin range   ratio \(.range.ratio | r)   ↑ \(.range.up | b)   ↓ \(.range.down | b)" + (if .then then "   (all-time ratio was \(.then.ratio | r))" else "" end)
        + "\n24 h       ratio \(.day.ratio | r)   ↑ \(.day.up | b)   ↓ \(.day.down | b)"
        + "\n7 days     ratio \(.week.ratio | r)   ↑ \(.week.up | b)   ↓ \(.week.down | b)"
        + "\nnow        \(.now.torrents) torrents (\(.now.size | b)), \(.now.seeding) seeding · ↑ \(.now.up_speed | b)/s  ↓ \(.now.dl_speed | b)/s"
        + "\ngoal \(.goal)     \(.live.at_goal) of \(.live.done) finished torrents there, \(.live.below_1) below 1"' ;;
    sources)
      local by=indexer
      case ${1:-} in indexer | category | tracker) by=$1; shift ;; esac
      torrents_api GET "/api/groups?by=$by&range=${1:-30d}"
      show "$OUT" "$fn"'.groups[] | "\(if .key == "" then "(unknown)" else .key end)\t\(.live) torrents\(if .torrents > .live then " +\(.torrents - .live)" else "" end)\t↑ \(.up | b)\t↓ \(.down | b)\ttotal ↑ \(.total_up | b)\t↓ \(.total_down | b)\tratio \(.ratio | r)"' | column -t -s $'\t' ;;
    top)
      torrents_api GET "/api/torrents?sort=up&range=${1:-30d}&limit=${2:-20}"
      show "$OUT" "$fn"'.torrents[] | "↑ \(.up | b)\ttotal \(.total_up | b)\tratio \(.ratio | r)\t\(.category)\t\(.name[0:70])\(if .removed_at then "  (removed)" else "" end)"' | column -t -s $'\t' ;;
    sample)
      torrents_api POST /api/sample
      show "$OUT" '"torrents: sampling now"' ;;
    restart)
      torrents_api POST /api/restart
      show "$OUT" '"torrents: restarting"' ;;
    install) exec "$REPO/server/torrents/install.sh" ;;
    *) usage_error "torrents browse [page]|status|summary [range]|sources [by] [range]|top [range] [n]|sample|restart|install" ;;
  esac
}

cmd_vpn() {
  local text='"vpn: \(.state)" + (if .name != "" then " (\(.name)\(if .ip != "" then ", " + .ip else "" end))" else "" end)
              + " · region: \(.preferred)" + (if .error != "" then " · error: \(.error)" else "" end)'
  case ${1:-status} in
    on | connect) ipc vpn up "${2:-}" ;;
    off | disconnect) ipc vpn down ;;
    toggle) ipc vpn toggle ;;
    status) ipc vpn status ;;
    regions)
      ipc vpn regions
      text='.preferred as $p | .regions[] | "\(if .id == $p then "* " else "  " end)\(.id)\t\(.name)\t\(.country)\t\(if .latency then "\(.latency * 1000 | floor) ms" else "" end)"' ;;
    region) [[ -n ${2:-} ]] || usage_error "vpn region <id>|auto"; ipc vpn region "$2" ;;
    *) usage_error "vpn on [region]|off|toggle|status|regions|region <id>|auto" ;;
  esac
  show "$OUT" "$text"
}

cmd_anon() {
  local text='"anonymous mode: \(.state)"
              + (if .vpn.name != "" then " (\(.vpn.name)\(if .vpn.ip != "" then ", " + .vpn.ip else "" end))" else "" end)
              + " · browser: \(.browser)"
              + " · kill switch: \(if .killswitch.armed then "armed (\(.killswitch.endpoint))" elif .killswitch.installed then "off" else "not installed" end)"
              + (if (.missing | length) > 0 then " · not covered: " + (.missing | join("; ")) else "" end)
              + (if .error != "" then " · error: \(.error)" else "" end)'
  case ${1:-status} in
    on) ipc anon on "${2:-}" ;;
    off) ipc anon off ;;
    toggle) ipc anon toggle ;;
    status) ipc anon status ;;
    *) usage_error "anon on [region]|off|toggle|status" ;;
  esac
  show "$OUT" "$text"
}

# claude [--refresh]: the bar's ClaudeUsage widget (quickshell/claude): the plan's limits as Claude Code's
# /usage shows them, plus the agents' spend from claude-cost.log
cmd_claude() {
  case ${1:-} in
    '') ;;
    --refresh)
      local before i
      ipc claude refresh
      before=$(jq -r '.checkedAt' <<<"$OUT")
      for ((i = 0; i < 40; i++)); do
        sleep 0.5
        ipc claude status
        [[ $(jq -r '.checkedAt' <<<"$OUT") != "$before" ]] && break
      done
      ((i < 40)) || die 1 "the usage read did not finish in 20 s"
      ;;
    *) usage_error "claude [--refresh]" ;;
  esac
  ipc claude status
  show "$OUT" '
    def left(s): if s == null then "" elif s < 3600 then " (resets in \(s / 60 | floor) min)"
      elif s < 129600 then " (resets in \(s / 3600 | floor) h \((s % 3600) / 60 | floor) min)"
      else " (resets \(now + s | strflocaltime("%a %H:%M")))" end;
    if .loaded | not then "Claude: not read yet (the bar reads ~8 s after start; use --refresh)"
    elif .ok | not then "Claude: " + (.error // "no answer") + (if .plan.label then " · plan \(.plan.label)" else "" end)
    else
      "Claude · \(.plan.label) (read \(.checkedAt / 1000 | floor | strflocaltime("%H:%M")))",
      (.limits[] | "  \(.label): \(.percent // "?") %" + left(.resets_in_s)
        + (if .allowance_percent_of_weekly then "  [\(.allowance_percent_of_weekly) % of the weekly allowance]" else "" end)),
      (if (.breakdown | length) > 0 then "  this week: " + (.breakdown | map("\(.name) \(.percent) %") | join(", ")) else empty end),
      "  agents here: US$ \(.agents.today_usd) today (\(.agents.runs_today) runs), US$ \(.agents.week_usd) this week"
        + (if (.agents.by_source_today | length) > 0 then ": " + (.agents.by_source_today | to_entries | sort_by(-.value) | map("\(.key) \(.value)") | join(", ")) else "" end)
    end'
}

cmd_inbox() {
  case ${1:-} in
    '') ;;
    --refresh)
      local before i
      ipc inbox refresh
      before=$(jq -r '.checkedAt' <<<"$OUT")
      for ((i = 0; i < 60; i++)); do          # every source is asked with a timeout (the NAS, the bar)
        sleep 0.5
        ipc inbox status
        [[ $(jq -r '.checkedAt' <<<"$OUT") != "$before" ]] && break
      done
      ((i < 60)) || die 1 "the inbox read did not finish in 30 s"
      ;;
    *) usage_error "inbox [--refresh]" ;;
  esac
  ipc inbox status
  show "$OUT" '
    if .loaded | not then "Inbox: not read yet (the bar reads it ~20 s after start; use --refresh)"
    else "Waiting for you: " + (if .total == 0 then "nothing" else "\(.total)" end)
      + (.items | map("\n  \(.count | tostring | . + " " * (5 - length))\(.label): \(.text)\n        \(.cmd | join(" "))") | join(""))
      + (if (.errors | length) > 0 then "\n  not reachable: " + (.errors | join(" · ")) else "" end)
    end'
}

cmd_health() {
  case ${1:-} in
    '') ;;
    --refresh)
      local before i
      ipc health refresh
      before=$(jq -r '.checkedAt' <<<"$OUT")
      for ((i = 0; i < 60; i++)); do          # the check takes a few seconds (du, journalctl)
        sleep 0.5
        ipc health status
        [[ $(jq -r '.checkedAt' <<<"$OUT") != "$before" ]] && break
      done
      ((i < 60)) || die 1 "the health check did not finish in 30 s"
      ;;
    *) usage_error "health [--refresh]" ;;
  esac
  ipc health status
  show "$OUT" '
    def list(xs): if (xs | length) == 0 then "none" else (xs | join(", ")) end;
    def day(ms): ms / 1000 | floor | strflocaltime("%Y-%m-%d");
    if .loaded | not then "System health: not checked yet (the bar checks ~45 s after start; use --refresh)"
    else
      "System health: " + (if .issues == 0 then "ok" else "\(.issues) issue(s)" end)
        + " (checked " + (.checkedAt / 1000 | floor | strflocaltime("%Y-%m-%d %H:%M")) + ")",
      "  .pacnew/.pacsave: \(.pacnew | length)",
      (.pacnew[] | "    \(.)"),
      "  failed services: system: \(list(.failed.system)); user: \(list(.failed.user))",
      "  TPM unlock: \(.tpm)" + (if .tpm == "failed" then "  → \(.reenroll)" else "" end),
      "  cleanup: " + (if .cleanupDue then "due" else "not due" end)
        + (if .lastCleanup > 0 then " (last \(day(.lastCleanup)))" else "" end)
        + "; \(.clean.orphans) orphans, cache \(.clean.cache), journal \(.clean.journal)",
      "  backup: " + (if .backup.configured | not then "not set up (barch backup init)"
        elif .backup.at == 0 then "never ran"
        else (if .backup.ok then "ok" else "FAILED" end) + " (last \(.backup.at | strflocaltime("%Y-%m-%d %H:%M")))"
          + (if .backupLate then " · overdue" else "" end) end)
    end'
}

# ---------------------------------------------------------------- hypr

# The settings app keeps its changes in ~/.config/hypr/settings.json (conf/settings.lua applies
# them over the hand-written files); these commands edit that file the same way and apply through
# `hyprctl eval`, so they work with or without the app open (it watches the file).
HYPR_SETTINGS=$HOME/.config/hypr/settings.json
hypr_settings() { [[ -s $HYPR_SETTINGS ]] && cat "$HYPR_SETTINGS" || echo '{}'; }
hypr_write() { local tmp; tmp=$(mktemp "$HYPR_SETTINGS.XXXXXX") && jq . >"$tmp" && mv "$tmp" "$HYPR_SETTINGS"; }
hypr_desc() { hyprctl -j descriptions 2>/dev/null | jq -e --arg n "$1" '.[] | select(.name == $n)' 2>/dev/null; }
hypr_report() { hyprctl eval 'BArch.settings.report()' 2>&1 | sed 's/^error: //'; }

hypr_edit() {
  local cfg=$HOME/.config/quickshell/hypr
  if qs -p "$cfg" ipc show >/dev/null 2>&1; then
    qs -p "$cfg" ipc call app open "${1:-}" >/dev/null
    return
  fi
  BARCH_HYPR_PAGE=${1:-} setsid -f qs -p "$cfg" >/dev/null 2>&1
}

cmd_hypr() {
  command -v hyprctl >/dev/null || die 3 "hyprctl not found"
  case "${1:-edit}" in
    edit) hypr_edit "${2:-}" ;;
    get)
      [[ -n ${2:-} ]] || usage_error "hypr get <option>"
      local d; d=$(hypr_desc "$2") || die 1 "unknown option: $2 (hyprctl descriptions)"
      local out; out=$(jq -n --argjson d "$d" --argjson s "$(hypr_settings)" \
        '{ok: true, name: $d.name, current: $d.current, default: $d.default, saved: ($s.options[$d.name] // null), description: $d.description}')
      show "$out" '"\(.name) = \(.current | tojson)  (default \(.default | tojson)\(if .saved != null then ", saved by the app: " + (.saved | tojson) else "" end))\n  \(.description)"' ;;
    set)
      [[ -n ${2:-} && -n ${3:-} ]] || usage_error "hypr set <option> <value>"
      hypr_desc "$2" >/dev/null || die 1 "unknown option: $2 (hyprctl descriptions)"
      local v; v=$(jq -c . <<<"$3" 2>/dev/null) || v=$(jq -Rc . <<<"$3")    # not JSON: a string
      hypr_settings | jq --arg n "$2" --argjson v "$v" '.options[$n] = $v' | hypr_write || die 1 "cannot write $HYPR_SETTINGS"
      hyprctl eval "BArch.settings.apply(\"options\", \"$2\")" >/dev/null 2>&1
      local rep; rep=$(hypr_report)
      if [[ $rep == *" 0 error(s)"* ]]; then show "$(jq -n --arg n "$2" --argjson v "$v" '{ok: true, name: $n, value: $v}')" '"\(.name) = \(.value | tojson)"'
      else die 1 "applied with errors: $rep"; fi ;;
    reset)
      [[ -n ${2:-} ]] || usage_error "hypr reset <option>|all"
      if [[ $2 == all ]]; then hypr_settings | jq 'del(.options)' | hypr_write
      else hypr_settings | jq --arg n "$2" 'del(.options[$n]) | if .options == {} then del(.options) else . end' | hypr_write; fi
      hyprctl reload >/dev/null 2>&1
      show "$(jq -n --arg n "$2" '{ok: true, reset: $n}')" '"\(.reset): back to the files (reloaded)"' ;;
    list) show "$(hypr_settings)" '(.options // {}) | to_entries[] | "\(.key) = \(.value | tojson)"' ;;
    status)
      local n; n=$(hyprctl -j descriptions | jq 'length')
      local out; out=$(jq -n --arg v "$(hyprctl -j version | jq -r '.tag // .version')" --argjson n "$n" --argjson s "$(hypr_settings)" \
        --arg errors "$(hyprctl configerrors 2>/dev/null)" --arg report "$(hypr_report)" \
        '{ok: true, version: $v, options: $n, saved: (($s.options // {}) | length), monitors: (($s.monitors // {}) | keys), binds: (($s.binds // []) | length), configErrors: $errors, report: $report}')
      show "$out" '"Hyprland \(.version): \(.options) options, \(.saved) saved by the app, \(.binds) binds added; \(.report)" + (if .configErrors != "" then "\nconfig errors:\n" + .configErrors else "" end)' ;;
    *) usage_error "hypr [edit] [<page>] | get <option> | set <option> <value> | reset <option>|all | list | status" ;;
  esac
}

# ---------------------------------------------------------------- apps with their own window

# app_open <quickshell dir> <ENV var for the page> [page]: one instance; a running one gets the
# request over its IPC, otherwise a new Quickshell starts on that page
app_open() {
  local cfg=$HOME/.config/quickshell/$1 var=$2 page=${3:-}
  if qs -p "$cfg" ipc show >/dev/null 2>&1; then
    qs -p "$cfg" ipc call app open "$page" >/dev/null
    return
  fi
  env "$var=$page" setsid -f qs -p "$cfg" >/dev/null 2>&1
}
cmd_center() { app_open center BARCH_CENTER_PAGE "${1:-}"; }
cmd_packages() { app_open packages BARCH_PACKAGES_PAGE "${1:-}"; }
cmd_mixer() { app_open mixer BARCH_MIXER_PAGE "${1:-}"; }

# clip [file] · clip info <file> · clip export <file> [edit...]: the video editor (quickshell/clip) and
# its ffmpeg side (clip.py, shared with the window). A running window gets the file over IPC.
CLIP_PY=$HOME/.config/quickshell/clip/clip.py
cmd_clip() {
  local sub=${1:-} file
  case $sub in
    info)
      [[ -n ${2:-} ]] || usage_error "clip info <file>"
      need python3
      show "$(python3 "$CLIP_PY" probe "$2")" '"\(.width)×\(.height) · \(.fps) fps · \(.codec)" + (if .bits > 8 then " \(.bits)-bit" else "" end) + (if .hdr then " · HDR" else "" end) + " · \(.duration | floor / 60 | floor):\(.duration | floor % 60 | tostring | if length < 2 then "0" + . else . end) · " + (if .audio then "\(.audio.codec) \(.audio.channels)ch" else "no audio" end) + (if .rotation != 0 then " · rotated \(.rotation)°" else "" end)' ;;
    export)
      shift
      need python3
      need ffmpeg
      if [[ $JSON == 1 ]]; then
        local out rc=0
        out=$(python3 "$CLIP_PY" export "$@" --json) || rc=$?
        jq . <<<"$(tail -1 <<<"$out")"
        return $rc
      fi
      python3 "$CLIP_PY" export "$@" ;;
    -*) usage_error "clip [<file>] · clip info <file> · clip export <file> [edit...]" ;;
    *)
      file=${1:-}
      if [[ -n $file ]]; then
        [[ -r $file ]] || die 1 "cannot read '$file'"
        file=$(readlink -f "$file")
      fi
      local cfg=$HOME/.config/quickshell/clip
      if qs -p "$cfg" ipc show >/dev/null 2>&1; then
        qs -p "$cfg" ipc call app open "$file" >/dev/null
      else
        env "BARCH_CLIP_FILE=$file" setsid -f qs -p "$cfg" >/dev/null 2>&1
      fi ;;
  esac
}

# ---------------------------------------------------------------- snapshot

SNAP_RUN=/run/barch-agent-snapshot
SNAP_LOG=/var/log/barch-agent-snapshots.log
uuid_re='^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'

# Claude Code hook (SessionStart and SessionEnd, see claude/.claude/settings.json). Only sessions
# whose folder is ~/BArch (or inside it); never the scheduled tasks (read-only, BARCH_AGENT_TASK).
# SessionStart's output goes into Claude's context, so the agent knows the snapshot numbers.
# Always exits 0: a failed snapshot must not block the session, it is reported instead.
snapshot_hook() {
  local input event sid cwd source out num
  input=$(cat)
  [[ -n ${BARCH_AGENT_TASK:-} ]] && return 0
  event=$(jq -r '.hook_event_name // ""' <<<"$input")
  sid=$(jq -r '.session_id // ""' <<<"$input")
  cwd=$(jq -r '.cwd // ""' <<<"$input")
  source=$(jq -r '.source // ""' <<<"$input")
  cwd=$(readlink -f "$cwd" 2>/dev/null) || return 0
  [[ $cwd == "$REPO" || $cwd == "$REPO"/* ]] || return 0
  [[ $sid =~ $uuid_re ]] || return 0

  case $event in
    SessionStart)
      [[ $source == startup || $source == resume ]] || return 0
      if out=$(systemctl start --no-ask-password "barch-agent-snapshot@pre-$sid.service" 2>&1); then
        num=$(cat "$SNAP_RUN/$sid.pre" 2>/dev/null)
        echo "Safety net: snapper snapshot #${num:-?} (pre) of / was taken before this session; a post"
        echo "snapshot is taken when it ends. What the session changed outside the repo:"
        echo "\`sudo snapper -c root status ${num:-N}..<post>\`; undo: \`sudo snapper -c root undochange ${num:-N}..<post>\`"
        echo "(\`barch snapshot list\` shows the post number). /home is not in the snapshot; the repo is covered by git."
      else
        echo "WARNING: the safety snapshot before this session failed: ${out:-unknown error}"
        echo "Tell Bruno before changing anything outside the repo (/etc, /boot, /usr/local, packages)."
      fi
      ;;
    SessionEnd)
      # no-block: SessionEnd hooks get little time; the snapshot finishes on its own
      [[ -r $SNAP_RUN/$sid.pre ]] &&
        systemctl start --no-block --no-ask-password "barch-agent-snapshot@post-$sid.service" >/dev/null 2>&1
      ;;
  esac
  return 0
}

snapshot_list() {
  local data
  [[ -r $SNAP_LOG ]] || { [[ $JSON == 1 ]] && echo '[]' || echo "No safety snapshots yet."; return 0; }
  # log lines: <iso time> <pre|post> <number> <session>
  data=$(jq -Rn '[inputs | split(" ") | {time: .[0], type: .[1], number: (.[2] | tonumber), session: .[3]}]
                 | group_by(.session) | map({session: .[0].session, time: (map(select(.type == "pre")) | last | .time // .[0].time),
                   pre: (map(select(.type == "pre")) | last | .number), post: (map(select(.type == "post")) | last | .number)})
                 | sort_by(.time)' "$SNAP_LOG")
  show "$data" '
    if length == 0 then "No safety snapshots yet." else
      (.[] | "\(.time[0:16] | sub("T"; " "))  #\(.pre // "?")..\(.post // "(open)")  session \(.session[0:8])"),
      "",
      "What a session changed:  sudo snapper -c root status <pre>..<post>",
      "Undo it:                 sudo snapper -c root undochange <pre>..<post>"
    end'
}

cmd_snapshot() {
  case ${1:-} in
    hook) snapshot_hook ;;
    list) snapshot_list ;;
    *) usage_error "snapshot list|hook" ;;
  esac
}

# ---------------------------------------------------------------- failure

# The compositor went away: Hyprland died in the last two minutes (start-hyprland, uwsm, restarts
# it inside the same unit, so the unit never fails: the trace is its "exit not-cleanly" line), or
# its Wayland socket is gone right now. The second covers a clean exit (logout, a restart after an
# update): the services that lose it fail in the same second, before "exit cleanly" is logged.
#
# The socket file outlives the exit (libwayland unlinks it in wl_display_destroy, ~0.6 s after
# the clients got their broken pipe on 2026-11-09), so the socket is connected to, not just looked
# at; with the variables already cleaned up by uwsm the session is over. When neither says so,
# wait up to 2 s for start-hyprland's own "exit cleanly" / "exit not-cleanly" line.
compositor_lost() {
  local i
  [[ -z ${WAYLAND_DISPLAY:-} || -z ${XDG_RUNTIME_DIR:-} ]] && return 0
  python3 -I - "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" 2>/dev/null <<'EOF' || return 0
import socket, sys
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(0.5)
s.connect(sys.argv[1])
EOF
  for ((i = 0; i < 5; i++)); do
    journalctl --user -u 'wayland-wm@*.service' --since -120s -o cat --no-pager 2>/dev/null |
      grep -qE 'exit (not-)?cleanly' && return 0
    ((i < 4)) && sleep 0.5
  done
  return 1
}

# how the compositor ended since <epoch>: "clean", "crash" or "" (nothing logged)
compositor_exit() {
  journalctl --user -u 'wayland-wm@*.service' --since "@$(($1 - 5))" -o cat --no-pager 2>/dev/null |
    grep -oE 'exit (not-)?cleanly' | tail -1 | sed 's/exit not-cleanly/crash/; s/exit cleanly/clean/'
}

# failure --cascade-report: the one notification for a compositor crash, with its casualties
# (collected by cmd_failure in failures/.cascade/). Writes failures/hyprland-<stamp>.log with the
# coredumps, the newest Hyprland crash report and the journal of the session unit, then waits
# for the bar (up to a minute: it is being relaunched by the new Hyprland) to post.
cascade_report() {
  local cdir=$STATE/failures/.cascade since units log stamp crash i
  [[ -s $cdir/units ]] || return 0
  since=$(<"$cdir/since")
  mapfile -t units < <(sort -u "$cdir/units" | sed 's/\.service$//')
  if [[ $(compositor_exit "$since") == clean ]]; then
    # a logout or a restart of the session, not a failure: the logs stay, already dismissed
    cat "$cdir/logs" >>"$STATE/failures/.dismissed" 2>/dev/null
    rm -rf "$cdir"
    return 0
  fi
  rm -rf "$cdir"
  stamp=$(date -d "@$since" +%Y%m%d-%H%M%S)
  log=$STATE/failures/hyprland-$stamp.log
  crash=$(find "$HOME/.cache/hyprland" -maxdepth 1 -name 'hyprlandCrashReport*.txt' -newermt "@$((since - 120))" -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-)
  {
    echo "Unit: Hyprland (wayland-wm@hyprland.desktop.service; start-hyprland restarted it in place)"
    echo "Crashed: $(date -d "@$since" '+%Y-%m-%d %H:%M:%S') (time of the first user service that lost it)"
    echo "Casualties (${#units[@]}): ${units[*]}"
    echo
    echo "=== coredumps from two minutes before the crash"
    coredumpctl list --since "@$((since - 120))" --no-pager 2>&1
    echo
    if [[ -n $crash ]]; then
      echo "=== $crash (first 60 lines)"
      head -n 60 "$crash"
    else
      echo "=== no Hyprland crash report in ~/.cache/hyprland (SIGKILL leaves none)"
    fi
    echo
    echo "=== journal of wayland-wm@* from two minutes before the crash"
    journalctl --user -u 'wayland-wm@*.service' --since "@$((since - 120))" -o short-iso --no-pager 2>&1 | head -n 400
  } >"$log"

  local title body acts
  title="Hyprland crashed at $(date -d "@$since" +%H:%M)"
  body="${#units[@]} user service$( ((${#units[@]} > 1)) && echo s) restarted with it: ${units[*]}"
  acts=$(jq -sc . <(action "Investigate" "$BARCH" agent investigate "$log") \
                  <(action "Show log" foot -T "Hyprland" -e less +G "$log"))
  for ((i = 0; i < 12; i++)); do
    ipc_try notifs post "$title" "$body" critical "System" "$(actions_arg "$acts")" && return 0
    sleep 5
  done
  post "$title" "$body" critical "System" "$acts"
}

# failure list|dismiss|delete [<unit>|all]: the saved logs. A dismissed log stays on disk (the
# morning and weekly tasks still read it) but is out of what asks for attention: the Center's
# badges and the Inbox count the logs of the last day that are not in failures/.dismissed (one
# log file name per line). systemd always passes a full unit name (foo.service), so the three
# words cannot be taken for a unit.
failure_list() {   # [<unit>|all] → [{name, unit, time, size, path, dismissed}], newest first
  local dir=$STATE/failures
  find "$dir" -maxdepth 1 -name '*.log' -printf '%T@\t%s\t%f\n' 2>/dev/null | sort -rn |
    jq -Rn --rawfile seen <(cat "$dir/.dismissed" 2>/dev/null) --arg dir "$dir" --arg unit "${1:-all}" '
      ($seen | split("\n")) as $s
      | [inputs | split("\t")
         | {name: .[2], unit: (.[2] | sub("-[0-9]{8}-[0-9]{6}\\.log$"; "")), time: (.[0] | tonumber | floor),
            size: (.[1] | tonumber), path: ($dir + "/" + .[2])}
         | select($unit == "all" or .unit == $unit or .unit == $unit + ".service")
         | .dismissed = (.name | IN($s[]))]'
}

failure_manage() {
  local sub=$1 what=${2:-all} dir=$STATE/failures logs n f
  (($# <= 2)) || usage_error "failure $sub [<unit>|all]"
  logs=$(failure_list "$what")
  case $sub in
    list)
      show "$logs" 'if length == 0 then "no failure logs" else
        .[] | "\(.time | strflocaltime("%Y-%m-%d %H:%M"))  \(.unit)\(if .dismissed then "  (dismissed)" else "" end)" end'
      return ;;
    dismiss)
      n=$(jq '[.[] | select(.dismissed | not)] | length' <<<"$logs")
      jq -r '.[].name' <<<"$logs" >>"$dir/.dismissed" 2>/dev/null ;;
    delete)
      n=$(jq length <<<"$logs")
      while read -r f; do [[ -n $f ]] && rm -f -- "$dir/$f"; done < <(jq -r '.[].name' <<<"$logs") ;;
  esac
  # the names of logs that are gone (deleted, or beyond the 50 kept) leave the list
  if [[ -e $dir/.dismissed ]]; then
    sort -u "$dir/.dismissed" | while read -r f; do [[ -n $f && -e $dir/$f ]] && echo "$f"; done >"$dir/.dismissed.new"
    mv "$dir/.dismissed.new" "$dir/.dismissed"
  fi
  show "$(jq -nc --arg sub "$sub" --arg what "$what" --argjson n "$n" '{ok: true, action: $sub, what: $what, count: $n}')" \
    '"\(.count) failure log(s) \(if .action == "delete" then "deleted" else "dismissed" end)"'
}

# failure <unit> [--system]: OnFailure handler (user: barch-failure@.service; system:
# barch-failure-relay). systemd passes MONITOR_* about the failed run. Saves status and journal
# to ~/.local/state/barch/failures/ (every failure) and notifies with Investigate / Show log. At
# most one notification per unit every 30 min: failures inside that window are counted in the
# mark file (.last/<scope>-<unit>, whose mtime is the last notification) and the next notification
# says how many there were. agent/failure-ignore lists units to skip.
#
# When the compositor goes away, the user services that only lost it (portals, cliphist,
# hyprsunset...) fail together within a second: each log is still saved, but instead of one
# notification per service they are collected in .cascade/ and `failure --cascade-report`,
# scheduled 30 s after the first one (the bar is back by then), decides: Hyprland exited cleanly
# (logout, a restart after an update) → no notification, the logs go straight to .dismissed;
# otherwise one notification for the crash with the list.
cmd_failure() {
  case ${1:-} in list|dismiss|delete) failure_manage "$@"; return ;; esac
  local unit="" scope=--user glob
  while (($#)); do
    case $1 in
      --system) scope=--system ;;
      --cascade-report) cascade_report; return ;;
      -*) usage_error "failure: unknown option '$1'" ;;
      *) unit=$1 ;;
    esac
    shift
  done
  [[ -n $unit ]] || usage_error "failure <unit> [--system]"
  [[ $unit == *.* ]] || unit+=.service

  if [[ -r $REPO/agent/failure-ignore ]]; then
    while read -r glob; do
      [[ -z $glob || $glob == \#* ]] && continue
      # shellcheck disable=SC2053  # glob match on purpose
      [[ $unit == $glob ]] && return 0
    done <"$REPO/agent/failure-ignore"
  fi

  local dir=$STATE/failures stamp log mark quiet=0 count=0 cascade=0
  [[ $scope == --user ]] && compositor_lost && cascade=1
  mkdir -p "$dir/.last"
  mark=$dir/.last/${scope#--}-$unit
  if [[ -e $mark ]]; then
    count=$(<"$mark")
    [[ $count =~ ^[0-9]+$ ]] || count=0
    [[ -n $(find "$mark" -mmin -30 2>/dev/null) ]] && quiet=1
  fi

  stamp=$(date +%Y%m%d-%H%M%S)
  log=$dir/${unit}-$stamp.log
  local result=${MONITOR_SERVICE_RESULT:-failed} code=${MONITOR_EXIT_CODE:-} status=${MONITOR_EXIT_STATUS:-}
  local inv=${MONITOR_INVOCATION_ID:-} jscope=() lines
  [[ $scope == --user ]] && jscope=(--user)
  {
    echo "Unit: $unit (${scope#--} service)"
    echo "Failed: $(date '+%Y-%m-%d %H:%M:%S')"
    echo "Result: $result${code:+, $code}${status:+ $status}"
    echo "Invocation: ${inv:-unknown}"
    echo
    echo "=== systemctl ${scope#--} status"
    systemctl "$scope" status "$unit" --no-pager -l -n 0 2>&1
    echo
    echo "=== journal of the failed run"
    if [[ -n $inv ]] && lines=$(journalctl "${jscope[@]}" "_SYSTEMD_INVOCATION_ID=$inv" -o short-iso --no-pager 2>&1) && [[ -n $lines && $lines != "-- No entries --" ]]; then
      echo "$lines"
    elif [[ $scope == --user ]]; then
      journalctl --user -u "$unit" -b -n 300 -o short-iso --no-pager 2>&1
    else
      journalctl -u "$unit" -b -n 300 -o short-iso --no-pager 2>&1
    fi
  } >"$log"
  # keep the last 50 logs
  find "$dir" -maxdepth 1 -name '*.log' -printf '%T@ %p\n' | sort -rn | tail -n +51 | cut -d' ' -f2- | xargs -r rm -f

  if ((cascade)); then
    # a casualty of the compositor: no notification of its own, the unit's mark stays untouched
    mkdir -p "$dir/.cascade"
    [[ -e $dir/.cascade/since ]] || date +%s >"$dir/.cascade/since"
    echo "$unit" >>"$dir/.cascade/units"
    echo "${log##*/}" >>"$dir/.cascade/logs"
    # one report for the whole burst; fails quietly when the first casualty already scheduled it
    systemd-run --user --quiet --collect --unit=barch-cascade --on-active=30 \
      "$BARCH" failure --cascade-report 2>/dev/null || true
    echo "$log"
    return 0
  fi

  if ((quiet)); then
    # inside the window: count it, keeping the mark's mtime (time of the last notification)
    echo $((count + 1)) >"$mark.new" && touch -r "$mark" "$mark.new" && mv "$mark.new" "$mark"
    echo "$log"
    return 0
  fi

  local last body acts title="$unit failed"
  ((count > 0)) && title+=" ($((count + 1))× since $(date -r "$mark" +%H:%M))"
  echo 0 >"$mark"
  last=$(grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2}T' "$log" | tail -1 | cut -d' ' -f3- | cut -c1-160)
  body="$result${status:+ ($code $status)}${last:+ — $last}"
  acts=$(jq -sc . <(action "Investigate" "$BARCH" agent investigate "$log") \
                  <(action "Show log" foot -T "$unit" -e less +G "$log"))
  post "$title" "$body" critical "System" "$acts"
  echo "$log"
}

# ---------------------------------------------------------------- voice

# voice: the daemon is voice.py (quickshell/voice); on/off/toggle go through systemd, pause/
# resume/say/test/reload through its socket, match runs offline, status merges both.
cmd_voice() {
  local py=$REPO/quickshell/.config/quickshell/voice/voice.py unit=barch-voice.service sub=${1:-status}
  (($#)) && shift
  need python3
  case $sub in
    on) systemctl --user start "$unit" || die 1 "could not start $unit"; cmd_voice status ;;
    off) systemctl --user stop "$unit" || die 1 "could not stop $unit"; cmd_voice status ;;
    toggle)
      if systemctl --user is-active --quiet "$unit"; then cmd_voice off; else cmd_voice on; fi ;;
    status)
      local active out
      active=$(systemctl --user is-active "$unit" 2>/dev/null)
      out=$(python3 -I "$py" status 2>/dev/null) || out='{"ok":false}'
      out=$(jq -c --arg a "$active" '. + {service: $a}' <<<"$out")
      show "$out" 'if .service != "active" then "voice: off (service \(.service))"
                   else "voice: \(.state)" + (if .paused then " (paused)" else "" end)
                     + (if .whisper then "" else " — whisper.cpp or model missing" end)
                     + (if .tts then "" else " — piper missing (no spoken answers)" end)
                     + (if .heard != "" then "\nheard: \(.heard)" else "" end)
                     + (if .said != "" then "\nsaid: \(.said)" else "" end)
                     + (if .error != "" then "\nerror: \(.error)" else "" end) end'
      [[ $active == active ]] ;;
    lang | language)
      local out
      if [[ ${1:-} == list ]]; then
        out=$(python3 -I "$py" languages)
        show "$out" '.languages[] | "\(.code)\t\(.name)\(if .native != .name then " · \(.native)" else "" end)\(if .commands then "  (commands)" elif .code == "auto" then "" elif .voice == null then "  (no voice: notifications)" elif .downloaded then "" else "  (voice downloaded when picked)" end)"'
        return
      fi
      out=$(python3 -I "$py" language ${1:+"$1"}) || {
        [[ $? == 3 ]] && die 3 "barch-voice is not running"
        die 1 "$(jq -r '.error // "failed"' <<<"$out" 2>/dev/null)"
      }
      show "$out" '"voice: listening in \(.language_name)\(if .language_native != "" and .language_native != .language_name then " (\(.language_native))" else "" end)" + (if .downloading != "" then " — downloading the voice \(.downloading)" elif .voice_ready then "" else " — no voice: answers go to notifications" end)' ;;
    pause | resume | reload)
      local out
      out=$(python3 -I "$py" "$sub") || die 1 "$(jq -r '.error // "failed"' <<<"$out" 2>/dev/null)"
      show "$out" '"voice: \(if .paused == true then "paused" elif .paused == false then "listening" else "reloaded (\(.intents) commands)" end)"' ;;
    say)
      [[ -n ${1:-} ]] || usage_error "voice say <text>"
      local out
      out=$(python3 -I "$py" say "$*") || die 1 "$(jq -r '.error // "failed"' <<<"$out" 2>/dev/null)"
      show "$out" '"said: \(.said)"' ;;
    test)
      [[ -n ${1:-} ]] || usage_error "voice test <text>"
      local out rc=0
      out=$(python3 -I "$py" run "$*") || rc=$?
      ((rc == 3)) && die 3 "$(jq -r .error <<<"$out")"
      show "$out" 'if .locked then "ignored: the session is locked" else "\(if .matched then .intent else "no command (Claude)" end)" + (if .say != "" then ": \(.say)" else "" end) end'
      return "$rc" ;;
    match)
      [[ -n ${1:-} ]] || usage_error "voice match <text>"
      local out rc=0
      out=$(python3 -I "$py" match "$*" 2>/dev/null) || rc=$?
      show "$out" 'if .matched then "\(.intent) (\(.kind))" + (if .run then ": \(.run | join(" "))" elif .dispatch then ": hyprctl dispatch \(.dispatch)" elif .app then ": app \(.app)" elif .project then ": \(.with // "terminal") in \(.project)" elif .palette then ": palette \(.palette)" elif .scene then ": scene \(.scene)" elif .region then ": \(.what) region \(.region)" elif .window then ": \(.action) window \(.window)" elif .repeats then ": \(.how) → \(.repeats)" else "" end) + (if .say != "" then "  → \"\(.say)\"" else "" end) else "no command: " + (if .intent == "claude" then "would ask Claude" else "would say it did not understand" end) + " (\(.normalized))" end'
      return "$rc" ;;
    wake)
      [[ -n ${1:-} ]] || usage_error "voice wake <text>"
      local out rc=0
      out=$(python3 -I "$py" wake "$*" 2>/dev/null) || rc=$?
      show "$out" 'if .wake then "wakes" + (if .rest != "" then ", command: \(.rest)" else " (alone: chime, waits for the sentence)" end) else "does not wake (score \(.score) against barch)" end'
      return "$rc" ;;
    misses)
      local f=$STATE/voice/wake-misses.log
      [[ -s $f ]] || { echo "nothing came close to the wake word yet ($f)"; return 0; }
      tail -n "${1:-30}" "$f" ;;
    log) journalctl --user -u "$unit" -n "${1:-60}" --no-pager -o short ;;
    setup) bash "$REPO/quickshell/.config/quickshell/voice/setup.sh" "$@" ;;
    *) usage_error "voice on|off|toggle|status|pause|resume|say|match|wake|misses|test|reload|log|setup" ;;
  esac
}

# ---------------------------------------------------------------- automation (events.py)

# cost_log <source> <usd> [note]: one line per Claude call, read by barch-events (metrics summary)
cost_log() { [[ -n ${2:-} ]] && echo "$(date +%s) $1 $2 ${3:-}" >>"$STATE/claude-cost.log"; return 0; }

events_py() { need python3; python3 -I "$REPO/agent/events.py" "$@"; }

cmd_rules() {
  local sub=${1:-list} out rc=0
  (($#)) && shift
  case $sub in
    list)
      out=$(events_py rules) || rc=$?
      show "$out" '.rules[] | "\(if .enabled then "●" else "○" end) \(.id | . + " " * (18 - length))  \(.description)"
        + "\n     when: " + (.when | if .event then "event \(.event)" + ([to_entries[] | select(.key != "event") | " \(.key)~\(.value)"] | join(""))
                              else "metric \(.metric) " + (if .above != null then "> \(.above)" else "< \(.below)" end) end)
        + (if (.do | length) > 0 then "\n     do: " + (.do | join("; ")) else "" end)
        + (if .notify != "" then "\n     notify: \(.notify)" else "" end)
        + "\n     last: " + (if .last then (.last | strflocaltime("%Y-%m-%d %H:%M")) + (if .last_ok == false then " (failed)" else "" end) else "never" end)
        + "  ·  fired \(.fired_7d)× in 7 days  ·  cooldown \(.cooldown)"' ;;
    test)
      [[ -n ${1:-} ]] || usage_error "rules test <event> [key=value...] | rules test metric <name> <value>"
      out=$(events_py test "$@") || rc=$?
      show "$out" 'if .rules | length > 0 then "would fire: \(.rules | join(", "))" else "no rule matches" end' ;;
    fire)
      [[ -n ${1:-} ]] || usage_error "rules fire <id> [key=value...]"
      out=$(events_py fire "$@") || rc=$?
      show "$out" 'if .error then "error: \(.error)" else "\(.rule): " + (if .ok then "ok" else "failed: \(.failed | join("; "))" end) + (if (.ran | length) > 0 then "\n  " + (.ran | join("\n  ")) else "" end) end' ;;
    enable | disable)
      [[ -n ${1:-} ]] || usage_error "rules $sub <id>"
      out=$(events_py "$sub" "$1") || rc=$?
      show "$out" 'if .ok then "\(.id): \(if .enabled then "enabled" else "disabled" end)" else "error: \(.error)" end' ;;
    edit) ${EDITOR:-nvim} "$REPO/agent/rules.json" ;;
    *) usage_error "rules list|test|fire|enable|disable|edit" ;;
  esac
  return "$rc"
}

cmd_events() {
  local sub=${1:-status} out rc=0 unit=barch-events.service
  (($#)) && shift
  case $sub in
    status)
      out=$(events_py status) || rc=$?
      show "$out" '"events: service \(.service), \(.rules) rules (\(.enabled) enabled), \(.metrics) metrics, last sample "
        + (if .last_sample > 0 then (.last_sample | strflocaltime("%H:%M:%S")) else "never" end)
        + ", \(.events_24h) events in 24 h, db \(.db_bytes / 1048576 | floor) MB"' ;;
    log)
      out=$(events_py events "$@") || rc=$?
      show "$out" '.events[] | "\(.ts | strflocaltime("%m-%d %H:%M:%S"))  \(.event | . + " " * (18 - length))  "
        + (.data | to_entries | map(select(.value != "" and .value != null) | "\(.key)=\(.value | tostring | .[0:60])") | join("  "))' ;;
    on) systemctl --user start "$unit" || die 1 "could not start $unit"; cmd_events status ;;
    off) systemctl --user stop "$unit" || die 1 "could not stop $unit"; cmd_events status ;;
    reload) systemctl --user reload "$unit" || die 1 "could not reload $unit"; cmd_events status ;;
    journal) journalctl --user -u "$unit" -n "${1:-60}" --no-pager -o short ;;
    *) usage_error "events status|log|on|off|reload|journal" ;;
  esac
  return "$rc"
}

cmd_metrics() {
  local sub=${1:-list} out rc=0
  (($#)) && shift
  case $sub in
    list)
      out=$(events_py metrics) || rc=$?
      show "$out" '.metrics[] | "\(.metric | . + " " * (22 - length))  " + (if .value != null then (.value * 10 | round / 10 | tostring) else "-" end)' ;;
    series)
      [[ -n ${1:-} ]] || usage_error "metrics series <metric> [--since 24h] [--points N]"
      out=$(events_py series "$@") || rc=$?
      show "$out" '"\(.metric): \(.points | length) points since \(.since | strflocaltime("%Y-%m-%d %H:%M")), min \(.min) avg \(.avg) max \(.max) last \(.last)"' ;;
    summary)
      out=$(events_py summary) || rc=$?
      show "$out" '"boot: " + (if .boot.seconds then "\(.boot.seconds)s (\(.boot.kernel)), average \(.boot.avg_seconds)s over \(.boot.count_90d) boots" else "unknown" end)
        + "\nfailures: \(.failures.today) today, \(.failures.week) this week (\(.failures.last_week) last week), \(.failures.month) in 30 days"
        + "\nclaude: US$ \(.claude.today) today, \(.claude.week) this week, \(.claude.month) in 30 days"
        + "\nvpn: " + (if .vpn.connected then "connected, \(.vpn.latency_ms) ms" else "off" end) + ", \(.vpn.drops_7d) drops in 7 days"
        + "\nnow: cpu \(.now["cpu.temp"]) °C \(.now["cpu.pct"] // 0 | floor)%, gpu \(.now["gpu.temp"]) °C \(.now["gpu.util"] // 0 | floor)%, ram \(.now["ram.pct"] // 0 | floor)%, disk \(.now["disk.root.pct"] // 0 | floor)%, ping \(.now["net.latency_ms"]) ms"
        + "\nrules fired: \(.rules.fired_24h) in 24 h, \(.rules.fired_7d) in 7 days"' ;;
    *) usage_error "metrics list|series|summary" ;;
  esac
  return "$rc"
}

# nas status|setup: agent/nas.py prints the snapshot itself (text, or JSON with --json)
cmd_nas() {
  local sub=${1:-status}
  (($#)) && shift
  need python3
  case $sub in
    status) if [[ $JSON == 1 ]]; then python3 -I "$REPO/agent/nas.py" status --json "$@" | jq .; return "${PIPESTATUS[0]}"
            else python3 -I "$REPO/agent/nas.py" status "$@"; fi ;;
    setup) python3 -I "$REPO/agent/nas.py" setup ;;
    *) usage_error "nas status [--no-certs]|setup" ;;
  esac
}

# disk status: agent/disk.py parses what barch-disk-health (root, hourly) dumped
cmd_disk() {
  local sub=${1:-status}
  (($#)) && shift
  need python3
  case $sub in
    status) if [[ $JSON == 1 ]]; then python3 -I "$REPO/agent/disk.py" status --json; else python3 -I "$REPO/agent/disk.py" status; fi ;;
    *) usage_error "disk status" ;;
  esac
}

# fw status|clients|blocked|setup: agent/pfsense.py prints the snapshot itself (text, or JSON with --json)
cmd_fw() {
  local sub=${1:-status}
  (($#)) && shift
  need python3
  case $sub in
    status | clients | blocked)
      if [[ $JSON == 1 ]]; then python3 -I "$REPO/agent/pfsense.py" "$sub" "$@" --json | jq .; return "${PIPESTATUS[0]}"
      else python3 -I "$REPO/agent/pfsense.py" "$sub" "$@"; fi ;;
    setup) python3 -I "$REPO/agent/pfsense.py" setup ;;
    *) usage_error "fw status|clients|blocked [site]|setup" ;;
  esac
}

# rgb: agent/rgb.py drives ckb-next-daemon's pipes (text, or JSON with --json)
