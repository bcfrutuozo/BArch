# --json may come anywhere
args=()
for a in "$@"; do
  case $a in
    --json) JSON=1 ;;
    *) args+=("$a") ;;
  esac
done
set -- "${args[@]}"

cmd=${1:-help}
(($#)) && shift
case $cmd in
  notify) cmd_notify "$@" ;;
  theme) cmd_theme "$@" ;;
  wallpaper) cmd_wallpaper "$@" ;;
  hypr) cmd_hypr "$@" ;;
  center) cmd_center "$@" ;;
  packages) cmd_packages "$@" ;;
  mixer) cmd_mixer "$@" ;;
  clip) cmd_clip "$@" ;;
  hdr) cmd_hdr "$@" ;;
  sdr) cmd_sdr "$@" ;;
  monitor) cmd_monitor "$@" ;;
  caffeine) cmd_caffeine "$@" ;;
  nightlight | night-light) cmd_nightlight "$@" ;;
  dnd) cmd_dnd "$@" ;;
  anon) cmd_anon "$@" ;;
  vpn) cmd_vpn "$@" ;;
  music) cmd_music "$@" ;;
  player) cmd_player "$@" ;;
  books) cmd_books "$@" ;;
  video) cmd_video "$@" ;;
  torrents) cmd_torrents "$@" ;;
  health) cmd_health "$@" ;;
  inbox) cmd_inbox "$@" ;;
  claude) cmd_claude "$@" ;;
  rules) cmd_rules "$@" ;;
  events) cmd_events "$@" ;;
  metrics) cmd_metrics "$@" ;;
  nas) cmd_nas "$@" ;;
  disk) cmd_disk "$@" ;;
  fw | pfsense) cmd_fw "$@" ;;
  rgb) cmd_rgb "$@" ;;
  drop) cmd_drop "$@" ;;
  voice) cmd_voice "$@" ;;
  snapshot) cmd_snapshot "$@" ;;
  failure) cmd_failure "$@" ;;
  agent) cmd_agent "$@" ;;
  aur) cmd_aur "$@" ;;
  replay) cmd_replay "$@" ;;
  backup) cmd_backup "$@" ;;
  finance) cmd_finance "$@" ;;
  help | -h | --help) usage ;;
  *) usage_error "unknown command '$cmd'" ;;
esac
