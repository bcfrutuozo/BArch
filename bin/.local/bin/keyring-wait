#!/usr/bin/env bash
# keyring-wait — block until a GNOME keyring collection is unlocked (default: "login").
#
#   keyring-wait [--timeout SECONDS] [COLLECTION]
#
# This machine logs in automatically (agetty --autologin), so nothing unlocks the keyring until
# the lock screen gets the password (pam_gnome_keyring in /etc/pam.d/barch-lock). Apps started
# by the session autostart run before that and get an "Unlock Keyring" dialog from gcr-prompter
# every login. Used as ExecStartPre= on those units (systemd/.config/systemd/user/app-*.d/)
# so they start after the unlock instead. Once the login keyring is open, gnome-keyring also
# opens the other keyrings whose passwords it stores ("Unlock password for: ...").
#
# Always exits 0: after the timeout (default 1 h) the app starts anyway, and prompts as before.
set -u
timeout=3600
collection=login
while (( $# )); do
  case $1 in
    --timeout) timeout=$2; shift 2 ;;
    -h|--help) sed -n '2,13p' "$0"; exit 0 ;;
    *) collection=$1; shift ;;
  esac
done

locked() {   # "b false" once the collection exists and is unlocked; anything else keeps waiting
  local state
  state=$(busctl --user --timeout=5 get-property org.freedesktop.secrets \
    "/org/freedesktop/secrets/collection/$collection" \
    org.freedesktop.Secret.Collection Locked 2>/dev/null)
  [[ $state != "b false" ]]
}

deadline=$(( $(date +%s) + timeout ))
while locked; do
  if (( $(date +%s) >= deadline )); then
    logger -t keyring-wait "keyring '$collection' still locked after ${timeout}s, going on without it"
    exit 0
  fi
  sleep 2
done
exit 0
