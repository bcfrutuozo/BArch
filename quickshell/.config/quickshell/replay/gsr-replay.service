# ~/.config/systemd/user/gsr-replay.service
# Replay estilo ShadowPlay: mantém sempre os últimos 30 s do monitor principal na memória,
# gravados pelo encoder da RTX (NVENC). Nada vai para o disco até você salvar.
#   salvar:          systemctl --user kill --kill-whom=main -s SIGUSR1 gsr-replay   (atalho Alt+F10)
#   ligar/desligar:  systemctl --user start|stop gsr-replay         (atalho Super+Alt+R)
# Os vídeos vão para ~/Videos/Replays; ao salvar, aparece uma notificação com "Open".

[Unit]
Description=GPU Screen Recorder replay buffer (last 30 seconds)
After=graphical-session.target pipewire.service
PartOf=graphical-session.target

[Service]
ExecStartPre=/usr/bin/mkdir -p %h/Videos/Replays
# -w        monitor gravado (o AW3225QF)
# -k        hevc_hdr grava em HDR (o monitor está em HDR); troque por "hevc" se os vídeos
#           forem para lugares sem suporte a HDR
# -a        som do sistema e microfone misturados numa faixa só (todo player toca os dois)
# -replay-storage ram   o buffer fica na RAM (uns poucos centos de MB), sem gastar o SSD
ExecStart=/usr/bin/gpu-screen-recorder \
    -w HDMI-A-2 -f 60 \
    -c mkv -k hevc_hdr -q very_high \
    -r 30 -replay-storage ram \
    -a "default_output|default_input" \
    -o %h/Videos/Replays \
    -sc %h/.local/bin/gsr-replay-saved
# no modo replay, SIGINT encerra sem salvar; se ele não fechar em 5 s, é forçado
KillSignal=SIGINT
TimeoutStopSec=5
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
