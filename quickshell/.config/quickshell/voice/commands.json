      "run": [
        "qs",
        "ipc",
        "call",
        "control",
        "open"
      ],
      "sound": null,
      "patterns": [
        "(abre|abra|abrir|mostra|mostrar) (a |o |os )?(central de controle|control center|controles|painel de controle|painel da barra)"
      ]
    },
    {
      "name": "window-close",
      "kind": "hypr",
      "dispatch": "hl.dsp.window.close()",
      "sound": null,
      "patterns": [
        "(fecha|feche|fechar|mata|encerra|encerre) (essa |esta |a |o )?(janela|aba|aplicativo|app|programa|isso|isto)( atual| ativa| ativo)?"
      ]
    },
    {
      "name": "window-fullscreen",
      "kind": "hypr",
      "dispatch": "hl.dsp.window.fullscreen({ mode = \"fullscreen\", action = \"toggle\" })",
      "sound": null,
      "patterns": [
        "(tela cheia|fullscreen|maximiza|maximizar|maximize|sai da tela cheia|tira da tela cheia)( (a |essa |na )?janela)?",
        "(coloca|poe|bota) (a |essa )?janela em tela cheia"
      ]
    },
    {
      "name": "window-float",
      "kind": "hypr",
      "dispatch": "hl.dsp.window.float({ action = \"toggle\" })",
      "sound": null,
      "patterns": [
        "(flutua|flutuar|solta|desencaixa|encaixa|ancora) (a |essa )?janela",
        "janela flutuante",
        "(tiling|tile|flutuante|float)"
      ]
    },
    {
      "name": "window-minimize",
      "kind": "exec",
      "run": [
        "qs",
        "ipc",
        "call",
        "minimize",
        "window"
      ],
      "sound": null,
      "patterns": [
        "(minimiza|minimizar|minimize|esconde|esconder|guarda|guardar) (a |essa |esta )?janela"
      ]
    },
    {
      "name": "window-restore",
      "kind": "exec",
      "run": [
        "qs",
        "ipc",
        "call",
        "minimize",
        "restoreLast"
      ],
      "sound": null,
      "patterns": [
        "(restaura|restaurar|traz de volta|volta|devolve|mostra) (a )?(ultima )?janela( minimizada)?"
      ]
    },
    {
      "name": "window-pin",
      "kind": "exec",
      "run": [
        "qs",
        "ipc",
        "call",
        "pin",
        "toggle"
      ],
      "sound": null,
      "patterns": [
        "(fixa|fixar|desfixa|prende|pina|pinar) (a |essa )?janela( (em cima|no topo|por cima|sempre visivel))?",
        "(sempre (no topo|visivel|por cima)|always on top)"
      ]
    },
    {
      "name": "window-swap",
      "kind": "hypr",
      "dispatch": "hl.dsp.window.swap({ direction = \"{dir}\" })",
      "sound": null,
      "patterns": [
        "(troca|move|mover|empurra|joga) (a |essa )?janela (para |pra )?(a )?(?P<dir>esquerda|direita|cima|baixo)"
      ],
      "map": {
        "dir": {
          "esquerda": "left",
          "direita": "right",
          "cima": "up",
          "baixo": "down"
        }
      }
    },
    {
      "name": "focus-dir",
      "kind": "hypr",
      "dispatch": "hl.dsp.focus({ direction = \"{dir}\" })",
      "sound": null,
      "patterns": [
        "(foca|focar|foco|vai|va|ir) (na |para a |pra |para |a )?(janela (da |de |a )?)?(?P<dir>esquerda|direita|cima|baixo)"
      ],
      "map": {
        "dir": {
          "esquerda": "left",
          "direita": "right",
          "cima": "up",
          "baixo": "down"
        }
      }
    },
    {
      "name": "workspace-go",
      "kind": "hypr",
      "dispatch": "hl.dsp.focus({ workspace = {n_ws} })",
      "sound": null,
      "patterns": [
        "(vai|va|ir|muda|mudar|troca|trocar|pula|pular|foca|focar) (para|pra|no|na|ao|a|o)( o| a)? ?(workspace|area de trabalho|area|espaco|tela|desktop|ws) ?(numero )?(?P<n_ws>[a-z0-9]+)",
        "(workspace|area de trabalho|area|espaco) (numero )?(?P<n_ws>[a-z0-9]+)"
      ]
    },
    {
      "name": "workspace-move",
      "kind": "hypr",
      "dispatch": "hl.dsp.window.move({ workspace = {n_ws} })",
      "sound": null,
      "patterns": [
        "(move|mover|manda|mandar|leva|levar|joga|jogar|envia|enviar|coloca|colocar|poe|bota) (a |essa |esta |isso )?(janela )?(para|pra|pro|ao|no|na)( o| a)? ?(workspace|area de trabalho|area|espaco|tela|desktop|ws) ?(numero )?(?P<n_ws>[a-z0-9]+)"
      ]
    },
    {
      "name": "workspace-next",
      "kind": "hypr",
      "dispatch": "hl.dsp.focus({ workspace = \"e+1\" })",
      "sound": null,
      "patterns": [
        "(proximo|proxima|avanca|avancar) (workspace|area de trabalho|area|espaco|tela)",
        "(workspace|area de trabalho) seguinte"
      ],
      "inverse": "workspace-prev",
      "direction": "more"
    },
    {
      "name": "workspace-prev",
      "kind": "hypr",
      "dispatch": "hl.dsp.focus({ workspace = \"e-1\" })",
      "sound": null,
      "patterns": [
        "(anterior|volta|voltar|retorna) (o |a |para o |para a |pro |pra )?(workspace|area de trabalho|area|espaco|tela)( anterior)?",
        "(workspace|area de trabalho) anterior"
      ],
      "inverse": "workspace-next",
      "direction": "less"
    },
    {
      "name": "scratchpad",
      "kind": "hypr",
      "dispatch": "hl.dsp.workspace.toggle_special(\"magic\")",
      "sound": null,
      "patterns": [
        "(abre|abra|mostra|esconde|fecha|alterna) (o )?(scratchpad|rascunho|workspace especial|gaveta)",
        "scratchpad"
      ]
    },
    {
      "name": "scratchpad-move",
      "kind": "hypr",
      "dispatch": "hl.dsp.window.move({ workspace = \"special:magic\" })",
      "sound": null,
      "patterns": [
        "(move|mover|manda|mandar|leva|levar|joga|jogar|guarda|guardar) (a |essa |esta )?(janela )?(para o|pro|no|para a|pra) (scratchpad|rascunho|gaveta)"
      ]
    },
    {
      "name": "close-named",
      "kind": "winref",
      "action": "close",
      "patterns": [
        "(fecha|feche|fechar|mata|encerra|encerre) (o |a |as |os )?(janela d[oa] |aba d[oa] )?(?P<win>.+)"
      ]
    },
    {
      "name": "focus-named",
      "kind": "winref",
      "action": "focus",
      "patterns": [
        "(foca|focar|foco|vai|va|ir|volta|voltar|mostra|mostrar|traz|trazer|pula|pular) (no|na|para o|para a|pro|pra|ao|de volta para o|de volta pro|de volta para a|de volta pra) (janela d[oa] )?(?P<win>.+)",
        "(cade|onde (esta|ta)) (o |a )?(?P<win>.+)"
      ]
    },
    {
      "name": "volume-up",
      "kind": "exec",
      "run": [
        "wpctl",
        "set-volume",
        "-l",
        "1.0",
        "@DEFAULT_AUDIO_SINK@",
        "{n_pct}%+"
      ],
      "sound": null,
      "patterns": [
        "(aumenta|aumentar|sobe|subir|levanta|levantar|mais) (o |um pouco o |um pouco de |um pouco )?(volume|som|audio)( (em |mais |uns )?(?P<n_pct>[a-z0-9 ]+?) ?(por cento|%|porcento))?",
        "(volume|som) mais alto",
        "(mais alto|alto)"
      ],
      "defaults": {
        "n_pct": "5"
      },
      "inverse": "volume-down",
      "direction": "more"
    },
    {
      "name": "volume-down",
      "kind": "exec",
      "run": [
        "wpctl",
        "set-volume",
        "@DEFAULT_AUDIO_SINK@",
        "{n_pct}%-"
      ],
      "sound": null,
      "patterns": [
        "(abaixa|abaixar|baixa|baixar|diminui|diminuir|reduz|reduzir|desce|descer|menos) (o |um pouco o |um pouco de |um pouco )?(volume|som|audio)( (em |menos |uns )?(?P<n_pct>[a-z0-9 ]+?) ?(por cento|%|porcento))?",
        "(volume|som) mais baixo",
        "(mais baixo|baixo)"
      ],
      "defaults": {
        "n_pct": "5"
      },
      "inverse": "volume-up",
      "direction": "less"
    },
    {
      "name": "volume-set",
      "kind": "exec",
      "run": [
        "wpctl",
        "set-volume",
        "-l",
        "1.0",
        "@DEFAULT_AUDIO_SINK@",
        "{n_pct}%"
      ],
      "sound": null,
      "patterns": [
        "(coloca|colocar|poe|por|bota|botar|ajusta|ajustar|deixa|deixar|muda|mudar) (o )?(volume|som) (em |para |pra |no |a )?(?P<n_pct>[a-z0-9 ]+?) ?(por cento|%|porcento)?",
        "(volume|som) (em |para |pra |no |a )?(?P<n_pct>[a-z0-9 ]+?) ?(por cento|%|porcento)"
      ],
      "adjust": {
        "group": "n_pct",
        "by": 5
      }
    },
    {
      "name": "mute",
      "kind": "exec",
      "run": [
        "wpctl",
        "set-mute",
        "@DEFAULT_AUDIO_SINK@",
        "1"
      ],
      "sound": null,
      "patterns": [
        "(muta|mutar|mute|silencia|silenciar|desliga|desligar|tira|corta|cortar) (o )?(som|audio|volume|alto falante|caixa|caixas)( de som)?",
        "(sem som|mudo|silencio total)"
      ]
    },
    {
      "name": "unmute",
      "kind": "exec",
      "run": [
        "wpctl",
        "set-mute",
        "@DEFAULT_AUDIO_SINK@",
        "0"
      ],
      "sound": null,
      "patterns": [
        "(desmuta|desmutar|unmute|volta|voltar|liga|ligar|devolve|ativa|ativar) (o |com )?(som|audio|volume)",
        "(tira|tirar) (do )?mudo"
      ]
    },
    {
      "name": "mic-mute",
      "kind": "exec",
      "run": [
        "wpctl",
        "set-mute",
        "@DEFAULT_AUDIO_SOURCE@",
        "toggle"
      ],
      "sound": null,
      "patterns": [
        "(muta|mutar|desmuta|desmutar|silencia|liga|desliga|alterna) (o )?(microfone|mic|mike)"
      ]
    },
    {
      "name": "media-play",
      "kind": "exec",
      "run": [
        "playerctl",
        "play-pause"
      ],
      "sound": null,
      "patterns": [
        "(pausa|pausar|pause|para|parar|toca|tocar|play|continua|continuar|retoma|retomar|despausa)( (a |o )?(musica|som|video|midia|player|reproducao|spotify))?",
        "(musica|play|pause|pausa)",
        "(coloca|colocar|bota|botar|poe|por|toca|tocar) (uma |a |um )?(musica|som|musiquinha)( ai| para mim| pra mim)?"
      ]
    },
    {
      "name": "media-next",
      "kind": "exec",
      "run": [
        "playerctl",
        "next"
      ],
      "sound": null,
      "patterns": [
        "(proxima|proximo|pula|pular|avanca|avancar|passa|passar|troca) (a |o |de |essa |esta )?(musica|faixa|som|track)?",
        "(proxima|next|skip)"
      ],
      "inverse": "media-prev",
      "direction": "more"
    },
    {
      "name": "media-prev",
      "kind": "exec",
      "run": [
        "playerctl",
        "previous"
      ],
      "sound": null,
      "patterns": [
        "(volta|voltar|anterior|retorna) (a |uma |para a |pra |o )?(musica|faixa|som|track)( anterior)?",
        "(musica|faixa) anterior"
      ],
      "inverse": "media-next",
      "direction": "less"
    },
    {
      "name": "media-what",
      "kind": "exec",
      "run": [
        "sh",
        "-c",
        "t=$(playerctl metadata --format '{{title}}, de {{artist}}' 2>/dev/null); [ -n \"$t\" ] && echo \"Está tocando $t.\" || echo 'Nada tocando agora.'"
      ],
      "say_output": true,
      "patterns": [
        "(que|qual) (musica|som|faixa) (e essa|esta tocando|ta tocando|e esta)",
        "o que (esta|ta) tocando",
        "(quem|que artista) (esta|ta) (cantando|tocando)",
        "(qual|que) (e )?(a )?(musica|som|faixa)( (e essa|esta tocando|ta tocando|que (esta|ta) tocando))?"
      ]
    },
    {
      "name": "screenshot",
      "kind": "exec",
      "run": [
        "sh",
        "-c",
        "mkdir -p ~/Pictures/Screenshots && f=~/Pictures/Screenshots/$(date +%Y-%m-%d_%H-%M-%S).png && sleep 0.4 && grim \"$f\" && wl-copy < \"$f\" && barch notify Screenshot 'Saved and copied to the clipboard'"
      ],
      "sound": null,
      "patterns": [
        "(tira|tirar|faz|fazer|captura|capturar|bate|bater|salva|salvar) (um |uma |a )?(print|screenshot|captura|captura de tela|foto da tela|print da tela|printscreen)"
      ]
    },
    {
      "name": "record",
      "kind": "exec",
      "run": [
        "qs",
        "ipc",
        "call",
        "replay",
        "save"
      ],
      "sound": null,
      "patterns": [
        "(salva|salvar|guarda|guardar) (o |a |esse |essa )?(replay|clipe|clip|jogada|ultimos minutos|gravacao)"
      ]
    },
    {
      "name": "replay-toggle",
      "kind": "exec",
      "run": [
        "qs",
        "ipc",
        "call",
        "replay",
        "toggle"
      ],
      "sound": null,
      "patterns": [
        "(liga|ligar|ativa|ativar|desliga|desligar|desativa|desativar|comeca|comecar|para|parar) (o |a )?(replay|gravacao continua|shadowplay|buffer de gravacao)"
      ]
    },
    {
      "name": "updates",
      "kind": "exec",
      "run": [
        "sh",
        "-c",
        "n=$( (checkupdates 2>/dev/null; paru -Qua 2>/dev/null) | wc -l); if [ \"$n\" = 0 ]; then echo 'Tudo atualizado.'; else echo \"Tem $n pacotes para atualizar.\"; fi"
      ],
      "say_output": true,
      "timeout": 60,
      "patterns": [
        "(tem|ha|existe|existem) (alguma |algumas )?(atualizacao|atualizacoes|update|updates)( pendentes?| disponiveis?)?",
        "(quantas|quantos) (atualizacoes|pacotes|updates)( tem| pendentes| para atualizar)?",
        "(o )?(sistema|pc) (esta|ta) atualizado"
      ]
    },
    {
      "name": "disk",
      "kind": "exec",
      "run": [
        "sh",
        "-c",
        "df -h --output=pcent,avail / | tail -1 | awk '{gsub(\"%\",\"\",$1); print \"O disco está com \" $1 \" por cento usado, \" $2 \" livres.\"}'"
      ],
      "say_output": true,
      "patterns": [
        "(como (esta|ta) o disco|quanto (espaco|disco) (tem|sobra|resta|falta|livre)|espaco (em disco|livre|no disco)|disco (cheio|livre))"
      ]
    },
    {
      "name": "agenda",
      "kind": "exec",
      "run": [
        "sh",
        "-c",
        "a=$(khal list today today --format '{start-time} {title}' --day-format '' 2>/dev/null | grep -v '^$' | head -5); [ -n \"$a\" ] && printf 'Hoje: %s' \"$(echo \"$a\" | paste -sd ';' | sed 's/;/; /g')\" || echo 'Nada na agenda de hoje.'"
      ],
      "say_output": true,
      "timeout": 20,
      "patterns": [
        "(o que|que) (tem|eu tenho|temos) (hoje|na agenda|para hoje|pra hoje|marcado)",
        "(minha |a )?agenda( de hoje| do dia)?",
        "(quais|que) (compromissos|reunioes|eventos) (tem|tenho|temos)( hoje)?"
      ]
    },
    {
      "name": "weather",
      "kind": "claude",
      "patterns": [
        "(como (esta|ta) o (tempo|clima)|vai chover|previsao do tempo|que tempo faz|temperatura (la fora|agora|de hoje))(?P<q>)"
      ]
    },
    {
      "name": "app",
      "kind": "app",
      "patterns": [
        "(abre|abra|abrir|lanca|lance|lancar|inicia|inicie|iniciar|executa|execute|executar|roda|rode|rodar|starta|startar|chama|chamar|mostra|mostrar) (o |a |um |uma |os |as )?(aplicativo |app |programa )?(?P<app>.+?)( para mim| pra mim)?",
        "(aplicativo|app|programa) (?P<app>.+)"
      ]
    },
    {
      "name": "ask",
      "kind": "claude",
      "patterns": [
        "(pergunta|pergunte|perguntar|pesquisa|pesquise|pesquisar|busca|busque|procura|procure) (ao claude |para o claude |pro claude )?(?P<q>.+)",
        "(claude|cloud|claud|clode)[ ,]+(?P<q>.+)"
      ]
    }
  ]
}
