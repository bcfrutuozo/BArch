  "intents": [
    {
      "name": "again",
      "kind": "again",
      "how": "again",
      "patterns": [
        "(de novo|outra vez|mais uma vez|repete|repetir|repete isso|faz de novo|faz isso de novo|novamente)"
      ]
    },
    {
      "name": "more",
      "kind": "again",
      "how": "more",
      "patterns": [
        "(mais|mais um pouco|um pouco mais|mais ainda|mais um pouquinho|um pouquinho mais|aumenta mais|sobe mais)"
      ]
    },
    {
      "name": "less",
      "kind": "again",
      "how": "less",
      "patterns": [
        "(menos|um pouco menos|menos um pouco|um pouquinho menos|volta um pouco|diminui um pouco|abaixa um pouco|exagerou|demais)"
      ]
    },
    {
      "name": "hush",
      "kind": "hush",
      "patterns": [
        "(cala a boca|quieto|silencio|chega|para de falar|shh+)"
      ]
    },
    {
      "name": "pause",
      "kind": "pause",
      "say": "Pausado. Me chame pela barra para voltar.",
      "patterns": [
        "(para|pare|parar) de (escutar|ouvir)",
        "(pausa|pausar|desliga|desligar) (a )?(escuta|voz|audicao)",
        "nao (me )?escuta mais",
        "dorme|durma|boa noite"
      ]
    },
    {
      "name": "thanks",
      "kind": "say",
      "say": "De nada.",
      "sound": null,
      "patterns": [
        "(muito )?obrigad[oa]( barch)?",
        "valeu( barch)?",
        "(bom|boa|otimo|perfeito|show|legal|isso|beleza)( barch)?"
      ]
    },
    {
      "name": "hello",
      "kind": "say",
      "say": "Oi, Bruno. Pode falar.",
      "patterns": [
        "(oi|ola|ola|bom dia|boa tarde|e ai|tudo bem|voce (ta|esta) (ai|me ouvindo)|ta (ai|me ouvindo|escutando))( barch)?( \\?)?"
      ]
    },
    {
      "name": "help",
      "kind": "say",
      "say": "Eu troco o tema, abro aplicativos e projetos, controlo janelas, volume e música, ligo o HDR, o modo anônimo e a VPN, aviso a hora e lembretes. O que eu não souber, pergunto ao Claude.",
      "patterns": [
        "(o que voce (faz|sabe fazer)|ajuda|me ajuda|quais (sao )?(os )?comandos|que comandos (tem|existem))"
      ]
    },
    {
      "name": "time",
      "kind": "time",
      "patterns": [
        "(que|qual) (horas? (sao|e)|hora e|e a hora)( agora)?",
        "me (diz|diga|fala|fale) a hora",
        "hora"
      ]
    },
    {
      "name": "date",
      "kind": "date",
      "patterns": [
        "(que|qual) (dia|data) e hoje",
