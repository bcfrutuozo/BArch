#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# qBittorrent statistics (server/torrents in the BArch repo), supervised by s6: restarts if it dies.
# Code in /config/app, settings in /config/config.json + secrets*.json, the database in /config/data.
export PYTHONPATH=/config/app PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
exec s6-setuidgid abc python3 -m barch_torrents serve --config /config/config.json
