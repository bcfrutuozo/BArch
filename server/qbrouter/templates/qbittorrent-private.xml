<?xml version="1.0"?>
<!-- BArch qbrouter (server/qbrouter): the qBittorrent without VPN, for private trackers that ban VPNs (SAPIbr).
     Copied to /boot/config/plugins/dockerMan/templates-user/my-qbittorrent-private.xml. Its qBittorrent.conf is
     seeded by install.sh before the first start (paths, port, no DHT/PeX/LSD, whitelist, password). -->
<Container version="2">
  <Name>qbittorrent-private</Name>
  <Repository>lscr.io/linuxserver/qbittorrent:5.3.0_v2.1.2-ls485</Repository>
  <Registry>https://github.com/linuxserver/docker-qbittorrent/pkgs/container/qbittorrent</Registry>
  <Network>frutuozoproxy</Network>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Project>https://www.qbittorrent.org</Project>
  <Overview>qBittorrent leaving from the home address (no VPN): only torrents of private trackers that forbid VPNs, sent here by barch-qbrouter. Never point Radarr, Sonarr, Lidarr or the pipelines at it.</Overview>
  <Category>Downloaders:</Category>
  <WebUI>http://[IP]:[PORT:8095]/</WebUI>
  <Icon>https://cdn.jsdelivr.net/gh/selfhst/icons/png/qbittorrent.png</Icon>
  <ExtraParams/>
  <PostArgs/>
  <Config Name="WebUI" Target="8080" Default="8095" Mode="tcp" Description="Web UI from the LAN (8080 on the host is the VPN qbittorrent)" Type="Port" Display="always" Required="true" Mask="false">8095</Config>
  <Config Name="Torrent TCP" Target="6882" Default="6882" Mode="tcp" Description="Incoming peers; forward WAN 6882 to the NAS in pfSense" Type="Port" Display="always" Required="true" Mask="false">6882</Config>
  <Config Name="Torrent UDP" Target="6882" Default="6882" Mode="udp" Description="Incoming peers (uTP)" Type="Port" Display="always" Required="true" Mask="false">6882</Config>
  <Config Name="Config" Target="/config" Default="/mnt/user/appdata/qbittorrent-private" Mode="rw" Description="qBittorrent/qBittorrent.conf seeded by install.sh" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/qbittorrent-private</Config>
  <Config Name="Downloads" Target="/data" Default="/mnt/user/downloads/torrents" Mode="rw" Description="The same /data as qbittorrent and shelfmark, so the paths it reports are Shelfmark's" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/downloads/torrents</Config>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="" Type="Variable" Display="advanced" Required="true" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="" Type="Variable" Display="advanced" Required="true" Mask="false">100</Config>
  <Config Name="UMASK" Target="UMASK" Default="002" Mode="" Description="" Type="Variable" Display="advanced" Required="false" Mask="false">002</Config>
  <Config Name="TZ" Target="TZ" Default="America/Sao_Paulo" Mode="" Description="" Type="Variable" Display="advanced" Required="false" Mask="false">America/Sao_Paulo</Config>
  <Config Name="WEBUI_PORT" Target="WEBUI_PORT" Default="8080" Mode="" Description="Inside the container; barch-qbrouter and SWAG use qbittorrent-private:8080" Type="Variable" Display="advanced" Required="true" Mask="false">8080</Config>
  <Config Name="TORRENTING_PORT" Target="TORRENTING_PORT" Default="6882" Mode="" Description="Must match the two torrent ports above" Type="Variable" Display="advanced" Required="true" Mask="false">6882</Config>
</Container>
