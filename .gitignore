# Generated by the Quickshell theme (recreated automatically on every theme change)
foot/.config/foot/theme.ini
nvim/.config/nvim/lua/system_palette.lua
hypr/.config/hypr/hyprlock-colors.conf
# Link to the current light/dark Hyprland theme (theme-auto recreates it)
hypr/.config/hypr/themes/current.lua

# systemd "enable" links: machine-specific, install.sh enables the services again
systemd/.config/systemd/user/*.wants/

# Editor and backup leftovers
*.bak
*.bak-*
*.pre-barch
*.swp
*~
__pycache__/

# Never commit secrets
*.key
*.pem
**/credentials*
.smbcredentials
.env
